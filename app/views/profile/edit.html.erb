<%= vite_stylesheet_tag "styles/profile.scss" %>
<% profile_form_actions = [
  "input->profile#showChangeBanner",
  "change->profile#showChangeBanner"
].join(" ") %>

<div class="container-md profile-page">

  <%= bootstrap_form_with url: profile_update_path, scope: 'user',
                          html: { id: 'profileForm',
                                  data: { controller: 'profile',
                                          action: profile_form_actions } } do |f| %>

  <div class="row md-3">

    <!-- Unsaved changes warning/button -->
    <div class="w-100 mb-3">
      <%= f.submit t('profile.changes_made_btn'),
            class: 'btn btn-warning mt-3 w-100 d-none text-wrap',
            id: "profileChange",
            data: { profile_target: 'changeButton' } %>
    </div>

    <% if @user.teacher? %>
      <div class="col-12 mb-3 md-0">
      <!-- Image card: teachers only -->
        <%= render "profile/teacher_profile", f: f, user: @user %>
      </div>
    <% end %>

    <div class="col-12 col-md-6 mb-3 md-0">
      <div class="profile-stack">
        <!-- Account info card -->
        <section class="card profile-card">
          <div class="card-header">
            <h5><%= t('profile.account') %></h5>
            <%= link_to edit_personal_data_path, class: "profile-btn" do %>
              <%= t("personal_data.edit_link") %>
              <span class="material-icons profile-icon" aria-hidden="true">edit</span>
            <% end %>
          </div>

          <div class="card-body">
            <div class="profile-field">
              <%= f.label :name, t('profile.name'), class: "profile-label" %>
              <%= helpdesk(t('profile.name_information'), true) %>
              <%= f.text_field_without_bootstrap :name, class: 'form-control' %>
              <div class="invalid-feedback" id="username-error"></div>
            </div>

            <% unless @user.full_name %>
              <div class="profile-field">
                <%= f.label :name_in_tutorials, t('profile.name_in_tutorials'),
                            class: "profile-label" %>
                <%= helpdesk(t('profile.name_in_tutorials_information'), true) %>
                <%= f.text_field_without_bootstrap :name_in_tutorials,
                                                   class: 'form-control' %>
              </div>
            <% end %>

            <% if @user.personal_data_confirmed_at %>
              <% details = { t("personal_data.steps.name") => @user.full_name,
                             User.human_attribute_name(:matriculation_number) =>
                               @user.matriculation_number,
                             User.human_attribute_name(:program_id) =>
                               @user.program&.name_with_subject,
                             User.human_attribute_name(:uni_id) => @user.uni_id } %>
              <div class="profile-grid">
                <% details.each do |label, value| %>
                  <div>
                    <div class="profile-label"><%= label %></div>
                    <div class="profile-value"><%= value.presence || "–" %></div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </section>

        <!-- Account preferences card -->
        <section class="card profile-card">
          <div class="card-header">
            <h5><%= t('profile.preferences') %></h5>
          </div>
          <div class="card-body">
            <%= render partial: 'profile/subscription_type', locals: { f: f } %>
          </div>
        </section>

        

      </div>
    </div>

    <div class="col-12 col-md-6 mb-3 md-0">
      <div class="profile-stack">

        <section class="card profile-card">
          <div class="card-header">
            <h5><%= t('profile.email_notifications_header') %></h5>
          </div>
          <div class="card-body">
            <%= render partial: 'profile/email_notifications', locals: { f: f } %>
          </div>
        </section>

        <!-- Action card -->
        <section class="card profile-card">
          <div class="card-header">
            <h5><%= t('profile.security_and_data') %></h5>
          </div>
          <div class="card-body">
            <%= render partial: 'profile/account' %>
          </div>
        </section>

      </div>
    </div>

  </div>

  <div class="row">
    <!-- Unsaved changes warning/button (small screens only) -->
    <div class="w-100 mt-3 mb-3 d-md-none">
      <%= f.submit t('profile.changes_made_btn'),
            class: 'btn btn-warning w-100 d-none text-wrap',
            data: { profile_target: 'changeButton' },
            id: "profileChangeBottom" %>
    </div>
  </div>

  <% end %>

  <div class="row mb-3">
    <div class="col-12 col-md-6">
      <section class="card profile-card voucher-card">
        <div class="voucher-redemption-pattern"></div>
        <div class="card-header">
          <h5>
            <%= t('profile.redeem_voucher') %>
            <%= helpdesk(t('profile.redeem_voucher_explainer'), true) %>
          </h5>
        </div>
        <div class="card-body">
          <div id="redeem-voucher">
            <%= render partial: 'profile/verify_voucher' %>
          </div>
        </div>
      </section>
    </div>
  </div>

</div>

<!-- Delete Account Modal -->
<%= render partial: 'shared/generic_modal',
           locals: { sort: 'deleteAccount',
                     title: t('profile.delete_account') } %>

<!-- User Request Data Modal -->
<%= render partial: 'profile/request_data_modal' %>
