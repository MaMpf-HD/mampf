<%# locals: (f:, user:) %>
<% initials = (user.full_name.presence || user.name).to_s
                .split.first(2).map { |w| w[0] }.join.upcase %>

<!-- 🖼 Image card (teachers only) -->
<section class="card profile-card">
  <div class="card-header">
    <h5><%= t("profile.teacher_profile.title") %></h5>

    <%# Button toggles the image edit zone %>
    <button type="button"
            class="profile-btn"
            data-bs-toggle="collapse"
            data-bs-target="#profile-image-uploader"
            aria-expanded="false"
            aria-controls="profile-image-uploader">
      <%= t("admin.user.profile_image") %>
      <span class="material-icons profile-icon" aria-hidden="true">edit</span>
    </button>
  </div>

  <div class="card-body">
    <p class="profile-explainer"><%= t("profile.teacher_profile.explainer") %></p>

    <div class="profile-identity">
      <div class="profile-avatar">
        <span class="profile-avatar__initials" aria-hidden="true"><%= initials %></span>
        <%# src is only set when an image exists; uppy fills it in after upload %>
        <%= tag.img id: "image-preview",
                    class: "profile-avatar__img",
                    alt: "",
                    src: (image_user_path(user, variant: "original") if user.original_image_file) %>
      </div>

      <div class="profile-identity__text">
        <div class="profile-identity__name"><%= user.name %></div>
        <div class="profile-identity__meta"><%= user.email %></div>
      </div>
    </div>

    <%= f.hidden_field :image, value: user.cached_image_data, id: "upload-image-hidden" %>

    <!-- Image edit zone: shown via the button above -->
    <div class="collapse mt-3" id="profile-image-uploader">
      <div
        data-controller="uppy-upload"
        data-uppy-upload-kind-value="image"
        data-uppy-upload-max-file-size-value="<%= ProfileimageUploader::MAX_SIZE %>"
        data-uppy-upload-intent-value="<%= upload_intent_token(ProfileimageUploader, target: user) %>"
        data-uppy-upload-endpoint-value="/profile_image/upload"
        data-uppy-upload-failure-message-value="<%= t("submission.upload_failure") %>"
        data-uppy-upload-hidden-input-selector-value="#upload-image-hidden"
        data-uppy-upload-preview-selector-value="#image-preview"
      >
        <div data-uppy-upload-target="dashboard"></div>
      </div>
      <div class="invalid-feedback" id="image-error"></div>

      <% if user.image.present? %>
        <div class="mt-2">
          <%= f.check_box :remove_image, label: t("profile.teacher_profile.remove_image") %>
        </div>
      <% end %>
    </div>

    <div class="profile-field mt-3 mb-0">
      <%= f.label :homepage, t("admin.user.homepage"), class: "profile-label" %>
      <%= f.text_field_without_bootstrap :homepage, value: user.homepage, class: "form-control" %>
      <div class="invalid-feedback" id="homepage-error"></div>
    </div>
  </div>
</section>
