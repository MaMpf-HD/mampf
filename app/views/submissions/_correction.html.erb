<span class="correction-action-area d-inline-flex align-items-center gap-1" data-id="<%= submission.id %>">
  <% if !@assignment&.active? %>
    <%= link_to edit_correction_path(submission),
                class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2 py-1 lh-1",
                data: { turbo_stream: true, bs_toggle: "tooltip" },
                title: t('buttons.upload') do %>
      <i class="bi bi-upload"></i>
    <% end %>
  <% else %>
    <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2 py-1 lh-1"
            disabled
            title="<%= t('buttons.upload') %>">
      <i class="bi bi-upload"></i>
    </button>
  <% end %>

  <% if submission.correction %>
    <%= link_to show_correction_path(submission, params: { download: 'true' }),
                class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2 py-1 lh-1",
                data: { bs_toggle: "tooltip", turbo: false },
                title: t('buttons.download') do %>
      <i class="bi bi-download"></i>
    <% end %>

    <% unless submission.assignment.accepted_file_type.in?(Assignment.non_inline_file_types) %>
      <%= link_to show_correction_path(submission),
                  class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2 py-1 lh-1",
                  data: { bs_toggle: "tooltip", turbo: false },
                  title: t('buttons.show') do %>
        <i class="bi bi-eye"></i>
      <% end %>
    <% end %>

    <%= link_to delete_correction_path(submission),
                class: "btn btn-sm btn-outline-danger d-inline-flex align-items-center justify-content-center px-2 py-1 lh-1",
                data: { turbo_method: :delete,
                        turbo_confirm: t('confirmation.generic'),
                        turbo_stream: true,
                        bs_toggle: "tooltip" },
                title: t('buttons.delete') do %>
      <i class="bi bi-trash"></i>
    <% end %>
  <% end %>
</span>
