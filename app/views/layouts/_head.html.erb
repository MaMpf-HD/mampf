<title>
  <%= full_title(yield(:title)) %>
</title>

<meta name="turbo-modal-error-message" content="<%= t('modals.load_error') %>">

<link rel="manifest" href="/manifest.json">

<%= csrf_meta_tags %>
<%= vite_stylesheet_tag "application.scss",
                        media: "all",
                        "data-turbo-track": "reload" %>
<%# In the head, which a Turbo visit keeps: loaded with the navbar in the body,
    it went and came back on every visit, and the icons flashed dark. %>
<%= vite_stylesheet_tag "styles/navbar.scss", "data-turbo-track": "reload" %>

<!-- For old sprockets assets (commontator, thredded, exception_handler) -->
<%= stylesheet_link_tag "sprockets" , media: "all" %>

<%= vite_stylesheet_tag "vendor.css", media: "all", "data-turbo-track": "reload" %>

<meta name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no">

<%= vite_client_tag %>
<%= vite_javascript_tag "application" %>
