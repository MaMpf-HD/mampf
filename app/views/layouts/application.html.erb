<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render partial: 'layouts/head' %>
    <%= vite_stylesheet_tag "styles/sidebar.scss" %>
    <% staff_edit_mode = content_for?(:staff_edit_mode) %>
    <% if staff_edit_mode %>
      <%= render partial: 'layouts/head_additional_js' %>
    <% end %>

  </head>

  <body data-locale="<%= I18n.locale %>" class="d-flex flex-column min-vh-100">

    <%= render partial: "flash/messages" %>
    <%= render partial: "shared/navbar" %>

    <% page = yield %>

    <% if @lecture %>
      <%= render layout: "layouts/lecture_mode",
                 locals: { lecture: @lecture, edit_mode: staff_edit_mode } do %>
        <%= page %>
      <% end %>
    <% else %>
      <div class="<%= class_names("d-flex container-fluid flex-grow-1",
                                  "admin-background": staff_edit_mode) %>">
        <div class="row" id="main-content-row">
          <main class="col-12 pt-3" role="main">
            <% if staff_edit_mode %>
              <%= page %>
            <% else %>
              <%= turbo_frame_tag "main", target: "_top", data: { turbo_action: "advance" } do %>
                <%= page %>
              <% end %>
            <% end %>
          </main>
        </div>
      </div>
    <% end %>

    <div id="modal-container"></div>

    <footer class="container-fluid mt-4 p-0">
      <%= render partial: 'shared/footer' %>
    </footer>

  </body>
</html>
