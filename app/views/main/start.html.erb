<%= vite_stylesheet_tag "dashboard/dashboard.scss" %>

<div class="dashboard-hero">
  <%= render "feedbacks/mama_muffin" if show_mama_muffin? %>

  <div class="container-md small-width mt-4">
    <%= render(DashboardTermSelectComponent.new(
      terms: @available_terms,
      selected: @selected_term,
      next_term_lecture_count: @next_term_lecture_count,
      id: "dashboard-term-select"
    )) %>
  </div>

  <%= render "main/start/lecture_cards" %>

  <%# Jumps without Turbo: a Turbo visit renders the page anew and scrolls
      before the stylesheets in the body have loaded, so the page stays at
      the top. %>
  <a href="#lecture-search" id="go-to-lecture-search" data-turbo="false">
    <span class="go-to-lecture-search-label">
      <%= t("lecture.search.go_to_search") %>
    </span>
    <div id="arrow-go-to-lecture-wrapper">
      <i class="fas fa-chevron-down" id="arrow-go-to-lecture"></i>
    </div>
  </a>
</div>

<%= render partial: 'profile/subscription_modal' %>
<%# The picker above names the semester, so the term on each result is dropped. %>
<%= render partial: "lectures/search/search", locals: { show_term: false } %>
