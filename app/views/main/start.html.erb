<%= vite_stylesheet_tag "dashboard/dashboard.scss" %>

<div style="min-height: 100vh; display: flex; flex-direction: column; padding-left: 1em; padding-right: 1em;">
  <% if @next_term_lecture_count.to_i.positive? %>
    <%= render partial: "main/start/next_term_banner",
               locals: { next_term: @next_term,
                         lecture_count: @next_term_lecture_count } %>
  <% end %>
  <div class="container-md small-width mt-4">
    <%= render(DashboardTermSelectComponent.new(terms: @available_terms,
                                                selected: @selected_term,
                                                id: "dashboard-term-select")) %>
  </div>

  <div id="dashboardLectureCards" class="container-md small-width mb-3">
    <%= render(DashboardSectionComponent.new(
                 title: t("main.start.sections.enrolled"),
                 testid: "dashboard-enrolled-lectures")) do %>
      <% @enrolled_lectures.each do |lecture| %>
        <%= render(LectureDashboardCardComponent.new(lecture: lecture, user: current_user)) %>
      <% end %>
      <% @talks.each do |talk| %>
        <%= render(TalkDashboardCardComponent.new(talk: talk, user: current_user)) %>
      <% end %>
    <% end %>

    <%= render(DashboardSectionComponent.new(
                 title: t("main.start.sections.bookmarked"),
                 testid: "dashboard-bookmarked-lectures")) do %>
      <% @bookmarked_lectures.each do |lecture| %>
        <%= render(LectureDashboardCardComponent.new(lecture: lecture, user: current_user)) %>
      <% end %>
    <% end %>

    <% if @enrolled_lectures.empty? && @bookmarked_lectures.empty? && @talks.empty? %>
      <%= tag.div id: "dashboardEmptyState",
                  class: "text-center text-muted my-5",
                  data: { testid: "dashboard-empty-state" } do %>
        <p class="mb-0"><%= t("main.start.no_lectures") %></p>
      <% end %>
    <% end %>
  </div>

  <a href="#lecture-search" id="go-to-lecture-search">
    <span style="font-size: 0.9em; font-weight: 500;">
      <%= t("lecture.search.go_to_search") %>
    </span>
    <div id="arrow-go-to-lecture-wrapper" style="transition: transform 0.3s ease;">
      <i class="fas fa-chevron-down" id="arrow-go-to-lecture"></i>
    </div>
  </a>
</div>

<%= render partial: 'profile/subscription_modal' %>
<%= render partial: "lectures/search/search" %>
