<div class="card bg-light">
  <div class="card-header bg-generic-card-header">
    <h5>
      <%= t('basics.related_questions') %>
      <span class="badge bg-secondary">
        <%= questions.count %>
      </span>
    </h5>
  </div>
  <div class="card-body">
    <% if questions %>
      <div class="row">
        <div class="col-12 text-center">
          <%= button_to t('test.start'),
                        tag_random_quiz_path(tag),
                        class: 'btn btn-sm btn-primary',
                        form: { target: :_blank, data: { turbo: false } } %>
        </div>
      </div>
    <% end %>
  </div>
</div>