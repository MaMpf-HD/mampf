<div class="list-group">
  <div class="list-group-item list-group-item-secondary">
    <div class="row">
      <div class="col-12">
        <%= t('admin.main.title') %>
      </div>
    </div>
  </div>
  <% courses.each do |c| %>
    <%= link_to edit_course_path(c),
                class: "list-group-item list-group-item-action",
                data: { turbo_frame: "_top" } do %>
      <div class="row">
        <div class="col-12">
          <%= c.title %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
