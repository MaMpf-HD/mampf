<div class="container-lg my-4">
  <div class="card shadow-sm">
    <div class="card-header bg-body pt-3 pb-4">
      <h4 class="mb-1">
        <%= t("admin.announcement.title") %>
      </h4>
      <p class="text-muted small mb-0">
        <%= t("admin.announcement.active_hint") %>
      </p>
    </div>
    <%# Zero-height anchor, so the button sits centered on the header's
        bottom border. %>
    <div class="position-relative">
      <%= link_to new_announcement_path,
                  class: "btn btn-light border shadow-sm rounded-circle p-0 " \
                         "d-inline-flex align-items-center justify-content-center " \
                         "position-absolute top-0 start-50 translate-middle z-1",
                  style: "width: 2.25rem; height: 2.25rem;",
                  id: "new-announcement-button",
                  title: t("buttons.create_announcement"),
                  aria: { label: t("buttons.create_announcement") },
                  data: { turbo_frame: "new_announcement" } do %>
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
      <% end %>
    </div>
    <%= turbo_frame_tag "new_announcement" %>
    <ul class="list-group list-group-flush" id="announcements">
      <% @announcements.each do |a| %>
        <%= render partial: "announcements/row",
                   locals: { announcement: a } %>
      <% end %>
    </ul>
    <% if @announcements.none? %>
      <p class="text-muted text-center mt-5 mb-4" id="no-announcements">
        <%= t("no_announcements") %>
      </p>
    <% end %>
    <% if @pagy.pages > 1 %>
      <div class="card-footer bg-body d-flex justify-content-center py-3">
        <%== pagy_series_nav(@pagy) %>
      </div>
    <% end %>
  </div>
</div>
