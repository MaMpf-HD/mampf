<div class="container">
  <%= simple_format(h(@message.body)) %>
  <hr>
  <p style="color: #6c757d; font-size: 0.9em;">
    <%= t("mailer.student_message_footer",
          sender: @message.sender.name,
          email: @message.sender.email,
          role: t("mailer.student_message_role.#{@message.sender_role}"),
          audiences: @message.audience_sentence,
          lecture: @lecture.title_for_viewers) %>
  </p>
</div>
