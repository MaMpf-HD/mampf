<% voucher = lecture.active_voucher_of_role(role) %>

<div class="card-body">

  <h4 class="card-title lecture-pane-subheader" id="<%= role %>-voucher-title">
    <%= t("basics.voucher_for", role: t("basics.#{role}s")) %>
    <%= helpdesk(t("admin.lecture.info.voucher_for_#{role}"), html=false) %>
  </h4>

  <% if voucher %>
    <!-- Secure hash with copy button -->
    <div class="input-group mb-3"
         data-controller="clipboard"
         data-clipboard-text-value="<%= voucher.secure_hash %>"
         data-clipboard-resting-icon-value="bi-clipboard"
         data-clipboard-confirmation-value="<%= t('basics.code_copied_to_clipboard') %>"
         data-clipboard-failure-value="<%= t('basics.code_copy_failed') %>">
      <button type="button"
              class="btn btn-outline-secondary"
              data-action="clipboard#copy"
              title="<%= t('buttons.copy_to_clipboard')%>"
              aria-label="<%= t('buttons.copy_to_clipboard')%>">
        <i class="bi bi-clipboard" aria-hidden="true" data-clipboard-target="icon"></i>
      </button>
      <span class="visually-hidden" role="status" data-clipboard-target="status"></span>
      <input type="text" class="form-control" disabled
            value="<%= voucher.secure_hash %>"
            aria-label="<%= t('basics.voucher_code') %>">
    </div>

  <% else %>
    <!-- No active voucher text -->
    <p>
      <%= t('admin.lecture.no_active_voucher',
        role: t("basics.voucher_for", role: t("basics.#{role}s"))) %>
    </p>
  <% end %>

  <!-- Buttons to generate/remove voucher -->
  <% if voucher %>
    <%= link_to invalidate_voucher_path(voucher),
        class: 'btn btn-outline-danger',
        data: { toggle: 'tooltip', placement: 'bottom',
                confirm: t('admin.voucher.sure_to_delete') },
        style: 'text-decoration: none;',
        method: :post, remote: true do %>
      <i class="bi bi-trash3"></i>
      <%= t('buttons.invalidate') %>
    <% end %>
  <% else %>
    <%= link_to vouchers_path(params: { lecture_id: lecture.id, role: role }),
        class: 'btn btn-outline-primary',
        data: {toggle: 'tooltip', placement: 'bottom'},
        method: :post, remote: true do %>
      <i class="bi bi-plus-lg"></i>
      <%= t('buttons.create_voucher') %>
    <% end %>
  <% end %>

</div>

<!-- Expires at text -->
<% if voucher %>
  <div class="card-footer p-3">
    <%= t('admin.voucher.expires_at') %>:
    <%= l(voucher.expires_at, format: :long) %>
  </div>
<% end %>
