<%= t('roster.mailer.roster_rejected_from_exam_email_body',
      name: @username,
      lecture_title: @lecture&.title || '',
      rosterable_title: @rosterable.title) %>
<% if @info[:reason].present? %>
<%= t('roster.mailer.rejected_reason_text', reason: @info[:reason]) %>
<% end %>
<% if @rosterable_link %>
<%= t('roster.mailer.link_text_exam', rosterable_link: @rosterable_link) %>
<% end %>
<%= t('roster.mailer.end_mail') %>
