<%= t('roster.mailer.roster_rejected_from_exam_email_body_html',
      name: @username,
      lecture_title: @lecture&.title || '',
      rosterable_title: @rosterable.title) %>
<% if @info[:reason].present? %>
  <%= t('roster.mailer.rejected_reason_text_html', reason: @info[:reason]) %>
<% end %>
<% if @rosterable_link %>
  <%= t('roster.mailer.link_text_exam_html',
        rosterable_link: link_to(t('basics.link'), @rosterable_link)) %>
<% end %>
<%= t('roster.mailer.end_mail_html') %>