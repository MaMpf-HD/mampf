<%# Inline form on the admin announcements page for a new site-wide
    announcement; publishing it puts it up as the banner right away. %>
<%= form_with model: announcement, url: site_announcements_path, local: true,
              class: "px-3 pt-4 pb-3 border-bottom bg-body-tertiary" do |f| %>
  <%= f.trix_editor :details,
                    id: "site-announcement-details-trix",
                    class: "bg-body #{'is-invalid' if announcement.errors[:details].any?}",
                    autofocus: true %>
  <% if announcement.errors[:details].any? %>
    <div class="invalid-feedback d-block">
      <%= announcement.errors[:details].to_sentence %>
    </div>
  <% end %>
  <div class="d-flex justify-content-end gap-2 mt-2">
    <%= link_to t("buttons.cancel"), site_announcements_path,
                class: "btn btn-sm btn-outline-secondary" %>
    <%= f.submit t("buttons.publish"),
                 class: "btn btn-sm btn-primary",
                 data: { turbo_confirm: t("confirmation.announcement") } %>
  </div>
<% end %>
