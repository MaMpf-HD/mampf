<% active = announcement.banner_active %>
<li id="<%= dom_id(announcement) %>"
    class="list-group-item d-flex align-items-center gap-3 py-3
           <%= 'list-group-item-warning' if active %>">
  <div class="flex-grow-1 min-w-0">
    <div class="small text-muted mb-1">
      <%= human_readable_date(announcement.created_at) %>
      &middot;
      <%= announcement.announcer.name %>
    </div>
    <div class="text-break no-katex">
      <%= sanitize(announcement.details) %>
    </div>
  </div>
  <%= form_with model: announcement,
                url: site_announcement_path(announcement),
                local: true,
                class: "flex-shrink-0",
                data: { controller: "submit-on-change" } do |f| %>
    <div class="form-check form-check-reverse form-switch mb-0">
      <%= f.check_box :banner_active,
                      id: "announcement-active-#{announcement.id}",
                      class: "form-check-input",
                      role: "switch",
                      data: { action: "change->submit-on-change#change" } %>
      <%= f.label :banner_active,
                  active ? t("admin.announcement.active") : t("admin.announcement.inactive"),
                  for: "announcement-active-#{announcement.id}",
                  class: "form-check-label small #{active ? 'fw-semibold' : 'text-muted'}" %>
    </div>
  <% end %>
</li>
