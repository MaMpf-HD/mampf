<div data-controller="password-strength"
     data-password-strength-weak-text-value="<%= t("devise.passwords_strength.weak") %>"
     data-password-strength-fair-text-value="<%= t("devise.passwords_strength.fair") %>"
     data-password-strength-good-text-value="<%= t("devise.passwords_strength.good") %>"
     data-password-strength-strong-text-value="<%= t("devise.passwords_strength.strong") %>"
     data-password-strength-local-identifiers-value="<%= PasswordStrengthValidator::LOCAL_IDENTIFIERS.to_json %>"
     data-password-strength-min-length-value="<%= Devise.password_length.min %>"
     data-password-strength-too-short-text-value="<%= t("devise.passwords_strength.too_short",
                                                        count: Devise.password_length.min) %>">
  <%= yield %>
</div>
