<% origin                   = local_assigns[:origin] %>

<div id="password-form-container">
  <p class="form-text mt-0" id="password-hint">
    <%= t('devise.edit.password_change_required_password_help') %>
  </p>
  <%= render "devise/registrations/form_errors", user: user %>
  <%= form_for(user, as: :user,
                    url: user_registration_path(locale: I18n.locale, section: "password"),
                    html: { method: :put, id: "password-form", data: { turbo: true } }) do |f| %>
    <%= hidden_field_tag :origin, origin if origin.present? %>

    <%= render layout: "devise/shared/password_strength_wrapper" do %>
      <% if user.email.present? %>
        <input type="hidden" data-password-strength-target="email" value="<%= user.email %>">
      <% end %>
      <% if user.name.present? %>
        <input type="hidden" data-password-strength-target="name" value="<%= user.name %>">
      <% end %>

      <div class="mb-3">
        <%= f.label :password, t('devise.edit.new_password'), class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: 'form-control',
                            "aria-describedby": "password-hint",
                            data: {
                              "password-strength-target": "password",
                              "action": "input->password-strength#check"
                            } %>
        <div class="progress mt-2 password-strength-meter d-none"
            data-password-strength-target="meterContainer">
          <div class="progress-bar" aria-hidden="true" style="width: 0%;"
              data-password-strength-target="meter"></div>
        </div>
        <div class="form-text" role="status" aria-live="polite"
            data-password-strength-target="feedback"></div>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, t('devise.edit.confirm_new_password'),
                    class: "form-label" %>
        <%= f.password_field :password_confirmation,
                            autocomplete: "new-password",
                            class: 'form-control',
                            "aria-describedby": "password-hint",
                            data: {
                              "password-strength-target": "passwordConfirmation",
                              "action": "blur->password-strength#checkMatch " \
                                        "input->password-strength#clearFieldError"
                            } %>
      </div>

      <div class="mb-3">
        <%= f.label :current_password, t('devise.edit.current_password'),
                    class: "form-label", for: "password_current_password" %>
        <%= f.password_field :current_password,
                            id: "password_current_password",
                            autofocus: true,
                            autocomplete: "current-password",
                            class: 'form-control',
                            "aria-describedby": "password-current-password-hint",
                            data: { "action": "input->password-strength#clearFieldError" } %>
        <div class="form-text" id="password-current-password-hint">
          <%= t('devise.edit.password_change_required_help') %>
        </div>
      </div>
    <% end %>

    <%= f.submit t('devise.edit.update_password'),
                class: 'btn btn-primary' %>
  <% end %>
</div>