<% password_change_required = resource.password_change_required? %>
<% section = password_change_required ? "password" : params[:section].to_s %>
<% section = nil unless %w[email password].include?(section) %>

<h2><%= t(password_change_required ? 'devise.edit.password_change_required_title' : 'devise.edit.title') %></h2>

<% if password_change_required %>
  <p><%= t('devise.edit.password_change_required') %></p>
<% end %>

<% if section.nil? %>
  <div class="d-grid gap-3 mt-4 mb-5">
    <%= link_to t('devise.edit.choose_email'),
                edit_user_registration_path(section: "email", locale: I18n.locale),
                class: 'btn btn-primary py-3' %>
    <%= link_to t('devise.edit.choose_password'),
                edit_user_registration_path(section: "password", locale: I18n.locale),
                class: 'btn btn-primary py-3' %>
  </div>
<% end %>

<% if section == "email" %>
  <section class="mb-5" aria-labelledby="email-heading">
    <h3 class="h5" id="email-heading"><%= t('devise.edit.email_section') %></h3>
    <%= render "devise/registrations/email_form", user: resource, origin: params[:origin] %>
  </section>
  <hr class="my-4">
<% end %>

<% if section == "password" %>
  <section class="mb-4" aria-labelledby="password-heading">
    <h3 class="h5" id="password-heading">
      <%= t(password_change_required ? 'devise.edit.password_change_required_title' : 'devise.edit.password_section') %>
    </h3>
    <%= render "devise/registrations/password_form",
               user: resource,
               origin: params[:origin],
               password_change_required: password_change_required %>
  </section>
<% end %>

<% unless password_change_required %>
  <%= link_to t('back'), edit_profile_path, class: 'btn btn-secondary' %>
<% end %>

<% if password_change_required %>
  <div class="d-flex gap-3 mt-3">
    <%= button_to t('devise.shared.links.forgot_password'),
                  restart_user_password_path(locale: I18n.locale),
                  method: :post,
                  class: 'btn btn-link p-0' %>
    <%= button_to t('navbar.logout'),
                  destroy_user_session_path(locale: I18n.locale),
                  method: :delete,
                  class: 'btn btn-link p-0' %>
  </div>
<% end %>