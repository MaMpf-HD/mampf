<% password_change_required = resource.password_change_required? %>
<% section = password_change_required ? "password" : params[:section].to_s %>
<% section = nil unless %w[email password].include?(section) %>

<h2><%= t(password_change_required ? 'devise.edit.password_change_required_title' : 'devise.edit.title') %></h2>

<% if password_change_required %>
  <p><%= t('devise.edit.password_change_required') %></p>
<% end %>

<% if section.nil? %>
  <div class="d-grid gap-3 mt-4 mb-5">
    <%= link_to t('devise.edit.choose_email'),
                edit_user_registration_path(section: "email", locale: I18n.locale),
                class: 'btn btn-primary py-3' %>
    <%= link_to t('devise.edit.choose_password'),
                edit_user_registration_path(section: "password", locale: I18n.locale),
                class: 'btn btn-primary py-3' %>
  </div>
<% end %>

<%# -- Email form -- %>
<% if section == "email" %>
  <section class="mb-5" aria-labelledby="email-heading">
    <h3 class="h5" id="email-heading"><%= t('devise.edit.email_section') %></h3>

    <%= form_for(resource, as: resource_name,
                           url: registration_path(resource_name, locale: I18n.locale, section: "email"),
                           html: { method: :put, id: "email-form" }) do |f| %>
      <div class="mb-3">
        <%= f.label :email, t('devise.edit.email'), class: "form-label" %>
        <%= f.email_field :email, autofocus: true, class: 'form-control',
                          "aria-describedby": "email-hint" %>
        <div class="form-text" id="email-hint"><%= t('devise.edit.email_hint') %></div>
      </div>

      <div class="mb-3">
        <%= f.label :current_password, t('devise.edit.current_password'),
                    class: "form-label", for: "email_current_password" %>
        <%= f.password_field :current_password, id: "email_current_password",
                             autocomplete: "current-password", class: 'form-control',
                             "aria-describedby": "email-current-password-hint" %>
        <div class="form-text" id="email-current-password-hint">
          <%= t('devise.edit.need_password') %>
        </div>
      </div>

      <%= f.submit t('devise.edit.update_email'),
                   class: 'btn btn-primary' %>
    <% end %>
  </section>

  <hr class="my-4">
<% end %>

<%# -- Password form -- %>
<% if section == "password" %>
  <section class="mb-4">
    <h3 class="h5">
      <%= t(password_change_required ? 'devise.edit.password_change_required_title' : 'devise.edit.password_section') %>
    </h3>
    <p class="form-text mt-0" id="password-hint">
      <%= t(password_change_required ? 'devise.edit.password_change_required_password_help' : 'devise.edit.password_hint') %>
    </p>

    <%= form_for(resource, as: resource_name,
                          url: registration_path(resource_name, locale: I18n.locale, section: "password"),
                          html: { method: :put, id: "password-form" }) do |f| %>
      <%= render layout: "devise/shared/password_strength_wrapper" do %>
        <% if resource.email.present? %>
          <input type="hidden" data-password-strength-target="email" value="<%= resource.email %>">
        <% end %>
        <% if resource.name.present? %>
          <input type="hidden" data-password-strength-target="name" value="<%= resource.name %>">
        <% end %>

        <div class="mb-3">
          <%= f.label :password, t('devise.edit.new_password'), class: "form-label" %>
          <%= f.password_field :password, autocomplete: "off", class: 'form-control',
                              "aria-describedby": "password-hint",
                              data: {
                                "password-strength-target": "password",
                                "action": "input->password-strength#check"
                              } %>
          <div class="progress mt-2 password-strength-meter d-none"
              data-password-strength-target="meterContainer">
            <div class="progress-bar" aria-hidden="true" style="width: 0%;" data-password-strength-target="meter"></div>
          </div>
          <div class="form-text" role="status" aria-live="polite"
              data-password-strength-target="feedback"></div>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, t('devise.edit.confirm_new_password'),
                      class: "form-label" %>
          <%= f.password_field :password_confirmation,
                              class: 'form-control',
                              "aria-describedby": "password-hint",
                              data: {
                                "password-strength-target": "passwordConfirmation",
                                "action": "blur->password-strength#checkMatch " \
                                          "input->password-strength#clearFieldError"
                              } %>
        </div>

        <div class="mb-3">
          <%= f.label :current_password, t('devise.edit.current_password'),
                      class: "form-label", for: "password_current_password" %>
          <%= f.password_field :current_password,
                                id: "password_current_password",
                                autofocus: password_change_required,
                                class: 'form-control',
                                "aria-describedby": "password-current-password-hint",
                                data: { "action": "input->password-strength#clearFieldError" } %>
          <div class="form-text" id="password-current-password-hint">
            <%= t(password_change_required ? 'devise.edit.password_change_required_help' : 'devise.edit.need_password') %>
          </div>
        </div>
      <% end %>

      <%= f.submit t(password_change_required ? 'devise.edit.update' : 'devise.edit.update_password'),
                  class: 'btn btn-primary' %>
    <% end %>
  </section>
<%end%>

<% unless password_change_required %>
  <%= link_to t('back'), edit_profile_path, class: 'btn btn-secondary' %>
<% end %>

<% if password_change_required %>
  <div class="d-flex gap-3 mt-3">
    <%= button_to t('devise.shared.links.forgot_password'),
                  restart_user_password_path(locale: I18n.locale),
                  method: :post,
                  class: 'btn btn-link p-0' %>
    <%= button_to t('navbar.logout'),
                  destroy_user_session_path(locale: I18n.locale),
                  method: :delete,
                  class: 'btn btn-link p-0' %>
  </div>
<% end %>
