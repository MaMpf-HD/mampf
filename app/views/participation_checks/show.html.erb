<% content_for :landing_box_class, "landing-box-wide" %>

<h2><%= t("participation_check.title") %></h2>
<p><%= t("participation_check.lead") %></p>

<ul class="list-unstyled d-grid gap-2 mb-3" data-testid="participation-check">
  <% @lectures.each do |lecture| %>
    <% leave = Rosters::LectureLeave.new(lecture, current_user) %>

    <li class="d-flex flex-wrap align-items-center justify-content-between gap-2">
      <span class="fw-semibold"><%= lecture.title_term_info_no_type %></span>

      <span class="d-flex gap-2">
        <%= button_to t("participation_check.still_taking_part"),
                      confirm_participation_path(lecture),
                      method: :patch,
                      class: "btn btn-sm btn-outline-secondary" %>

        <button
          type="button"
          class="btn btn-sm btn-outline-secondary"
          data-bs-toggle="modal"
          data-bs-target="#<%= LeaveLectureComponent.dialog_id(lecture) %>"
        >
          <%= t("lecture_home.leave.button") %>
        </button>
      </span>

      <% content_for :modals do %>
        <%= render LeaveLectureComponent.new(lecture: lecture, leave: leave, from_check: true) %>
      <% end %>
    </li>
  <% end %>
</ul>

<p class="small text-muted mb-0"><%= t("participation_check.footnote") %></p>
