<div class="row g-3 mx-0 mt-2">
  <!-- Assignment Selector -->
  <div class="col-12 col-md-5 col-xl-4">
    <h5 class="form-label fw-semibold mb-1"><%= t('basics.assignment') %></h5>

    <% if @assignments.size > 1 %>
      <select class="form-select form-select-sm"
              onchange="window.location=this.value">
        <option selected><%= @assignment.title %></option>
        <% (@assignments - [@assignment]).each do |a| %>
          <option value="<%= lecture_tutorials_path(@lecture, params: { assignment: a.id, tutorial: @tutorial.id }) %>">
            <%= a.title %>
          </option>
        <% end %>
      </select>
    <% else %>
      <input class="form-control form-control-sm" disabled value="<%= @assignment.title %>">
    <% end %>
  </div>

  <!-- Tutorial Selector -->
  <div class="col-12 col-md-5 col-xl-4">
    <h5 class="form-label fw-semibold mb-1"><%= t('categories.tutorials') %></h5>

    <% if @tutorials.size > 1 %>
      <%= render partial: 'tutorials/tutorial_dropdown' %>
    <% else %>
      <input class="form-control form-control-sm" disabled value="<%= @tutorial.title %>">
    <% end %>
  </div>
</div>


<!-- ACTION CARD -->
<div>
  <div class="col align-items-end justify-content-between">
    <% if grading_enabled?(@assignment) %>
      <!-- Overview -->
      <% info = overview_info(@tutorial, @assignment) %>
      <div class="border rounded-3 bg-light p-3 mt-3 overview-card">
        <div class="d-flex justify-content-between align-items-baseline mb-2">
          <span class="fw-semibold">
            <%= t('assessment.grading_tutorial.header_overview.title') %>
          </span>
          <span class="small text-muted">
            <%= t('assessment.grading_tutorial.header_overview.progress',
                  graded: info[:graded], total: info[:gradable]) %>
          </span>
        </div>

        <div class="progress overview-progress"
             role="progressbar"
             aria-valuenow="<%= info[:percent] %>"
             aria-valuemin="0"
             aria-valuemax="100">
          <div class="progress-bar bg-success" style="width: <%= info[:percent] %>%"></div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-2 small">
          <% if info[:open].positive? %>
            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">
              <%= t('assessment.grading_tutorial.header_overview.open',
                    count: info[:open]) %>
            </span>
          <% end %>

          <% if info[:unmarked].positive? %>
            <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">
              <%= t('assessment.grading_tutorial.header_overview.unmarked',
                    count: info[:unmarked]) %>
            </span>
          <% end %>

          <% if info[:open].zero? && info[:unmarked].zero? %>
            <span class="badge rounded-pill bg-success-subtle text-success-emphasis">
              <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>
              <%= t('assessment.grading_tutorial.header_overview.done') %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Action Buttons -->
    <div class="d-flex flex-wrap gap-2 justify-content-start m-3 w-auto">
      <% if @stack.present? %>
        <!-- Bulk Download Submissions -->
        <%= link_to bulk_download_submissions_path(id: @tutorial.id, ass_id: @assignment.id),
                    class: "btn btn-primary btn-sm", data: { turbo: false } do %>
          <i class="bi bi-download me-1"></i>
          <%= t('submission.bulk_download_submissions') %>
        <% end %>

        <% if current_user.in?(@tutorial.tutors) %>
          <!-- Bulk Upload -->
          <button class="btn btn-<%= @assignment.active? ? 'secondary' : 'primary' %> btn-sm"
                  id="show-bulk-upload-area"
                  <%= @assignment.active? ? 'disabled' : '' %>>
            <i class="bi bi-upload me-1"></i>
            <%= t('submission.bulk_upload') %>
          </button>
        <% else %>
          <!-- Bulk Download Corrections -->
          <% if @stack.any? { |s| s.correction.present? } %>
            <%= link_to bulk_download_corrections_path(id: @tutorial.id, ass_id: @assignment.id),
                        class: "btn btn-primary btn-sm", data: { turbo: false } do %>
              <i class="bi bi-download me-1"></i>
              <%= t('submission.bulk_download_corrections') %>
            <% end %>
          <% else %>
            <button class="btn btn-secondary btn-sm" disabled>
              <%= t('submission.bulk_download_corrections') %>
            </button>
          <% end %>
        <% end %>

        <!-- Teams CSV -->
        <%= link_to export_teams_to_csv_path(id: @tutorial.id, ass_id: @assignment.id, format: 'csv'),
                    class: "btn btn-dark btn-sm", id: "export-teams" do %>
          <i class="bi bi-file-earmark-arrow-down me-1"></i>
          <%= t('tutorial.teams_as_csv') %>
        <% end %>
      <% end %>

      <!-- Certificate Check -->
      <% if Flipper.enabled?(:quiz_certificates) %>
        <%= link_to validate_certificate_as_tutor_path(params: { lecture_id: @lecture.id }),
                    class: "btn btn-outline-secondary btn-sm", remote: true do %>
          <i class="bi bi-patch-check me-1"></i>
          <%= t('tutorial.certificate_check') %>
        <% end %>
      <% end %>

      <!-- Save bulk changes -->
      <% if grading_enabled?(@assignment) %>
        <button class="btn btn-success btn-sm"
                <%= @assignment.active? ? 'disabled' : '' %>
                data-submission-table-target="bulkSave"
                data-action="click->submission-table#submitAll">
          <i class="bi bi-save me-1"></i>
          Save All Changes
        </button>

        <%= form_with url: point_multi_submissions_tutorial_path,
                      method: :patch,
                      data: { turbo: true, submission_table_target: "form" } do %>
          <input type="hidden" name="submissions" data-submission-table-target="payload">
          <input type="hidden" name="assignment_id" value="<%= @assignment.id %>">
          <input type="hidden" name="tutorial_id" value="<%= @tutorial.id %>">
          <input type="hidden" name="mode" value="tutor">
        <% end %>
      <% end %>
    </div>
  </div>
</div>


<!-- DEADLINE / GRACE PERIOD WARNING -->
<% if current_user.in?(@tutorial.tutors) && (@assignment.active? || @assignment.in_grace_period?) %>
  <div class="alert alert-danger m-3">
    <strong><%= t('basics.attention') %>:</strong>
    <% if @assignment.active? %>
      <%= t('tutorial.deadline_warning', deadline: l(@assignment.deadline, format: :short)) %>
    <% else %>
      <%= t('tutorial.grace_period_warning', friendly_deadline: l(@assignment.friendly_deadline, format: :short)) %>
    <% end %>
  </div>
<% end %>
<% if current_user.in?(@tutorial.tutors) %>
  <div class="card mt-3" id="bulk-upload-area">
    <div class="card-body">
      <% if @stack.present? %>
        <%= render partial: 'tutorials/bulk_correction_form',
                   locals: { tutorial: @tutorial, assignment: @assignment } %>
      <% end %>
    </div>
  </div>

  <div class="row my-3 p-3" id="bulk-upload-report"></div>
<% end %>
