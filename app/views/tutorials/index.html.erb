<% if @tutorial.nil? %>
  <div class="jumbotron">
    <%= t('tutorial.no_tutorials_yet') %>
  </div>
<% elsif @assignments.present? || @achievements.present? %>
<div>
  <div class="row">
    <div class="col-12">
      <%= render partial: 'tutorials/header_index',
               locals: { assignment: @assignment,
                         assignments: @assignments,
                         achievement: @achievement,
                         achievements: @achievements,
                         tutorials: @tutorials,
                         grading_scope: @tutorial,
                         tutorial: @tutorial,
                         stack: @stack } %>
    </div>
  </div>
  <div id="tutorial-table" class="m-3">
    <% if @achievement %>
      <%= render AchievementMarkingTableComponent.new(
        achievement: @achievement,
        grading_scope: @tutorial
      ) %>
    <% else %>
      <%= render TutorialMarkingTableComponent.new(
        assignment: @assignment,
        grading_scope: @tutorial
      ) %>
    <% end %>
  </div>
</div>
<% else %>
  <%# No sheet to mark yet; the group is there, and so is the mail to it. %>
  <div class="d-flex flex-wrap align-items-end gap-3 m-3">
    <%= render partial: 'tutorials/group_columns',
               locals: { tutorials: @tutorials, tutorial: @tutorial } %>
  </div>
  <div class="jumbotron">
    <%= t('assignment.nothing_yet_in_lecture') %>
  </div>
<% end %>
<%= render partial: 'shared/generic_modal',
           locals: { sort: 'validateCertificate',
                     title: t('tutorial.certificate_check') } %>
