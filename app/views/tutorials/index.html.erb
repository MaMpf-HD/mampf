<% if @assignments.present? || @achievements.present? %>
<div>
  <div class="row">
    <div class="col-12">
      <%= render partial: 'tutorials/header_index',
               locals: { assignment: @assignment,
                         assignments: @assignments,
                         achievement: @achievement,
                         achievements: @achievements,
                         tutorials: @tutorials,
                         grading_scope: @tutorial,
                         tutorial: @tutorial,
                         stack: @stack } %>
    </div>
  </div>
  <div id="tutorial-table" class="m-3">
    <% if @achievement %>
      <%= render AchievementMarkingTableComponent.new(
        achievement: @achievement,
        grading_scope: @tutorial
      ) %>
    <% else %>
      <%= render TutorialPointingTableComponent.new(
        assignment: @assignment,
        grading_scope: @tutorial
      ) %>
    <% end %>
  </div>
</div>
<% else %>
  <div class="jumbotron">
    <%= t('assignment.nothing_yet_in_lecture') %>
  </div>
<% end %>
<%= render partial: 'shared/generic_modal',
           locals: { sort: 'validateCertificate',
                     title: t('tutorial.certificate_check') } %>
