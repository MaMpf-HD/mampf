<% if @tutorial.nil? %>
  <div class="jumbotron">
    <%= t('tutorial.no_tutorials_yet') %>
  </div>
<% elsif @participants %>
  <%# A first word to the group comes before the first sheet. %>
  <%= render partial: 'tutorials/header_index',
             locals: { assignment: nil, assignments: @assignments,
                       achievement: nil, achievements: @achievements,
                       tutorials: @tutorials, grading_scope: @tutorial,
                       tutorial: @tutorial, stack: nil } %>
  <%= render TutorialParticipantsComponent.new(tutorial: @tutorial) %>
<% else %>
<div>
  <div class="row">
    <div class="col-12">
      <%= render partial: 'tutorials/header_index',
               locals: { assignment: @assignment,
                         assignments: @assignments,
                         achievement: @achievement,
                         achievements: @achievements,
                         tutorials: @tutorials,
                         grading_scope: @tutorial,
                         tutorial: @tutorial,
                         stack: @stack } %>
    </div>
  </div>
  <div id="tutorial-table" class="m-3">
    <% if @achievement %>
      <%= render AchievementMarkingTableComponent.new(
        achievement: @achievement,
        grading_scope: @tutorial
      ) %>
    <% else %>
      <%= render TutorialMarkingTableComponent.new(
        assignment: @assignment,
        grading_scope: @tutorial
      ) %>
    <% end %>
  </div>
</div>
<% end %>
<%= render partial: 'shared/generic_modal',
           locals: { sort: 'validateCertificate',
                     title: t('tutorial.certificate_check') } %>
