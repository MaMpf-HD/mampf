<% if @assignments.present? %>
<div data-controller="submission-table status-filter">
  <div class="row">
    <div class="col-12">
      <%= render partial: 'tutorials/header_index',
               locals: { assignment: @assignment,
                         tutorial: @tutorial,
                         stack: @stack } %>
    </div>

    <div id="tutorial-table" class="col-12 mt-3">
      <%= render TutorialPointingTableComponent.new(
        mode: "tutor",
        assignment: @assignment,
        tutorial: @tutorial,
        render_filter: false
      ) %>
    </div>
  </div>
</div>
<% else %>
  <div class="jumbotron">
    <%= t('assignment.nothing_yet_in_lecture') %>
  </div>
<% end %>
<%= render partial: 'shared/generic_modal',
           locals: { sort: 'validateCertificate',
                     title: t('tutorial.certificate_check') } %>
