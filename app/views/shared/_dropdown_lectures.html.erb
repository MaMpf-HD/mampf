<% on_start_page = controller_name == "main" && action_name == "start" %>
<% show_pin = lecture.present? && !on_start_page %>
<% pinned_lectures = current_user.quick_access_lectures %>
<li class="nav-item">
  <div class="dropdown-center me-3">
    <button class="btn btn-primary btn-sm dropdown-toggle"
            type="button"
            data-bs-toggle="dropdown">
      <%= t("navbar.quick_access") %>
    </button>
    <div class="dropdown-menu" data-testid="quick-access-menu">
      <% if show_pin %>
        <% pinned = lecture.in?(pinned_lectures) %>
        <% pin_params = { lecture: { id: lecture.id } } %>
        <%= link_to pinned ? unpin_lecture_path(pin_params) : pin_lecture_path(pin_params),
                    class: "dropdown-item",
                    data: { turbo_method: :patch, turbo_stream: true } do %>
          <i class="bi <%= pinned ? "bi-pin-angle-fill" : "bi-pin-angle" %>"
             aria-hidden="true"></i>
          <%= t(pinned ? "navbar.unpin_lecture" : "navbar.pin_lecture",
                title: lecture.course.short_title) %>
        <% end %>
        <% if pinned_lectures.any? %>
          <div class="dropdown-divider"></div>
        <% end %>
      <% end %>
      <% if pinned_lectures.any? %>
        <% pinned_lectures.each do |l| %>
          <%= link_to lecture_path(l), class: "dropdown-item" do %>
            <%= l.course.short_title %>
            <% if l.term %>
              <span class="text-muted small">(<%= l.term.to_label_short %>)</span>
            <% end %>
            <% unless l.published? %>
              <i class="fas fa-eye-slash redtext"
                 tabindex="-1"
                 data-bs-toggle="tooltip"
                 title="<%= t("lecture.unpublished") %>">
              </i>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <div class="dropdown-item-text text-muted">
          <%= t("navbar.no_favorite_lectures_yet") %>
          <% unless show_pin %>
            <br><%= t("navbar.quick_access_hint") %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</li>
