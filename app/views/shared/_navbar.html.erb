<%= render partial: "shared/announcement_banner" %>

<div class="navbars-container">
  <nav class="navbar navbar-expand" id="firstnav">
    <%# Sized in the markup: the svg declares 97mm, and without this the logo
        is rendered huge until navbar.scss applies. %>
    <%= link_to image_tag("/images/mampf-logo.svg",
                          class: 'me-2',
                          id: 'mampf-logo',
                          width: 35, height: 35),
                home_path %>
    <%= link_to t('mampf'),
                home_path,
                class: 'navbar-brand',
                style: "text-decoration: none;",
                id: 'mampfbrand' %>
      <ul class="navbar-nav">
        <li class="nav-item">
          <% is_home_active = !get_class_for_any_path_startswith([lectures_path()]).empty?\
            || !get_class_for_path(root_path()).empty? %>
          <a href="<%= root_path %>"
            class="nav-link bi bi-house-fill <%= is_home_active ? ApplicationHelper::ACTIVE_CSS_CLASS : '' %>"
            data-bs-toggle="tooltip"
            title="<%= t('navbar.home') %>">
          </a>
        </li>

        <li class="nav-item">
          <a href="<%= DefaultSetting::BLOG_LINK %>"
            class="nav-link bi bi-newspaper"
            data-bs-toggle="tooltip"
            title="<%= t('navbar.blog') %>">
          </a>
        </li>
      </ul>

      <ul class="navbar-nav ms-auto me-auto" id="lecturesDropdown">
        <%= render partial: 'shared/dropdown_lectures',
                  locals: { lecture: @lecture } %>
      </ul>

      <%= render partial: 'shared/dropdown_notifications' %>

      <ul class="navbar-nav" id="searchField">
        <li class="nav-item">
          <a href="<%= comments_path %>"
            id="commentsIcon"
            class="nav-link bi bi-chat-quote-fill
                <%= current_user.unread_comments ? 'new-comment' : '' %>
                <%= get_class_for_path(comments_path()) %>"
            data-bs-toggle="tooltip"
            title="<%= t('navbar.comments') %>">
          </a>
        </li>

        <li class="nav-item">
          <a href="<%= search_index_path %>"
            class="nav-link bi bi-search <%= get_class_for_path(search_index_path()) %>"
            data-bs-toggle="tooltip"
            aria-label="<%= t('navbar.search') %>"
            title="<%= t('navbar.search') %>">
          </a>
        </li>
      </ul>

      <%= render(AvatarDropdownComponent.new(user: current_user)) %>
  </nav>
  <nav class="navbar navbar-expand" id="secondnav"
      style="display: none;">
  </nav>
</div>
