<div class="container-md py-3">
  <h1 class="h3"><%= t("support.users.title") %></h1>

  <p class="text-muted"><%= t("support.users.explainer") %></p>

  <%= render(SearchForm::SearchForm.new(url: support_users_path, context: "support-users",
                                        local: true, values: search_values)) do |c| %>
    <% c.add_fulltext_field %>
    <% c.add_program_field %>
    <% c.add_submit_field %>
  <% end %>

  <div id="support-user-results">
    <% if @users.any? %>
      <p class="small text-muted mb-2">
        <%= t("support.users.hits", count: @pagy.count) %>
      </p>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th scope="col"><%= t("support.users.columns.name") %></th>

              <th scope="col">
                <%= User.human_attribute_name(:matriculation_number) %>
              </th>

              <th scope="col"><%= t("support.users.columns.email") %></th>
              <th scope="col"><%= t("support.users.columns.program") %></th>

              <th scope="col">
                <span class="visually-hidden">
                  <%= t("support.users.columns.actions") %>
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            <% @users.each do |user| %>
              <tr>
                <th scope="row" class="fw-normal"><%= listed_name(user) %></th>

                <td><%= user.matriculation_number %></td>
                <td><%= user.email %></td>
                <td><%= user.program&.name_with_subject %></td>

                <td class="text-end">
                  <%= link_to t("support.users.open"),
                              edit_support_user_path(user, search: search_query),
                              "aria-label": t("support.users.open_for", user: user.email) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%== pagy_series_nav(@pagy) if @pagy.pages > 1 %>
    <% elsif params[:search].present? %>
      <p><%= t("support.users.no_hits") %></p>
    <% end %>
  </div>
</div>
