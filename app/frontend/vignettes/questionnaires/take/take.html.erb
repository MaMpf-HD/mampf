<%= vite_javascript_tag "vignettes/questionnaires/take/take.js" %>
<%= vite_stylesheet_tag "vignettes/questionnaires/take/take.scss" %>

<!-- Info Slide Modals -->
<% @slide.info_slides.each_with_index do |info_slide, index| %>
    <%= render partial: 'vignettes/info_slides/take/take_modal',
                        locals: { index: index, info_slide: info_slide } %>
<% end %>

<!-- Slide -->
<%# A tracked run posts its answer, so it needs a form. An untracked one and
    a preview must not be able to submit at all -- not even by pressing Enter
    in a number field -- so their fields are rendered outside one. %>
<% if @tracked %>
  <%= form_with(model: @answer, scope: :vignettes_answer, id: "vignettes-answer-form",
                url: submit_answer_questionnaire_url(@questionnaire),
                local: true) do |form| %>
    <%= render "vignettes/questionnaires/take/card", form: form %>
  <% end %>
<% else %>
  <%= fields(scope: :vignettes_answer, model: @answer) do |form| %>
    <%= render "vignettes/questionnaires/take/card", form: form %>
  <% end %>
<% end %>

