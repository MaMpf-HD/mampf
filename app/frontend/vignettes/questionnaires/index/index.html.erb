<%= vite_stylesheet_tag "vignettes/questionnaires/index/index.scss" %>

<div class="container-md small-width mt-4">
  <div class="d-flex flex-wrap align-items-center mb-4">
    <h1 class="mb-0 fw-bold fs-3">
      <%= t('vignettes.vignettes') %>
    </h1>
    <% if @editor %>
      <button type="button"
              class="btn btn-sm btn-outline-primary ms-3"
              data-bs-toggle="modal"
              data-bs-target="#vignetteModal">
        <i class="bi bi-plus-circle"></i>
        <%= t('vignettes.create_new') %>
      </button>
    <% end %>
  </div>

  <% if @questionnaires.blank? %>
    <div class="alert alert-info">
      <%= t('vignettes.no_active_questionnaires') %>
    </div>
  <% else %>
    <ul class="list-group" data-controller="vignettes-resume">
      <% @questionnaires.each do |questionnaire| %>
        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center">
          <div>
            <span class="fw-bold"><%= questionnaire.title %></span>
            <% unless questionnaire.published %>
              <span class="badge text-bg-secondary ms-2">
                <%= t('vignettes.unpublished_badge') %>
              </span>
            <% end %>
            <% if questionnaire.data_collection? %>
              <span class="badge text-bg-light text-dark ms-2">
                <i class="bi bi-clipboard-data"></i>
                <%= t('vignettes.consent.data_collection') %>
              </span>
            <% end %>
          </div>

          <div class="d-flex align-items-center">
            <% if @editor %>
              <%= link_to edit_questionnaire_path(questionnaire),
                          class: "btn btn-sm btn-outline-secondary me-2",
                          data: { turbo_frame: "main" } do %>
                <i class="bi bi-pencil-fill"></i>
                <%= t('buttons.edit') %>
              <% end %>
            <% end %>
            <% if questionnaire.published %>
              <%= link_to take_questionnaire_path(questionnaire),
                          class: "btn btn-sm btn-primary",
                          data: { vignettes_resume_target: "link",
                                  questionnaire_id: questionnaire.id,
                                  turbo_frame: "_top",
                                  turbo_prefetch: false } do %>
                <span data-resume-label="<%= t('vignettes.continue') %>">
                  <%= t('vignettes.take') %>
                </span>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

<% if @editor %>
  <%= render 'vignettes/questionnaires/new/vignette_modal', lecture: @lecture %>
<% end %>
