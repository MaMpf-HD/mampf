<%#
  A tutor's mail to their group, from the page they grade it on. The last
  few they sent stand under the form; nobody else sees them. While the
  group's registration runs, a second one goes to those registered so far.
%>
<%# locals: (lecture:, audience:, return_to:, group:, kind: "tutorial") %>
<% modal_id = "tutorial-mail-modal-#{audience.key.parameterize}" %>
<% texts = kind == "registered" ? "student_message.tutorial.registered_" : "student_message.tutorial." %>

<button
  type="button"
  class="btn btn-sm btn-outline-primary text-nowrap"
  data-bs-toggle="modal"
  data-bs-target="#<%= modal_id %>"
>
  <i class="bi bi-envelope me-1" aria-hidden="true"></i>
  <%= t("#{texts}button") %>
</button>

<div
  class="modal fade"
  id="<%= modal_id %>"
  tabindex="-1"
  aria-labelledby="<%= modal_id %>-title"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="<%= modal_id %>-title">
          <%= t("#{texts}title", tutorial: group.title) %>
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="<%= t("buttons.close") %>"
        ></button>
      </div>

      <div class="modal-body">
        <p class="text-muted small">
          <%= t("#{texts}hint") %>
        </p>

        <%= render partial: "student_messages/form",
                   locals: { lecture: lecture, catalog: nil, fixed_audience: audience,
                             return_to: return_to } %>

        <%= render partial: "student_messages/sent",
                   locals: { messages: lecture.student_messages.where(sender: current_user)
                                              .to_audience(audience.key)
                                              .order(created_at: :desc).limit(5) } %>
      </div>
    </div>
  </div>
</div>
