<div class="table-responsive mb-4">
  <table class="table table-hover mb-0 align-middle">
    <thead class="table-light">
      <tr>
        <th scope="col" class="border-top-0 person-name-column">
          <%= t("basics.name") %>
        </th>

        <th scope="col" class="border-top-0">
          <%= User.human_attribute_name(:matriculation_number) %>
        </th>

        <th scope="col" class="border-top-0">
          <%= t("roster.left.column") %>
        </th>

        <th scope="col" class="border-top-0 text-end">
          <%= t("basics.actions") %>
        </th>
      </tr>
    </thead>

    <tbody>
      <% if component.participants.empty? %>
        <tr>
          <td colspan="4" class="text-center py-4 text-muted border-bottom-0">
            <%= t(component.search_string.present? ? "roster.details.empty_filtered" : "roster.left.empty") %>

            <%= render "roster/components/roster_participants_search_hits",
                       component: component %>
          </td>
        </tr>
      <% else %>
        <% component.participants.each do |membership| %>
          <% user = membership.user %>

          <tr>
            <td><%= user.tutorial_name %></td>
            <td><%= user.matriculation_number %></td>
            <td><%= component.left_description(membership) %></td>

            <td class="text-end">
              <div class="d-flex justify-content-end gap-1">
                <%= render "shared/copy_email_button", email: user.email %>

                <% if component.readmission_options.any? %>
                  <%= form_with url: component.helpers.add_member_lecture_path(component.lecture),
                                method: :post,
                                local: true,
                                class: "d-flex gap-1",
                                data: {
                                  turbo_confirm: t("roster.left.readmit_into_group_confirm",
                                                   user: user.tutorial_name)
                                } do |f| %>
                    <%= f.hidden_field :user_id, value: user.id, id: nil %>
                    <%= f.hidden_field :source, value: :participants, id: nil %>
                    <%= f.hidden_field :view, value: "left", id: nil %>
                    <%= component.helpers.hidden_group_type_field(component.group_type, id: nil) %>
                    <%= f.hidden_field :page, value: component.pagy&.page, id: nil %>

                    <%= f.select :group,
                                 component.readmission_options,
                                 { prompt: t("roster.left.choose_group") },
                                 required: true,
                                 id: nil,
                                 class: "form-select form-select-sm w-auto",
                                 "aria-label": t("roster.left.group_for",
                                                 user: user.tutorial_name) %>

                    <%= f.submit t("roster.left.readmit"),
                                 class: "btn btn-sm btn-outline-secondary" %>
                  <% end %>
                <% else %>
                  <span class="small text-muted">
                    <%= t("roster.left.no_open_group") %>
                  </span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<% if (nav = component.pagination_nav) %>
  <div class="d-flex justify-content-center pb-3">
    <%== nav %>
  </div>
<% end %>
