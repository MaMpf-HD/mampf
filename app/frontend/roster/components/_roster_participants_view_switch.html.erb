<div class="btn-group btn-group-sm" role="group">
  <% ["enrolled", "registered"].each do |view| %>
    <%= link_to component.helpers.lecture_roster_participants_path(component.lecture,
                                                                   view: view,
                                                                   campaign: component.campaign&.id,
                                                                   search: component.search_string,
                                                                   group_type: component.group_type),
                class: "btn btn-outline-secondary #{'active' if component.view == view}",
                data: { turbo_frame: "roster_participants_panel" },
                aria: { current: ("true" if component.view == view) } do %>
      <%= t("roster.views.#{view}") %>
      (<span><%= component.counts[view == "registered" ? :registered : :total] || 0 %></span>)
    <% end %>
  <% end %>
</div>
