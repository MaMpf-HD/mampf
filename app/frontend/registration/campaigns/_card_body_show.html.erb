<%= vite_stylesheet_tag "registration/allocations/allocation.css" %>
<%= vite_stylesheet_tag "roster/roster.scss" %>

<% show_allocation_dashboard = campaign.closed? || campaign.processing? ||
  campaign.completed? %>

<% dashboard = Registration::AllocationDashboard.new(campaign) if show_allocation_dashboard %>
<% has_violators = dashboard&.blockers? %>

<% registrations_link = link_to(t("registration.campaign.registrations_link"),
                                 edit_lecture_path(campaign.campaignable,
                                                   tab: "participants",
                                                   view: "registered",
                                                   campaign: campaign.id),
                                 data: { turbo_frame: "_top" }) %>

<% hint_suffix = campaign.enrolls_in_lecture? ? "" : "_without_enrollment" %>

<% if campaign.awaiting_finalization? %>
  <p class="small text-muted">
    <i class="bi bi-clock me-1" aria-hidden="true"></i>

    <%= t("registration.campaign.deadline_passed_hint#{hint_suffix}_html",
          link: registrations_link) %>
  </p>
<% elsif campaign.open? %>
  <p class="small text-muted">
    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>

    <%= t("registration.campaign.registrations_hint#{hint_suffix}_html",
          link: registrations_link) %>
  </p>
<% end %>

<%= render "registration/campaigns/card_body_actions",
           campaign: campaign, has_violators: has_violators %>

<% if show_allocation_dashboard %>
  <% if campaign.preference_based? && !dashboard.allocation_run? %>
    <%= render "registration/allocations/pre_allocation_demand",
               campaign: campaign,
               dashboard: dashboard,
               embedded: true %>
  <% else %>
    <%= render "registration/allocations/dashboard",
                 campaign: campaign,
                 dashboard: dashboard,
                 embedded: true %>
  <% end %>
<% else %>
  <%= render "registration/campaigns/card_body_items", campaign: campaign %>
<% end %>
