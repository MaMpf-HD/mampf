<div id="registration_items_container">
  <% can_add_groups = campaign.draft? && campaign.campaignable.is_a?(Lecture) %>

  <% if campaign.completed? %>
    <div class="alert alert-light border">
      <div class="d-flex align-items-center">
        <i class="bi bi-info-circle fs-4 me-3 text-muted"></i>

        <div>
          <p class="mb-1 fw-bold">
            <%= t('registration.campaign.completed_title') %>
          </p>

          <p class="mb-2 text-muted small">
            <%= t('registration.campaign.completed_description') %>
          </p>

          <%= link_to t('registration.campaign.go_to_roster'),
                        edit_lecture_path(campaign.campaignable, tab: "participants"),
                        class: "btn btn-sm btn-primary" %>
        </div>
      </div>
    </div>
  <% else %>
    <% items = Rosters::RegisterableOrdering.sort_items(
         campaign.registration_items.includes(:registerable)
       ) %>
    <% footer = capture do %>
      <% if can_add_groups %>
        <%= render "registration/campaigns/add_group_links",
                   lecture: campaign.campaignable,
                   section: :campaign,
                   campaign: campaign %>
      <% end %>
    <% end %>
    <%= render layout: "registration/campaigns/group_rows",
               locals: {
                 count_kind: campaign.first_come_first_served? ? "confirmed" : "first_choices",
                 lecture: campaign.campaignable,
                 with_head: items.any?,
                 footer: footer
               } do %>
      <% items.each do |item| %>
        <%= render GroupRowComponent.new(registerable: item.registerable, item: item) %>
      <% end %>
    <% end %>
  <% end %>
</div>
