<%# locals: (support_request:) %>
<p
  class="small"
  role="status"
  tabindex="-1"
  data-support-widget-target="result"
>
  <i class="bi bi-check-circle text-success me-1" aria-hidden="true"></i>
  <%= t(user_signed_in? ? "support_request.sent" : "support_request.sent_signed_out") %>
</p>

<%= render "support_requests/form", support_request: support_request, intro: false %>
