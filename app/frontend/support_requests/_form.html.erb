<%# locals: (support_request:, throttled: nil, intro: true) %>
<% email_invalid = support_request.errors[:email].any? %>
<% message_invalid = support_request.errors[:message].any? %>

<%= form_with model: support_request, url: support_requests_path, local: true,
              data: { support_widget_target: "form" } do |f| %>
  <% if intro %>
    <p class="small text-muted">
      <%= t(user_signed_in? ? "support_request.intro_html" : "support_request.intro_signed_out_html",
            email: mail_to(DefaultSetting::FEEDBACK_EMAIL)) %>
    </p>
  <% end %>

  <% if throttled %>
    <div class="alert alert-warning py-2 small" role="alert">
      <%= throttled %>
    </div>
  <% end %>

  <% unless user_signed_in? %>
    <div class="mb-2">
      <%= f.label :email, t("support_request.email"), class: "form-label small mb-1" %>

      <%= f.email_field :email,
                        class: class_names("form-control form-control-sm",
                                           "is-invalid": email_invalid),
                        required: true,
                        autocomplete: "email",
                        aria: { invalid: email_invalid,
                                describedby: ("support-request-email-error" if email_invalid) },
                        data: { support_widget_target: "email" } %>

      <% if email_invalid %>
        <div id="support-request-email-error" class="invalid-feedback">
          <%= support_request.errors.full_messages_for(:email).to_sentence %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="mb-2">
    <%= f.label :message, t("support_request.message"), class: "visually-hidden" %>

    <%= f.text_area :message,
                    rows: 6,
                    class: class_names("form-control", "is-invalid": message_invalid),
                    placeholder: t("support_request.message_placeholder"),
                    required: true,
                    minlength: SupportRequest::MESSAGE_MIN_LENGTH,
                    maxlength: SupportRequest::MESSAGE_MAX_LENGTH,
                    aria: { invalid: message_invalid,
                            describedby: ("support-request-message-error" if message_invalid) },
                    data: { support_widget_target: "message" } %>

    <% if message_invalid %>
      <div id="support-request-message-error" class="invalid-feedback">
        <%= support_request.errors.full_messages_for(:message).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="text-end">
    <%= f.submit t("support_request.send"), class: "btn btn-primary btn-sm" %>
  </div>
<% end %>
