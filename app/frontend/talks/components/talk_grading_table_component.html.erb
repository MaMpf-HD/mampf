<%= helpers.turbo_frame_tag "grading-table" do %>
  <% if gradable_talks.any? %>
    <div data-controller="status-filter">
      <div class="d-flex flex-wrap align-items-end gap-2 m-3">
        <div>
          <label class="form-label small mb-1" for="talk-filter-name">
            <%= t('assessment.grading_tutorial.filter_name') %>
          </label>

          <input
            type="search"
            id="talk-filter-name"
            class="form-control form-control-sm"
            autocomplete="off"
            data-status-filter-target="name"
            data-action="input->status-filter#search"
          >
        </div>

        <button
          type="button"
          class="btn btn-link btn-sm"
          hidden
          data-status-filter-target="reset"
          data-action="click->status-filter#reset"
        >
          <%= t("assessment.grading_tutorial.filter_reset") %>
        </button>

        <span
          class="small text-muted pb-1"
          hidden
          data-status-filter-target="count"
          data-template="<%= t("assessment.grading_tutorial.filter_count", shown: "%{shown}", total: "%{total}") %>"
        ></span>
      </div>

      <div
        class="table-wrapper"
        style="<%= layout.css_vars %>"
        data-controller="table-fade"
      >
        <div class="table-overflow" data-table-fade-target="inner">
          <table class="table table-hover align-middle my-3 grading-table">
            <thead>
              <%= render(PointingTableHeaderComponent.new(
                assessable: gradable_talks.first,
                layout: layout
              )) %>
            </thead>

            <tbody>
              <% gradable_talks.each do |talk| %>
                <tr
                  class="group-header"
                  data-status-filter-target="group"
                  data-status-filter-group-id="<%= talk.id %>"
                >
                  <td
                    colspan="<%= layout.columns.size %>"
                    class="group-heading"
                  >
                    <span class="fw-semibold"><%= talk.title %></span>
                  </td>
                </tr>

                <% talk.speakers.each do |speaker| %>
                  <% participation = participation_for(talk.assessment, speaker) %>

                  <% if participation %>
                    <%= render ParticipationRowComponent.new(
                      participation: participation,
                      grading_scope: @seminar,
                      assessment: talk.assessment,
                      table_option: :grading,
                      group_id: talk.id
                    ) %>
                  <% end %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-muted m-3" hidden data-status-filter-target="empty">
        <%= t("assessment.grading_tutorial.filter_no_match") %>
      </p>
    </div>
  <% else %>
    <div class="jumbotron mt-3">
      <%= t('assessment.grading_talk.no_talks_gradable') %>
    </div>
  <% end %>

  <% if legacy_talks.any? %>
    <div class="card mt-3">
      <div class="card-header">
        <h6 class="mb-0">
          <i class="bi bi-person-dash me-1"></i>
          <%= t('assessment.legacy_talks') %>
        </h6>
      </div>

      <div class="card-body">
        <p class="text-muted small mb-2">
          <%= t('assessment.legacy_talks_info') %>
        </p>

        <table class="table align-middle mb-0">
          <tbody>
            <% legacy_talks.each do |talk| %>
              <%= render AssessmentListItemComponent.new(
                assessable: talk,
                lecture: @seminar,
                legacy: true
              ) %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% end %>
