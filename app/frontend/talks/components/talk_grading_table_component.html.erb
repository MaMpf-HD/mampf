<%= helpers.turbo_frame_tag "talk-grading-table" do %>
  <% if gradable_talks.any? %>
    <div data-controller="status-filter">
      <div class="d-flex gap-2 m-3 align-items-center">
        <div class="d-flex align-items-center">
          <input
            type="text"
            class="form-control form-control-sm w-auto"
            placeholder="<%= t('assessment.grading_tutorial.filter_name') %>"
            aria-label="<%= t('assessment.grading_tutorial.filter_name') %>"
            autocomplete="off"
            data-action="input->status-filter#search"
          >
        </div>

        <div
          class="d-flex gap-2 align-items-center"
          data-status-filter-target="activeFilters"
        ></div>
      </div>

      <div
        class="table-wrapper"
        style="<%= sticky_css_vars %>"
        data-controller="table-fade"
      >
        <div class="table-overflow" data-table-fade-target="inner">
          <table
            class="table table-hover align-middle my-3 grading-table"
            style="<%= sticky_css_vars %>"
          >
            <thead style="background: #fafafa;">
              <%= render(PointingTableHeaderComponent.new(
                grading_scope: @grading_scope,
                assessable_type: Talk.name,
                grading_enabled: grading_enabled?
              )) %>
            </thead>

            <tbody>
              <% gradable_talks.each do |talk| %>
                <tr
                  class="group-header"
                  data-status-filter-group-id="<%= talk.id %>"
                >
                  <td
                    colspan="7"
                    style="background: #C7DDF0; color: #254A68; padding-top: 1px; padding-bottom: 1px;"
                  >
                    <span class="fw-semibold"><%= talk.title %></span>
                  </td>
                </tr>

                <% talk.speakers.each do |speaker| %>
                  <% participation = init_participation(talk.assessment, speaker) %>

                  <% if participation %>
                    <%= render ParticipationRowComponent.new(
                      participation: participation,
                      grading_scope: @seminar,
                      assessment: talk.assessment,
                      save_url: grade_form_url(participation),
                      refresh_url: refresh_form_url(participation),
                      group_id: talk.id
                    ) %>
                  <% end %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="jumbotron mt-3">
      <%= t('assessment.grading_talk.no_talks_gradable') %>
    </div>
  <% end %>

  <% if legacy_talks.any? %>
    <div class="card mt-3">
      <div class="card-header">
        <h6 class="mb-0">
          <i class="bi bi-person-dash me-1"></i>
          <%= t('assessment.legacy_talks') %>
        </h6>
      </div>

      <div class="card-body">
        <p class="text-muted small mb-2">
          <%= t('assessment.legacy_talks_info') %>
        </p>

        <table class="table align-middle mb-0">
          <tbody>
            <% legacy_talks.each do |talk| %>
              <%= render AssessmentListItemComponent.new(
                assessable: talk,
                lecture: @seminar,
                legacy: true
              ) %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% end %>
