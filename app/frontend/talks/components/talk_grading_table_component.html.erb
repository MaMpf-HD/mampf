<%= helpers.turbo_frame_tag "grading-table" do %>
  <% if gradable_talks.any? %>
    <div data-controller="status-filter">
      <div class="my-3">
        <%= render PointingSummaryComponent.new(statuses: row_statuses, hand_ins: false) %>

        <%= render PointingFilterComponent.new(id: "talks-#{@seminar.id}",
                                               status_options: status_options) %>
      </div>

      <div
        class="table-wrapper"
        style="<%= layout.css_vars %>"
        data-controller="table-fade"
      >
        <div class="table-overflow" data-table-fade-target="inner">
          <table class="table table-hover align-middle my-3 grading-table">
            <thead>
              <%= render(PointingTableHeaderComponent.new(
                assessable: gradable_talks.first,
                layout: layout
              )) %>
            </thead>

            <tbody>
              <% rows.each do |participation| %>
                <%= render ParticipationRowComponent.new(
                  participation: participation,
                  grading_scope: @seminar,
                  assessment: participation.assessment,
                  table_option: :grading
                ) %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-muted my-3" hidden data-status-filter-target="empty">
        <%= t("assessment.grading_tutorial.filter_no_match") %>
      </p>
    </div>
  <% else %>
    <div class="jumbotron mt-3">
      <%= t('assessment.grading_talk.no_talks_gradable') %>
    </div>
  <% end %>

  <% if legacy_talks.any? %>
    <div class="card mt-3">
      <div class="card-header">
        <h6 class="mb-0">
          <i class="bi bi-person-dash me-1"></i>
          <%= t('assessment.legacy_talks') %>
        </h6>
      </div>

      <div class="card-body">
        <p class="text-muted small mb-2">
          <%= t('assessment.legacy_talks_info') %>
        </p>

        <table class="table align-middle mb-0">
          <tbody>
            <% legacy_talks.each do |talk| %>
              <%= render AssessmentListItemComponent.new(
                assessable: talk,
                lecture: @seminar,
                legacy: true
              ) %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% end %>
