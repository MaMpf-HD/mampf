<tr
  id="<%= row_id %>"
  is="turbo-frame"
  data-id="<%= @user.id %>"
  data-controller="grade-talk-row"
  data-user-row-id="<%= @user.id %>"
  data-action="dirty->talk-grading-table#rowDirty clean->talk-grading-table#rowClean"
  data-status-filter-status="<%= status_value %>"
>
  <!-- Column 1: Speaker name + copy email -->
  <td class="sticky-col team-col">
    <div class="d-flex justify-content-between">
      <%= @user.tutorial_name %>

      <i
        class="
          clipboardpopup bi bi-clipboard clickable
          text-secondary clipboard-btn ms-3 clipboard-button
        "
        style="width: fit-content;"
        data-clipboard-text="<%= @user.email %>"
        data-bs-toggle="tooltip"
        title="<%= t('buttons.copy_email_to_clipboard') %>"
      >
        <span class="clipboardpopuptext token-clipboard-popup">
          <%= t('basics.emails_copied_to_clipboard') %>
        </span>
      </i>
    </div>
  </td>

  <!-- Column 2: Status -->
  <td class="text-center sticky-col status-col">
    <span
      class="<%= badge_status_participation_class %>"
      style="font-size: 11px; font-weight: 500; letter-spacing: 0.02em; padding: 4px 10px;"
    >
      <%= status_label %>
    </span>
  </td>

  <!-- Column 3: Grade (editable) -->
  <td class="text-center sticky-col grade-col">
    <% if allow_grading? %>
      <%= tag.select(
            name: "grade",
            class: "form-select form-select-sm",
            data: { grade_talk_row_target: "gradeInput", action: "change->grade-talk-row#onFieldChanged" }
          ) do %>
        <%= safe_join(
              grade_options.map do |label, value|
                tag.option(label, value: value, selected: value == grade_text)
              end
            ) %>
      <% end %>
    <% else %>
      <%= grade_display %>
    <% end %>
  </td>

  <!-- Column 4: Note (editable) -->
  <td class="note-col">
    <% if allow_grading? %>
      <%= text_field_tag "note", @participation&.note,
                          class: "form-control form-control-sm",
                          data: { grade_talk_row_target: "noteInput", action: "input->grade-talk-row#onFieldChanged" } %>
    <% else %>
      <span class="text-muted small"><%= @participation&.note %></span>
    <% end %>
  </td>

  <!-- Column 5: Graded by / at -->
  <td class="text-muted small">
    <%= grader_display %>
  </td>

  <td class="text-muted small">
    <% if graded_at_relative %>
      <span title="<%= graded_at_full %>">
        <%= graded_at_relative %>
      </span>
    <% end %>
  </td>

  <!-- Column 6: Actions -->
  <td class="text-end sticky-col action-col">
    <div class="d-inline-flex align-items-center flex-nowrap gap-1">
      <% if can_grade? %>
        <%= form_with url: grade_form_url,
                    method: :patch,
                    data: { turbo: true, grade_talk_row_target: "form" },
                    html: { style: "display:none;" } do %>
          <input type="hidden" name="grade" data-grade-talk-row-target="gradePayload">
          <input type="hidden" name="comment" data-grade-talk-row-target="notePayload">
        <% end %>
        <%= save_row_button %>

        <%= form_with url: refresh_form_url,
                    method: :patch,
                    data: { turbo: true, grade_talk_row_target: "refreshForm" },
                    html: { style: "display:none;" } %>
        <%= refresh_row_button %>

        <%= button_to t("assessment.mark_absent"),
                    mark_absent_url,
                    method: :patch,
                    form: { data: { turbo: true } },
                    class: "btn btn-sm btn-outline-danger" %>
      <% end %>
    </div>
  </td>
</tr>