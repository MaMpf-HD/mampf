<%# locals: (text:) %>
<div class="alert alert-danger py-2 small" role="alert">
  <p class="mb-2"><%= t("support_mail.send_failed") %></p>

  <div
    data-controller="clipboard"
    data-clipboard-text-value="<%= text %>"
    data-clipboard-confirmation-value="<%= t("support_mail.copied") %>"
    data-clipboard-failure-value="<%= t("support_mail.copy_failed") %>"
    data-clipboard-resting-icon-value="bi-clipboard"
  >
    <button
      type="button"
      class="btn btn-sm btn-outline-danger"
      data-action="clipboard#copy"
    >
      <i
        class="bi bi-clipboard me-1"
        aria-hidden="true"
        data-clipboard-target="icon"
      ></i>

      <%= t("support_mail.copy") %>
    </button>

    <span class="visually-hidden" role="status" data-clipboard-target="status"></span>
  </div>
</div>
