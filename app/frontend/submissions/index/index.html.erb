<%= vite_stylesheet_tag "submissions/index/index.scss" %>

<%# A row whose name and number sit a screen apart is two lists, not one. %>
<div class="small-width">
  <section class="mb-4" aria-labelledby="due-heading">
    <h3 class="lecture-pane-header" id="due-heading"><%= t("submission.hub.due_now") %></h3>

    <div class="row">
      <% if @hub.open_sheets.any? %>
        <% @hub.due.each do |sheet| %>
          <div class="col-12 col-lg-7 mb-3">
            <%= render(SubmissionCardComponent.new(
                         sheet: sheet,
                         invites: @hub.invites_for(sheet.assignment),
                         partners: @hub.possible_partners)) %>
          </div>
        <% end %>
        <%# Sheets due later keep their card too - handing in early is a thing
            people do - but below, at full width, so the next deadline leads. %>
        <% (@hub.open_sheets - @hub.due).each do |sheet| %>
          <div class="col-12 mb-3">
            <%= render(SubmissionCardComponent.new(
                         sheet: sheet,
                         invites: @hub.invites_for(sheet.assignment),
                         partners: @hub.possible_partners)) %>
          </div>
        <% end %>
      <% else %>
        <div class="col-12 col-lg-7">
          <%= render(NoSheetDueComponent.new(next_scheduled: @hub.next_scheduled,
                                             latest_marked: @hub.latest_marked)) %>
        </div>
      <% end %>
    </div>
  </section>

  <hr class="lecture-pane-separator">

  <%= render(SheetListComponent.new(sheets: @history, lecture: @lecture,
                                    due: @hub.due)) %>
</div>
