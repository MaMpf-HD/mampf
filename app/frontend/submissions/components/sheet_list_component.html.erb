<section aria-labelledby="sheets-heading">
  <div class="d-flex justify-content-between align-items-end mb-2">
    <h3 class="lecture-pane-header mb-0" id="sheets-heading">
      <%= t("submission.hub.heading") %>
    </h3>

    <% if any? %>
      <span class="hub-aside text-muted text-nowrap"><%= count_label %></span>
    <% end %>
  </div>

  <% if any? %>
    <div class="sheet-list">
      <div class="sheet-row sheet-head field-label">
        <div><%= t("submission.hub.column_sheet") %></div>
        <div><%= t("submission.hub.column_status") %></div>
        <div class="text-end"><%= t("submission.hub.column_points") %></div>
        <div></div>
      </div>

      <% sheets.each do |sheet| %>
        <%= render(SheetRowComponent.new(sheet: sheet)) %>
      <% end %>
    </div>
    <% if deletion_notice %>
      <p class="hub-aside text-muted mt-3 mb-0"><%= deletion_notice %></p>
    <% end %>
  <% else %>
    <p class="text-muted mb-0"><%= empty_message %></p>
  <% end %>
</section>
