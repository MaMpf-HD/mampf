<%= helpers.turbo_frame_tag frame_id do %>
  <section class="next-action" aria-labelledby="<%= heading_id %>">
    <% if error %>
      <div class="alert alert-warning py-2"><%= error %></div>
    <% end %>

    <div class="d-flex justify-content-between gap-3 align-items-start">
      <div>
        <h2 class="h4 mb-1" id="<%= heading_id %>"><%= assignment.title %></h2>
        <p class="mb-0"><%= due_line %></p>
        <p class="small text-muted mb-3"><%= meta_parts.join(" · ") %></p>
      </div>
      <%= render(SheetChipComponent.new(sheet: sheet)) %>
    </div>

    <% invites.each do |invite| %>
      <%= render(SubmissionInviteComponent.new(invite: invite,
                                               assignment: assignment)) %>
    <% end %>

    <% if handed_in? %>
      <div class="file-pill mb-3">
        <i class="fas fa-file-pdf text-danger" aria-hidden="true"></i>
        <%= link_to file_name, show_submission_manuscript_path(submission),
                    class: "file-name flex-grow-1", data: { turbo: false } %>
        <span class="small text-muted text-nowrap"><%= file_details %></span>
      </div>
      <% if correction_name %>
        <div class="file-pill mb-3">
          <i class="fas fa-file-pdf text-danger" aria-hidden="true"></i>
          <%= link_to correction_name, show_correction_path(submission),
                      class: "file-name flex-grow-1", data: { turbo: false } %>
          <span class="small text-muted text-nowrap">
            <%= t("submission.hub.fold.correction_label") %>
          </span>
        </div>
      <% end %>
    <% end %>

    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
      <% if submission %>
        <% if editable? %>
          <%= link_to edit_submission_path(submission),
                      class: "btn btn-sm btn-primary" do %>
            <i class="fas fa-upload me-1" aria-hidden="true"></i>
            <%= handed_in? ? t("submission.hub.card.replace") : t("submission.hub.card.hand_in") %>
          <% end %>
        <% end %>
        <span class="small">
          <% if invitable? %>
            <%= link_to t("submission.hub.card.invite"),
                        enter_submission_invitees_path(submission) %>
            <% if editable? %>&middot;<% end %>
          <% end %>
          <% if editable? %>
            <% if alone? %>
              <%= link_to t("submission.hub.card.delete"), submission_path(submission),
                          data: { turbo_method: :delete,
                                  turbo_confirm: t("confirmation.generic") } %>
            <% else %>
              <%= link_to t("submission.hub.card.leave"), leave_submission_path(submission),
                          data: { turbo_method: :delete,
                                  turbo_confirm: t("confirmation.generic") } %>
            <% end %>
          <% end %>
        </span>
      <% elsif may_start? %>
        <%= link_to new_submission_path(assignment_id: assignment.id),
                    class: "btn btn-sm btn-primary" do %>
          <i class="fas fa-upload me-1" aria-hidden="true"></i>
          <%= t("submission.hub.card.hand_in") %>
        <% end %>
        <span class="small">
          <%= link_to t("submission.hub.card.join"),
                      enter_submission_code_path(assignment_id: assignment.id) %>
        </span>
      <% end %>
    </div>

    <p class="small mb-0">
      <% if partner_names.any? %>
        <%= t("submission.hub.card.team_html",
              names: tag.strong(partner_names.to_sentence)) %>
      <% elsif submission.nil? && may_start? %>
        <%= t("submission.hub.card.team_hint") %>
      <% end %>
      <% if token %>
        <%= t("submission.hub.card.code") %>
        <code><%= token %></code>
        <%= link_to refresh_submission_token_path(submission),
                    class: "ms-1 text-secondary",
                    title: t("buttons.refresh_token"),
                    data: { turbo_method: :patch } do %>
          <i class="fas fa-sync-alt" aria-hidden="true"></i>
          <span class="visually-hidden"><%= t("buttons.refresh_token") %></span>
        <% end %>
      <% end %>
    </p>

    <% unless may_start? %>
      <p class="small text-muted mb-0"><%= t("submission.tutorial_needed") %></p>
    <% end %>

    <% if tutorial_name || invited_names.any? %>
      <p class="small text-muted mb-0 mt-2">
        <% if tutorial_name %><%= tutorial_name %><% end %>
        <% if invited_names.any? %>
          <%= t("submission.hub.card.invited", names: invited_names.to_sentence) %>
        <% end %>
      </p>
    <% end %>
  </section>
<% end %>
