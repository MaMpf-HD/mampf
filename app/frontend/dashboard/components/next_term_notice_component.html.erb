<p class="next-term-notice" data-testid="next-term-notice">
  <i class="fas fa-seedling" aria-hidden="true"></i>
  <span>
    <%= t("dashboard.next_term_notice.text", count: lecture_count,
                                             term: next_term.to_label_short) %>
  </span>
  <%= link_to target_path, class: "next-term-notice__link",
                           data: { testid: "next-term-notice-link" } do %>
    <%= t("dashboard.next_term_notice.link") %>
    <i class="fas fa-chevron-down" aria-hidden="true"></i>
  <% end %>
</p>
