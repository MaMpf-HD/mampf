<%= render(DashboardCardComponent.new(
      href: lecture_path(lecture),
      image_url: image_url,
      title: lecture.title_no_term,
      tape: WashiTapeComponent.new(
              tape: tape,
              label: lecture.title_no_term,
              update_url: dashboard_washi_tape_path(lecture)),
      data: { lecture_id: lecture.id,
              testid: "lecture-dashboard-card" })) do |card| %>

  <% if show_teacher? %>
    <% card.with_subtitle { lecture.teacher.name } %>
  <% end %>

  <% if registration_status %>
    <% card.with_note do %>
      <i class="bi <%= registration_status_icon %>" aria-hidden="true"></i>
      <%= registration_status_label %>
    <% end %>
  <% end %>

  <% card.with_progress do %>
    <%= render(DashboardPointsProgressComponent.new(lecture: lecture,
                                                    user: user)) %>
  <% end %>

  <% card.with_rail do %>
    <%= render(LectureQuickActionsComponent.new(lecture: lecture,
                                                user: user,
                                                activity: activity)) %>
  <% end %>
<% end %>
