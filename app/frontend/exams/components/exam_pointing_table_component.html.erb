<%= helpers.turbo_frame_tag "pointing-table" do %>
  <% if rows.any? %>
    <div
      data-controller="pointing-table status-filter"
      data-status-filter-page-size-value="20"
      data-action="status-filter:page-size@window->status-filter#adoptPageSize"
    >
      <div class="my-3">
        <%# The pager shares the summary's line: both say how many rows there are. %>
        <div
          class="
            d-flex flex-wrap justify-content-between align-items-baseline
            gap-2
          "
        >
          <%= render summary %>

          <%= render partial: "assessment/participations/pager",
                     locals: { id: "exam-points-#{@exam.id}", with_size: true } %>
        </div>

        <%= render PointingFilterComponent.new(id: "exam-points-#{@exam.id}",
                                               status_options: status_options,
                                               tutorial_options: tutorial_options) %>
      </div>

      <div
        class="table-wrapper"
        style="<%= layout.css_vars %>"
        data-controller="table-fade"
      >
        <div class="table-overflow" data-table-fade-target="inner">
          <table class="table align-middle my-3">
            <thead>
              <%= render(PointingTableHeaderComponent.new(assessable: @exam, layout: layout)) %>
            </thead>

            <tbody>
              <% rows.each do |participation| %>
                <%= render row_for(participation) %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-muted my-3" hidden data-status-filter-target="empty">
        <%= t("assessment.grading_tutorial.filter_no_match") %>
      </p>

      <div class="d-flex justify-content-end my-3">
        <%= render partial: "assessment/participations/pager",
                   locals: { id: "exam-points-#{@exam.id}", with_size: false } %>
      </div>
    </div>
  <% else %>
    <p class="text-muted my-3">
      <%= t("assessment.grading_exam.no_candidates") %>
    </p>
  <% end %>
<% end %>
