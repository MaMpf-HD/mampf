<% edit_frame = "rule-editor-frame" %>
<% submit_frame = @source_frame.presence || edit_frame %>

<% cancel_path = lecture_student_performance_certifications_path(@lecture) %>

<%= turbo_frame_tag edit_frame do %>
  <div class="border rounded mt-3 mb-4 p-3">
    <% if @rule.errors.where(:base).any? %>
      <div class="alert alert-danger mb-3">
        <ul class="mb-0">
          <% @rule.errors.where(:base).each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with(
          url: lecture_student_performance_rules_path(@lecture),
          method: :patch,
          data: submit_frame != edit_frame ? { turbo_frame: submit_frame } : {}
        ) do |f| %>
      <%= hidden_field_tag :source_frame, submit_frame %>

      <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="fw-semibold">
          <i class="bi bi-pencil me-1"></i>
          <%= t("student_performance.rules.edit.title") %>
        </span>

        <div class="d-flex gap-2">
          <button
            type="submit"
            formaction="<%= preview_lecture_student_performance_rules_path(
                            @lecture
                          ) %>"
            data-turbo-frame="rule-preview-frame"
            class="btn btn-outline-primary btn-sm"
          >
            <i class="bi bi-eye me-1"></i>
            <%= t("student_performance.rules.preview.button") %>
          </button>

          <button type="submit" class="btn btn-primary btn-sm">
            <i class="bi bi-check-lg me-1"></i>
            <%= t("student_performance.rules.edit.save") %>
          </button>

          <%= link_to cancel_path,
                     class: "btn btn-outline-secondary btn-sm",
                     data: { turbo_frame: edit_frame } do %>
            <%= t("student_performance.rules.edit.cancel") %>
          <% end %>
        </div>
      </div>

      <% threshold_mode = @threshold_mode ||
                          (@rule.persisted? ? @rule.threshold_mode : "percentage") %>

      <div class="row g-3">
        <div
          class="<%= @achievements.any? ? 'col-lg-6' : 'col-12' %>"
          data-controller="threshold-mode"
        >
          <div class="fw-semibold small mb-2">
            <%= t("student_performance.rules.edit.threshold_section") %>

            <% if @lecture.tests_kept_apart? %>
              <span class="fw-normal text-muted">
                (<%= t("student_performance.rules.show.without_tests") %>)
              </span>
            <% end %>
          </div>

          <div class="mb-2">
            <div class="form-check form-check-inline">
              <input
                type="radio"
                name="rule[threshold_mode]"
                value="percentage"
                id="threshold-percentage"
                class="form-check-input"
                data-action="threshold-mode#toggle"
                <% if threshold_mode == "percentage" %>
                  checked
                <% end %>
              >

              <label class="form-check-label small" for="threshold-percentage">
                <%= t("student_performance.rules.edit.percentage_mode") %>
              </label>
            </div>

            <div class="form-check form-check-inline">
              <input
                type="radio"
                name="rule[threshold_mode]"
                value="absolute"
                id="threshold-absolute"
                class="form-check-input"
                data-action="threshold-mode#toggle"
                <% if threshold_mode == "absolute" %>
                  checked
                <% end %>
              >

              <label class="form-check-label small" for="threshold-absolute">
                <%= t("student_performance.rules.edit.absolute_mode") %>
              </label>
            </div>

            <div class="form-check form-check-inline">
              <input
                type="radio"
                name="rule[threshold_mode]"
                value="none"
                id="threshold-none"
                class="form-check-input"
                data-action="threshold-mode#toggle"
                <% if threshold_mode == "none" %>
                  checked
                <% end %>
              >

              <label class="form-check-label small" for="threshold-none">
                <%= t("student_performance.rules.edit.none_mode") %>
              </label>
            </div>
          </div>

          <p
            class="small text-muted mb-0"
            data-threshold-mode-target="noneHint"
          >
            <%= t("student_performance.rules.edit.none_hint") %>
          </p>

          <div data-threshold-mode-target="percentageInput">
            <div class="input-group input-group-sm" style="max-width: 160px">
              <input
                type="number"
                name="rule[min_percentage]"
                aria-label="<%= t("student_performance.rules.edit.percentage_field") %>"
                value="<%= @rule.min_percentage %>"
                class="form-control<% if @rule.errors[:min_percentage].any? %> is-invalid <% end %>"
                min="0"
                max="100"
                step="0.1"
                autocomplete="off"
              >

              <span class="input-group-text">%</span>
            </div>

            <% if @rule.errors[:min_percentage].any? %>
              <div class="text-danger small mt-1">
                <%= @rule.errors.full_messages_for(:min_percentage).first %>
              </div>
            <% end %>
          </div>

          <div data-threshold-mode-target="absoluteInput">
            <div class="input-group input-group-sm" style="max-width: 160px">
              <input
                type="number"
                name="rule[min_points_absolute]"
                aria-label="<%= t("student_performance.rules.edit.absolute_field") %>"
                value="<%= @rule.min_points_absolute %>"
                class="form-control<% if @rule.errors[:min_points_absolute].any? %> is-invalid <% end %>"
                min="0"
                step="0.5"
                autocomplete="off"
              >

              <span class="input-group-text">
                <%= t("student_performance.rules.edit.points_unit") %>
              </span>
            </div>

            <% if @rule.errors[:min_points_absolute].any? %>
              <div class="text-danger small mt-1">
                <%= @rule.errors.full_messages_for(:min_points_absolute).first %>
              </div>
            <% end %>
          </div>
        </div>

        <% if @achievements.any? %>
          <div class="col-lg-6">
            <div class="fw-semibold small mb-2">
              <%= t("student_performance.rules.edit.achievements_section") %>
            </div>

            <% @achievements.each do |achievement| %>
              <div class="form-check mb-1">
                <input
                  type="checkbox"
                  name="rule[achievement_ids][]"
                  value="<%= achievement.id %>"
                  id="achievement-<%= achievement.id %>"
                  class="form-check-input"
                  <% if @selected_achievement_ids.include?(achievement.id) %>
                    checked
                  <% end %>
                >

                <label
                  class="form-check-label small"
                  for="achievement-<%= achievement.id %>"
                >
                  <%= achievement.title %>

                  <% case achievement.value_type %>
                  <% when "boolean" %>
                    <span class="badge bg-secondary">
                      <%= t("student_performance.rules.show.value_types.boolean") %>
                    </span>
                  <% when "numeric" %>
                    <span class="badge bg-secondary">
                      <%= t("student_performance.rules.show.value_types.numeric",
                            threshold: achievement.threshold) %>
                    </span>
                  <% when "percentage" %>
                    <span class="badge bg-secondary">
                      <%= t("student_performance.rules.show.value_types.percentage",
                            threshold: achievement.threshold) %>
                    </span>
                  <% end %>
                </label>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @tests_count.positive? || @rule.min_tests_passed.present? %>
          <div
            class="col-12"
            data-controller="tests-criterion"
            data-tests-criterion-judged-value="<%= @judged_tests_count %>"
          >
            <div class="fw-semibold small mb-2">
              <%= t("student_performance.rules.edit.tests_section") %>
            </div>

            <div class="input-group input-group-sm" style="max-width: 420px">
              <label class="input-group-text" for="rule-min-tests-passed">
                <%= t("student_performance.rules.edit.tests_at_least") %>
              </label>

              <input
                type="number"
                name="rule[min_tests_passed]"
                id="rule-min-tests-passed"
                value="<%= @rule.min_tests_passed %>"
                class="form-control<% if @rule.errors[:min_tests_passed].any? %> is-invalid <% end %>"
                min="0"
                step="1"
                autocomplete="off"
                data-tests-criterion-target="input"
                data-action="input->tests-criterion#check"
              >

              <span class="input-group-text">
                <%= t("student_performance.rules.edit.tests_of",
                      count: @judged_tests_count) %>
              </span>
            </div>

            <% if @rule.errors[:min_tests_passed].any? %>
              <div class="text-danger small mt-1">
                <%= @rule.errors.full_messages_for(:min_tests_passed).first %>
              </div>
            <% end %>

            <p class="small text-muted mb-0 mt-1">
              <%= t("student_performance.rules.edit.tests_hint") %>

              <% if @tests_count > @judged_tests_count %>
                <%= t("student_performance.rules.edit.tests_without_threshold",
                      count: @tests_count - @judged_tests_count) %>
              <% end %>
            </p>

            <%= tag.p(class: "small text-warning-emphasis mb-0 mt-1",
                      hidden: !@rule.more_tests_than?(@judged_tests_count),
                      data: { tests_criterion_target: "warning" }) do %>
              <i
                class="bi bi-exclamation-triangle-fill me-1"
                aria-hidden="true"
              ></i>

              <%= t("student_performance.rules.show.more_tests_than",
                    count: @judged_tests_count) %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%= turbo_frame_tag "rule-preview-frame" %>
    <% end %>

    <% if @rule.persisted? && @rule.active_in_database %>
      <div class="border-top mt-3 pt-3 text-end">
        <% if @eligibility_in_use_by %>
          <button
            type="button"
            class="btn btn-outline-danger btn-sm"
            aria-describedby="rule-remove-blocked-note"
            disabled
          >
            <%= t("student_performance.rules.edit.remove") %>
          </button>
          <p id="rule-remove-blocked-note" class="small text-muted mt-1 mb-0">
            <%= t("student_performance.eligibility_in_use", campaigns: @eligibility_in_use_by) %>
          </p>
        <% else %>
          <%= button_to t("student_performance.rules.edit.remove"),
                      lecture_student_performance_rules_path(@lecture),
                      method: :delete,
                      params: { source_frame: submit_frame },
                      class: "btn btn-outline-danger btn-sm",
                      form: {
                        data: {
                          turbo_frame: submit_frame,
                          turbo_confirm: t("student_performance.rules.edit.remove_confirm",
                                           count: @computed_count)
                        }
                      } %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
