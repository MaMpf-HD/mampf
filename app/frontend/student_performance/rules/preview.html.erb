<%= turbo_frame_tag "rule-preview-frame" do %>
  <% unless @rule %>
    <div class="alert alert-secondary small py-2 mt-2 mb-0">
      <i class="bi bi-info-circle me-1"></i>
      <%= t("student_performance.rules.preview.no_rule") %>
    </div>
  <% else %>
    <% if @changes.empty? && @manual_conflicts.empty? %>
      <div class="alert alert-secondary small py-2 mt-2 mb-0">
        <i class="bi bi-check-circle me-1"></i>
        <%= t("student_performance.rules.preview.no_changes") %>
      </div>
    <% else %>
      <% if @changes.any? %>
        <div class="d-flex gap-3 align-items-center mt-2">
          <span class="small text-muted">
            <i class="bi bi-eye me-1"></i>
            <%= t("student_performance.rules.preview.impact") %>:
          </span>

          <span class="badge bg-light text-dark border">
            <%= @changes.size %>
            <%= t("student_performance.rules.preview.affected") %>
          </span>

          <% if @newly_passed > 0 %>
            <span class="badge bg-success-subtle text-success border-0">
              <i class="bi bi-arrow-up"></i>
              <%= @newly_passed %>
              <%= t("student_performance.rules.preview.newly_passed") %>
            </span>
          <% end %>

          <% if @newly_failed > 0 %>
            <span class="badge bg-danger-subtle text-danger border-0">
              <i class="bi bi-arrow-down"></i>
              <%= @newly_failed %>
              <%= t("student_performance.rules.preview.newly_failed") %>
            </span>
          <% end %>

          <% if @newly_inconclusive > 0 %>
            <span class="badge bg-amber-subtle text-amber border-0">
              <i class="bi bi-question-circle"></i>
              <%= @newly_inconclusive %>
              <%= t("student_performance.rules.preview.newly_inconclusive") %>
            </span>
          <% end %>
        </div>
        <div class="table-responsive mt-3">
          <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th scope="col">
                  <%= t("student_performance.records.columns.student") %>
                </th>

                <th scope="col" class="text-end">
                  <% if @rule.min_points_absolute.present? %>
                    <%= t("student_performance.records.columns.points") %>
                  <% else %>
                    <%= t("student_performance.records.columns.percentage") %>
                  <% end %>
                </th>

                <th scope="col" class="ps-4">
                  <%= t("student_performance.rules.preview.current_status") %>
                </th>

                <th scope="col">
                  <%= t("student_performance.rules.preview.new_status") %>
                </th>
              </tr>
            </thead>

            <tbody>
              <% @changes.each do |change| %>
                <tr>
                  <td><%= change.record.user.tutorial_name %></td>

                  <td class="text-end font-monospace">
                    <% if @rule.min_points_absolute.present? %>
                      <%= number_with_precision(
                          change.record.points_total_materialized,
                          precision: 1,
                          strip_insignificant_zeros: true) %>
                    <% else %>
                      <%= number_to_percentage(
                          change.record.percentage_materialized.to_f,
                          precision: 1) %>
                    <% end %>
                  </td>

                  <td class="ps-4">
                    <% if change.from == :passed %>
                      <i class="bi bi-check-circle-fill text-success me-1"></i>
                      <%= t("student_performance.evaluator.status.passed") %>
                    <% elsif change.from == :inconclusive %>
                      <i class="bi bi-question-circle-fill text-amber me-1"></i>
                      <%= t("student_performance.evaluator.status.inconclusive") %>
                    <% else %>
                      <i class="bi bi-x-circle-fill text-danger me-1"></i>
                      <%= t("student_performance.evaluator.status.failed") %>
                    <% end %>
                  </td>

                  <td>
                    <% if change.to == :passed %>
                      <i class="bi bi-check-circle-fill text-success me-1"></i>
                      <%= t("student_performance.evaluator.status.passed") %>
                    <% elsif change.to == :inconclusive %>
                      <i class="bi bi-question-circle-fill text-amber me-1"></i>
                      <%= t("student_performance.evaluator.status.inconclusive") %>
                    <% else %>
                      <i class="bi bi-x-circle-fill text-danger me-1"></i>
                      <%= t("student_performance.evaluator.status.failed") %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <p class="text-muted small mt-2 mb-0">
          <i class="bi bi-info-circle me-1"></i>
          <%= t("student_performance.rules.preview.deferred_hint") %>
        </p>
      <% end %>
      <% if @manual_conflicts.any? %>
        <p class="text-muted small mt-2 mb-0">
          <i class="bi bi-pencil-square me-1"></i>

          <%= t("student_performance.rules.preview.manual_conflicts",
                count: @manual_conflicts.size) %>

          <%= @manual_conflicts.map { |change| change.record.user.tutorial_name }
                               .to_sentence %>
        </p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
