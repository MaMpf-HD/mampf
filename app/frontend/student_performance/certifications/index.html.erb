<%= vite_stylesheet_tag "student_performance/certifications/certifications_table.scss" %>

<%= turbo_frame_tag "performance-certifications-frame" do %>
  <div class="d-flex justify-content-between align-items-end pb-2 mb-2 mt-2">
    <p class="text-muted small mb-0">
      <%= t("student_performance.certifications.index.subtitle") %>
    </p>

    <div class="d-flex gap-2">
      <% if @rule && @uncertified_count > 0 && !@lecture.assignments_complete? %>
        <button
          type="button"
          class="btn btn-sm btn-success"
          disabled
          title="<%= t("student_performance.certifications.index.assignments_incomplete",
                       tab: t("assessment.tabs.assignments")) %>"
        >
          <i class="bi bi-check-all me-1"></i>
          <%= t("student_performance.certifications.index.bulk_accept") %>
        </button>
      <% elsif @rule && @uncertified_count > 0 &&
               (@proposed_passed + @proposed_failed) > 0 %>
        <%= button_to bulk_accept_lecture_student_performance_certifications_path(@lecture),
                    method: :post,
                    class: "btn btn-sm btn-success",
                    title: t("student_performance.certifications.index.bulk_accept_hint") do %>
          <i class="bi bi-check-all me-1"></i>
          <%= t("student_performance.certifications.index.bulk_accept") %>

          <%#
            joined in Ruby: a comma of its own in the markup renders with a
            space in front of it
          %>
          <% scope = "student_performance.certifications.index" %>

          <% forecast = [
               "#{@proposed_passed} #{t("#{scope}.proposed_passed")}",
               "#{@proposed_failed} #{t("#{scope}.proposed_failed")}"
             ] %>

          <% if @proposed_inconclusive.positive? %>
            <% forecast << "#{@proposed_inconclusive} " \
                           "#{t("#{scope}.proposed_inconclusive")}" %>
          <% end %>

          <span class="ms-1">(<%= forecast.join(", ") %>)</span>
        <% end %>
      <% end %>

      <% if @computed_count > 0 %>
        <%= button_to bulk_reset_lecture_student_performance_certifications_path(@lecture),
                    method: :post,
                    class: "btn btn-sm btn-outline-secondary",
                    form: {
                      data: {
                        turbo_confirm: t(
                          "student_performance.certifications.index.bulk_reset_confirm",
                          count: @computed_count
                        )
                      }
                    } do %>
          <i class="bi bi-arrow-counterclockwise me-1"></i>

          <%= t("student_performance.certifications.index.bulk_reset",
                count: @computed_count) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "rule-editor-frame" do %>
    <%# a frame swap discards the layout, so the confirmation has to travel inside it %>
    <%= render partial: "flash/message" if turbo_frame_request? %>

    <% if @rule %>
      <div class="bg-light rounded border mt-3 mb-4 py-2 px-3">
        <div class="d-flex justify-content-between align-items-center">
          <div class="mb-0">
            <span class="text-muted small border-end pe-2 me-2">
              <%= t("student_performance.certifications.index.rule_info") %>
            </span>

            <% if @rule.min_percentage.present? %>
              <strong>
                <%= number_to_percentage(@rule.min_percentage, precision: 0) %>
              </strong>
              <span class="small text-muted">
                <%= t("student_performance.rules.show.of_total_points") %>
              </span>
            <% elsif @rule.min_points_absolute.present? %>
              <strong><%= @rule.min_points_absolute %></strong>
              <span class="small text-muted">
                <%= t("student_performance.rules.show.points_absolute") %>
              </span>
            <% end %>

            <% if @rule.required_achievements.any? %>
              <% if @rule.min_percentage.present? || @rule.min_points_absolute.present? %>
                <span class="text-muted small mx-1">
                  <i class="bi bi-plus"></i>
                </span>
              <% end %>
              <span class="small text-muted me-1">
                <%= t("student_performance.certifications.index.required_achievements_label") %>:
              </span>
              <% @rule.required_achievements.each do |ach| %>
                <strong>
                  <%= ach.title %>

                  <% case ach.value_type %>
                  <% when "numeric" %>
                    (&ge;
                    <%= ach.threshold %>
                    )
                  <% when "percentage" %>
                    (&ge;
                    <%= ach.threshold %>
                    %)
                  <% end %>
                </strong>

                <% unless ach == @rule.required_achievements.last %>
                  <span class="text-muted">,</span>
                <% end %>
              <% end %>
            <% end %>
          </div>

          <div class="d-flex gap-2 ms-3">
            <%= link_to edit_lecture_student_performance_rules_path(
                         @lecture,
                         source_frame: "performance-certifications-frame"
                       ),
                       class: "btn btn-outline-primary btn-sm text-nowrap",
                       data: { turbo_frame: "rule-editor-frame" } do %>
              <i class="bi bi-pencil me-1"></i>
              <%= t("student_performance.rules.show.edit_button") %>
            <% end %>
          </div>
        </div>

        <% unless @lecture.assignments_complete? %>
          <div class="small text-muted border-top mt-2 pt-2">
            <i class="bi bi-info-circle me-1"></i>
            <%= t("student_performance.certifications.index.list_open") %>

            <%= helpdesk(t("student_performance.certifications.index.assignments_incomplete",
                           tab: t("assessment.tabs.assignments")), false) %>

            <%= link_to t("student_performance.certifications.index.list_open_link",
                          tab: t("assessment.tabs.assignments")),
                        assessment_assessments_path(lecture_id: @lecture.id,
                                                    tab: "assignments"),
                        class: "ms-2",
                        data: { turbo_frame: "_top" } %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-3 mt-3 mb-4 border rounded bg-light">
        <i class="bi bi-info-circle text-secondary fs-4 d-block mb-2"></i>

        <p class="text-muted mb-1">
          <%= t("student_performance.evaluator.no_rule") %>
        </p>

        <p class="text-muted small mb-2">
          <%= t("student_performance.certifications.index.no_rule_hint") %>
        </p>

        <%= link_to edit_lecture_student_performance_rules_path(
                     @lecture,
                     source_frame: "performance-certifications-frame"
                   ),
                   class: "btn btn-outline-primary btn-sm",
                   data: { turbo_frame: "rule-editor-frame" } do %>
          <i class="bi bi-plus-lg me-1"></i>
          <%= t("student_performance.certifications.index.setup_rule") %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @total_students > 0 %>
    <div class="progress mb-3" style="height: 6px;">
      <div
        class="progress-bar bg-success"
        role="progressbar"
        style="width: <%= (@passed_count.to_f / @total_students * 100) %>%;"
        aria-label="<%= t("student_performance.certifications.index.passed") %>"
      ></div>

      <div
        class="progress-bar bg-danger"
        role="progressbar"
        style="width: <%= (@failed_count.to_f / @total_students * 100) %>%;"
        aria-label="<%= t("student_performance.certifications.index.failed") %>"
      ></div>

      <div
        class="progress-bar bg-amber"
        role="progressbar"
        style="width: <%= (@uncertified_count.to_f / @total_students * 100) %>%;"
        aria-label="<%= t("student_performance.certifications.index.uncertified") %>"
      ></div>
    </div>
  <% end %>

  <div class="d-flex flex-wrap gap-5 mb-4">
    <div class="d-flex flex-column">
      <span class="fs-5 fw-bold text-dark lh-1 mb-1">
        <%= @total_students %>
      </span>

      <span class="text-muted small">
        <%= t("student_performance.certifications.index.total") %>
      </span>
    </div>

    <div class="d-flex flex-column">
      <span class="fs-5 fw-bold text-success lh-1 mb-1">
        <%= @passed_count %>
      </span>

      <span class="text-muted small">
        <%= t("student_performance.certifications.index.passed") %>
      </span>
    </div>

    <div class="d-flex flex-column">
      <span class="fs-5 fw-bold text-danger lh-1 mb-1">
        <%= @failed_count %>
      </span>

      <span class="text-muted small">
        <%= t("student_performance.certifications.index.failed") %>
      </span>
    </div>

    <div class="d-flex flex-column">
      <span class="fs-5 fw-bold text-amber lh-1 mb-1">
        <%= @uncertified_count %>
      </span>

      <span class="text-muted small">
        <%= t("student_performance.certifications.index.uncertified") %>
      </span>
    </div>
  </div>

  <% if @flagged_user_ids.any? %>
    <div class="alert alert-warning py-2 mb-4">
      <div class="small fw-semibold text-uppercase mb-1">
        <%= t("student_performance.certifications.index.todo_title") %>
      </div>

      <% if @disagreeing_user_ids.any? %>
        <div class="d-flex align-items-center justify-content-between py-1">
          <div>
            <i class="bi bi-arrow-left-right me-2"></i>

            <%= t("student_performance.certifications.index.disagreeing_warning",
                  count: @disagreeing_user_ids.size) %>
          </div>

          <%= button_to bulk_reevaluate_lecture_student_performance_certifications_path(@lecture),
                        method: :post,
                        class: "btn btn-warning btn-sm ms-3 text-nowrap" do %>
            <i class="bi bi-arrow-repeat me-1"></i>
            <%= t("student_performance.certifications.index.reevaluate") %>
          <% end %>
        </div>
      <% end %>

      <% if @stale_manual_user_ids.any? %>
        <div class="d-flex align-items-center justify-content-between py-1">
          <div>
            <i class="bi bi-pencil-square me-2"></i>

            <%= t("student_performance.certifications.index.stale_manual_warning",
                  count: @stale_manual_user_ids.size) %>
          </div>

          <%= button_to bulk_confirm_manual_lecture_student_performance_certifications_path(@lecture),
                        method: :post,
                        class: "btn btn-warning btn-sm ms-3 text-nowrap" do %>
            <i class="bi bi-check-all me-1"></i>
            <%= t("student_performance.certifications.index.confirm_manual") %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div
    class="
      d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3
    "
  >
    <nav class="nav nav-pills small">
      <% %i[all passed failed uncertified flagged].each do |filter| %>
        <% active = (params[:status].presence || "all") == filter.to_s %>

        <%#
          The search travels with the pill: a name typed in and then narrowed
          to "flagged" is still the name staff are looking for.
        %>
        <%= link_to lecture_student_performance_certifications_path(
                      @lecture,
                      status: filter == :all ? nil : filter,
                      q: params[:q].presence),
                   class: "nav-link rounded-pill py-1 px-3 #{'active' if active} #{'text-muted' unless active}",
                   data: { turbo_frame: "performance-certifications-frame" } do %>
          <%= t("student_performance.certifications.filters.#{filter}") %>
        <% end %>
      <% end %>
    </nav>

    <div data-controller="auto-submit-form">
      <%= form_tag lecture_student_performance_certifications_path(@lecture),
                   method: :get, class: "m-0",
                   data: { auto_submit_form_target: "form",
                           turbo_frame: "performance-certifications-frame" } do %>
        <%= hidden_field_tag :status, params[:status] if params[:status].present? %>

        <div class="position-relative">
          <span
            class="
              position-absolute top-50 start-0 translate-middle-y ps-3 pe-none
              text-muted
            "
          >
            <i class="bi bi-search"></i>
          </span>

          <%= text_field_tag :q, params[:q],
                             placeholder: t("student_performance.lists.search"),
                             "aria-label": t("student_performance.lists.search"),
                             autocomplete: "off",
                             class: "form-control form-control-sm ps-5 pe-5",
                             data: {
                               action: "input->auto-submit-form#debouncedSubmit",
                               auto_submit_form_target: "searchInput"
                             } %>

          <button
            type="button"
            class="btn-close position-absolute top-50 end-0 translate-middle-y me-3 <%= "d-none" if params[:q].blank? %>"
            data-auto-submit-form-target="clearButton"
            data-action="mousedown->auto-submit-form#keepFocus click->auto-submit-form#clear"
            aria-label="<%= t("basics.clear") %>"
          ></button>
        </div>
      <% end %>
    </div>
  </div>

  <% if @filtered_records.empty? %>
    <p class="text-center text-muted py-4">
      <% if params[:q].present? %>
        <%= t("student_performance.lists.no_match") %>
      <% else %>
        <%= t("student_performance.certifications.index.empty") %>
      <% end %>
    </p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle certifications-table">
        <thead class="table-light">
          <tr>
            <th scope="col">
              <%= t("student_performance.records.columns.student") %>
            </th>

            <th scope="col" class="text-end">
              <% if @rule&.min_points_absolute.present? %>
                <%= t("student_performance.records.columns.points") %>
              <% else %>
                <%= t("student_performance.records.columns.percentage") %>
                <br>
                <span class="fw-normal text-muted" style="font-size: 0.75em">
                  <%= t("student_performance.records.columns.of_due_points") %>
                </span>
              <% end %>
            </th>

            <% @achievements.each do |achievement| %>
              <th
                scope="col"
                class="text-center small"
                title="<%= achievement.title %>"
              >
                <%= truncate(achievement.title, length: 12) %>
              </th>
            <% end %>

            <th
              scope="col"
              class="text-start <%= 'ps-4' if @achievements.empty? %>"
            >
              <%= t("student_performance.certifications.columns.certification") %>
            </th>

            <th scope="col" class="hint-column">
              <%= t("student_performance.certifications.columns.hint") %>
            </th>

            <th scope="col">
              <%= t("student_performance.certifications.columns.note") %>
            </th>

            <th scope="col" class="text-end"></th>
          </tr>
        </thead>

        <tbody>
          <% @filtered_records.each do |record| %>
            <% cert = @cert_by_user[record.user_id] %>

            <%#
              A `pending` row carries no decision, so it is rendered like
              a row that has none: proposal, reasons, the two buttons.
            %>
            <% decided = cert.present? && !cert.pending? %>
            <% proposal = @proposal_by_user&.dig(record.user_id) %>

            <tr
              <% if decided %>
                data-controller="certification-inline"
              <% end %>
            >
              <td><%= record.user.tutorial_name %></td>

              <td class="text-end numeric">
                <% if @rule&.min_points_absolute.present? %>
                  <%= number_with_precision(
                            record.points_total_materialized,
                            precision: 1,
                            strip_insignificant_zeros: true) %>
                <% else %>
                  <% percentage = @due_points.marked_percentage_for(record) %>
                  <% if percentage.nil? %>
                    <span class="text-muted" aria-hidden="true">&mdash;</span>
                    <span class="visually-hidden">
                      <%= t("student_performance.records.percentage_unavailable") %>
                    </span>
                  <% else %>
                    <%= number_to_percentage(percentage, precision: 1) %>
                  <% end %>
                <% end %>
              </td>

              <% @achievements.each do |achievement| %>
                <td class="text-center">
                  <% if record.achievements_met_ids&.include?(achievement.id) %>
                    <i
                      class="bi bi-check-circle text-success"
                      title="<%= t('student_performance.records.columns.achievement_met') %>"
                    ></i>
                  <% elsif record.achievements_ungraded_ids&.include?(achievement.id) %>
                    <i
                      class="bi bi-question-circle text-amber"
                      title="<%= t('student_performance.records.columns.achievement_ungraded') %>"
                    ></i>
                  <% else %>
                    <i
                      class="bi bi-x-circle text-danger"
                      title="<%= t('student_performance.records.columns.achievement_not_met') %>"
                    ></i>
                  <% end %>
                </td>
              <% end %>

              <td class="text-start <%= 'ps-4' if @achievements.empty? %>">
                <% if decided %>
                  <div data-certification-inline-target="display">
                    <% label = cert.manual? ? "manual_#{cert.status}" : cert.status %>

                    <div class="d-flex align-items-center">
                      <% case cert.status.to_sym %>
                      <% when :passed %>
                        <span class="text-dark">
                          <i class="bi bi-check-circle-fill text-success me-1"></i>
                          <%= t("student_performance.certifications.status.#{label}") %>
                        </span>
                      <% when :failed %>
                        <span class="text-dark">
                          <i class="bi bi-x-circle-fill text-danger me-1"></i>
                          <%= t("student_performance.certifications.status.#{label}") %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                  <div data-certification-inline-target="edit" class="d-none">
                    <select
                      data-certification-inline-target="statusSelect"
                      class="form-select form-select-sm"
                    >
                      <option
                        value="passed"
                        <% if cert.passed? %>
                          selected
                        <% end %>
                      >
                        <%= t("student_performance.certifications.status.passed") %>
                      </option>

                      <option
                        value="failed"
                        <% if cert.failed? %>
                          selected
                        <% end %>
                      >
                        <%= t("student_performance.certifications.status.failed") %>
                      </option>
                    </select>
                  </div>
                <% elsif proposal %>
                  <div
                    class="
                      d-inline-flex align-items-center bg-light rounded-pill
                      px-2 py-1 border
                    "
                  >
                    <span class="small text-muted me-2">
                      <%= t("student_performance.certifications.columns.proposed") %>:
                    </span>

                    <span class="small fw-medium">
                      <% if proposal.proposed_status == :passed %>
                        <i class="bi bi-check-circle-fill text-success me-1"></i>
                        <%= t("student_performance.evaluator.status.passed") %>
                      <% elsif proposal.proposed_status == :inconclusive %>
                        <i class="bi bi-question-circle-fill text-amber me-1"></i>
                        <%= t("student_performance.evaluator.status.inconclusive") %>
                      <% else %>
                        <i class="bi bi-x-circle-fill text-danger me-1"></i>
                        <%= t("student_performance.evaluator.status.failed") %>
                      <% end %>
                    </span>
                  </div>
                <% else %>
                  <span class="text-muted">&mdash;</span>
                <% end %>
              </td>

              <td class="hint-column small">
                <% if @disagreeing_user_ids.include?(record.user_id) %>
                  <span class="text-amber">
                    <i class="bi bi-arrow-left-right me-1"></i>
                    <%= t("student_performance.certifications.columns.rule_today") %>
                    <%= t("student_performance.certifications.rule_today.#{proposal.proposed_status}") %>

                    <% reasons = proposal_reasons(proposal, @lecture) %>

                    <% if reasons.any? %>
                      &mdash;
                      <%= reasons.join(", ") %>
                    <% end %>
                  </span>
                <% elsif @stale_manual_user_ids.include?(record.user_id) %>
                  <span class="text-muted">
                    <%= t("student_performance.certifications.status.manual_stale") %>
                  </span>
                <% elsif proposal && !decided %>
                  <% Array(proposal.verdict_deferral_reasons).each do |reason| %>
                    <span class="text-amber d-block">
                      <i class="bi bi-question-circle me-1"></i>
                      <%= deferral_text(proposal, reason) %>
                    </span>
                  <% end %>
                  <% proposal.missed_criteria.each do |criterion| %>
                    <span class="text-danger d-block">
                      <i class="bi bi-x-circle me-1"></i>
                      <%= t("student_performance.evaluator.missed.#{criterion}") %>
                    </span>
                  <% end %>
                <% end %>
              </td>

              <td class="small" style="max-width: 180px">
                <% if decided %>
                  <div data-certification-inline-target="display">
                    <span
                      class="text-muted text-truncate d-inline-block"
                      style="max-width: 160px"
                      title="<%= cert.note %>"
                    >
                      <%= cert.note %>
                    </span>
                  </div>
                  <div data-certification-inline-target="edit" class="d-none">
                    <input
                      type="text"
                      data-certification-inline-target="noteInput"
                      data-action="keydown.enter->certification-inline#save"
                      class="form-control form-control-sm"
                      value="<%= cert.note %>"
                      placeholder="<%= t('student_performance.certifications.override.note_hint') %>"
                      autocomplete="off"
                    >
                  </div>
                <% end %>
              </td>

              <td class="text-end">
                <% if decided %>
                  <div data-certification-inline-target="display">
                    <button
                      type="button"
                      class="btn btn-link text-muted btn-sm p-0 text-decoration-none"
                      data-action="certification-inline#toggleEdit"
                      title="<%= t('student_performance.certifications.index.edit_certification') %>"
                    >
                      <i class="bi bi-pencil"></i>
                    </button>
                  </div>
                  <div data-certification-inline-target="edit" class="d-none">
                    <div class="d-flex gap-1 justify-content-end">
                      <button
                        type="button"
                        class="btn btn-sm btn-primary py-0 px-1"
                        data-action="certification-inline#save"
                        title="<%= t('student_performance.certifications.index.save') %>"
                      >
                        <i class="bi bi-check-lg"></i>
                      </button>

                      <button
                        type="button"
                        class="btn btn-sm btn-outline-secondary py-0 px-1"
                        data-action="certification-inline#cancel"
                        title="<%= t('student_performance.certifications.index.cancel') %>"
                      >
                        <i class="bi bi-x-lg"></i>
                      </button>

                      <%= button_to(
                            lecture_student_performance_certification_path(
                              @lecture, cert
                            ),
                            method: :delete,
                            class: "btn btn-sm btn-outline-secondary py-0 px-1",
                            title: t(
                              "student_performance.certifications.index.reset"
                            ),
                            aria: {
                              label: t(
                                "student_performance.certifications.index.reset"
                              )
                            },
                            form: {
                              data: {
                                turbo_frame: "performance-certifications-frame",
                                turbo_confirm: reset_confirmation(cert)
                              }
                            }
                          ) do %>
                        <i class="bi bi-arrow-counterclockwise"></i>
                      <% end %>
                    </div>

                    <%= form_with(
                          url: lecture_student_performance_certification_path(
                                 @lecture, cert
                               ),
                          method: :patch,
                          data: {
                            turbo_frame:
                              "performance-certifications-frame",
                            certification_inline_target: "form"
                          },
                          style: "display: none"
                        ) do %>
                      <input
                        type="hidden"
                        name="certification[status]"
                        data-certification-inline-target="statusHidden"
                      >

                      <input
                        type="hidden"
                        name="certification[note]"
                        data-certification-inline-target="noteHidden"
                      >
                    <% end %>
                  </div>
                <% else %>
                  <% pass_btn = proposal&.proposed_status == :passed ?
                      "btn-success" : "btn-outline-success"
                    fail_btn = proposal&.proposed_status == :failed ?
                      "btn-danger" : "btn-outline-danger" %>
                  <div class="d-flex gap-1 justify-content-end">
                    <%= button_to(
                          lecture_student_performance_certifications_path(
                            @lecture
                          ),
                          method: :post,
                          class: "btn btn-sm py-0 px-1 #{pass_btn}",
                          title: t(
                            "student_performance.certifications" \
                            ".index.certify_pass"
                          ),
                          params: {
                            certification: {
                              user_id: record.user_id,
                              status: :passed
                            }
                          }
                        ) do %>
                      <i class="bi bi-check-lg"></i>
                    <% end %>

                    <%= button_to(
                          lecture_student_performance_certifications_path(
                            @lecture
                          ),
                          method: :post,
                          class: "btn btn-sm py-0 px-1 #{fail_btn}",
                          title: t(
                            "student_performance.certifications" \
                            ".index.certify_fail"
                          ),
                          params: {
                            certification: {
                              user_id: record.user_id,
                              status: :failed
                            }
                          }
                        ) do %>
                      <i class="bi bi-x-lg"></i>
                    <% end %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted small">
          <%= t("student_performance.lists.showing",
                from: @pagy.from, to: @pagy.to, count: @pagy.count) %>
        </div>

        <nav><%== pagy_series_nav(@pagy) %></nav>
      </div>
    <% end %>
  <% end %>
<% end %>
