<%= turbo_frame_tag "performance-records-frame" do %>
  <%= render partial: "flash/message" if turbo_frame_request? %>

  <div class="mb-3">
    <%= link_to lecture_student_performance_records_path(@lecture),
              class: "text-decoration-none" do %>
      <i class="bi bi-arrow-left me-1"></i>
      <%= t("student_performance.records.show.back") %>
    <% end %>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-white border-bottom">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h4 class="mb-1"><%= @record.user.tutorial_name %></h4>
          <p class="text-muted small mb-0"><%= @record.user.email %></p>
        </div>

        <div class="d-flex gap-2">
          <%= link_to single_proposal_lecture_student_performance_evaluator_path(
                     @lecture, record_id: @record.id),
                   class: "btn btn-outline-primary btn-sm",
                   data: { turbo_frame: "performance-records-frame" } do %>
            <i class="bi bi-clipboard-check me-1"></i>
            <%= t("student_performance.records.show.review_proposal") %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card-body">
      <div class="row g-4 mb-4">
        <div class="col-12 col-md-4">
          <div class="text-center p-3 border rounded bg-light">
            <div class="display-6 fw-bold text-primary">
              <%= number_with_precision(@record.points_total_materialized,
                                      precision: 1,
                                      strip_insignificant_zeros: true) %>
            </div>

            <div class="text-muted small">
              <%= t("student_performance.records.show.total_points") %>
            </div>

            <div class="text-muted small mt-1">
              <%= t("student_performance.records.show.out_of",
                  max: number_with_precision(
                         @due_points.marked_max_for(@record.user_id),
                         precision: 1,
                         strip_insignificant_zeros: true)) %>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="text-center p-3 border rounded bg-light">
            <% percentage = @due_points.marked_percentage_for(@record) %>

            <div class="display-6 fw-bold">
              <% if percentage.nil? %>
                <span class="text-muted" aria-hidden="true">&mdash;</span>
                <span class="visually-hidden">
                  <%= t("student_performance.records.percentage_unavailable") %>
                </span>
              <% else %>
                <%= number_to_percentage(percentage, precision: 0) %>
              <% end %>
            </div>

            <div class="text-muted small">
              <%= t("student_performance.records.show.percentage") %>
            </div>

            <div class="text-muted small mt-1">
              <%= t("student_performance.records.columns.of_due_points") %>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-4">
          <div class="text-center p-3 border rounded bg-light">
            <div class="display-6 fw-bold">
              <%= @record.achievements_met_ids.size %>
            </div>

            <div class="text-muted small">
              <%= t("student_performance.records.show.achievements_met") %>
            </div>
          </div>
        </div>
      </div>

      <h5 class="mb-3">
        <%= t("student_performance.records.show.assessment_breakdown") %>
      </h5>

      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead class="table-light">
            <tr>
              <th scope="col">
                <%= t("student_performance.records.show.assignment") %>
              </th>

              <th scope="col">
                <%= t("student_performance.records.show.status") %>
              </th>

              <th scope="col" class="text-end">
                <%= t("student_performance.records.columns.points") %>
              </th>

              <th scope="col" class="text-end">
                <%= t("student_performance.records.show.max_points") %>
              </th>

              <th scope="col" class="text-center">
                <%= t("student_performance.records.show.files") %>
              </th>

              <th scope="col" class="text-end">
                <span class="visually-hidden">
                  <%= t("student_performance.records.show.excuse_column") %>
                </span>
              </th>
            </tr>
          </thead>

          <tbody>
            <% @assessments.each do |assessment| %>
              <% participation = @participation_by_assessment[assessment.id] %>
              <% status = participation&.display_status || :not_submitted %>
              <% status = :not_due if status == :not_submitted && !@due_points.due?(assessment.id) %>
              <% points = @points_by_assessment[assessment.id] %>
              <% max = assessment.effective_total_points %>

              <% submission = @submission_by_assignment[assessment.assessable_id] %>

              <tr>
                <td><%= assessment.title %></td>

                <td>
                  <%= render ParticipationStatusBadgeComponent.new(
                      status: status, variant: :full) %>
                </td>

                <td class="text-end font-monospace">
                  <% if points %>
                    <%= number_with_precision(points, precision: 1,
                                            strip_insignificant_zeros: true) %>
                  <% else %>
                    <span class="text-muted">&mdash;</span>
                  <% end %>
                </td>

                <td class="text-end font-monospace text-muted">
                  <%= number_with_precision(max, precision: 1,
                                          strip_insignificant_zeros: true) %>
                </td>

                <td class="text-center">
                  <% if submission&.manuscript %>
                    <%= link_to show_submission_manuscript_path(submission),
                                target: "_blank",
                                rel: "noopener",
                                class: "text-decoration-none",
                                title: t("student_performance.records.show.view_manuscript") do %>
                      <i class="bi bi-file-earmark-text"></i>
                    <% end %>
                  <% end %>

                  <% if submission&.correction %>
                    <%= link_to show_correction_path(submission),
                                target: "_blank",
                                rel: "noopener",
                                class: "text-decoration-none ms-2",
                                title: t("student_performance.records.show.view_correction") do %>
                      <i class="bi bi-file-earmark-check text-success"></i>
                    <% end %>
                  <% end %>

                  <% unless submission&.manuscript || submission&.correction %>
                    <span class="text-muted">&mdash;</span>
                  <% end %>
                </td>

                <%#
                  A certificate is decided per person, here, by whoever may edit
                  the lecture. Only a sheet nothing was handed in for can be
                  excused, and only once it is due: an excuse for a sheet still
                  open would be a forecast.
                  `local: true` keeps rails-ujs off the form; Turbo submits it.
                %>

                <td class="text-end">
                  <% if status == :not_submitted %>
                    <%= form_with url: excuse_lecture_student_performance_record_path(
                                         @lecture, @record),
                                  method: :patch, local: true,
                                  class: "d-inline-flex gap-1 justify-content-end" do |form| %>
                      <%= form.hidden_field :assessment_id, value: assessment.id, id: nil %>

                      <%= form.text_field :note, id: nil, class: "form-control form-control-sm",
                                                 placeholder: t("student_performance.records.show.note_placeholder"),
                                                 aria: { label: t("student_performance.records.show.note_label",
                                                                  sheet: assessment.title) } %>

                      <%= form.button t("student_performance.records.show.excuse"),
                                      class: "btn btn-outline-secondary btn-sm text-nowrap" %>
                    <% end %>
                  <% elsif status == :exempt %>
                    <div class="d-inline-flex align-items-center gap-2">
                      <% if participation.note.present? %>
                        <span class="text-muted small">
                          <%= participation.note %>
                        </span>
                      <% end %>

                      <%= button_to t("student_performance.records.show.unexcuse"),
                                    unexcuse_lecture_student_performance_record_path(
                                      @lecture, @record, assessment_id: assessment.id),
                                    method: :patch,
                                    class: "btn btn-link btn-sm text-nowrap p-0" %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>

          <tfoot class="table-light">
            <tr class="fw-bold">
              <td>
                <%= t("student_performance.records.show.total_row") %>
                <br>

                <span class="fw-normal text-muted" style="font-size: 0.75em">
                  <%= t("student_performance.records.show.total_row_hint") %>
                </span>
              </td>

              <td></td>

              <td class="text-end font-monospace">
                <%= number_with_precision(@record.points_total_materialized,
                                        precision: 1,
                                        strip_insignificant_zeros: true) %>
              </td>

              <td class="text-end font-monospace text-muted">
                <%= number_with_precision(@record.points_max_materialized,
                                        precision: 1,
                                        strip_insignificant_zeros: true) %>
              </td>

              <td></td>

              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <div class="border-top pt-3 mt-4">
        <% if @record.computed_at %>
          <div class="text-muted small mb-2">
            <i class="bi bi-info-circle me-1"></i>

            <%= t("student_performance.records.show.last_computed",
                time: time_ago_in_words(@record.computed_at)) %>
          </div>
        <% end %>

        <div class="d-flex flex-column flex-md-row align-items-md-center gap-2">
          <p class="text-muted small mb-0">
            <%= t("student_performance.records.show.recompute_hint") %>
          </p>

          <%= button_to recompute_lecture_student_performance_records_path(@lecture,
                        user_id: @record.user_id),
                      method: :post,
                      class: "btn btn-outline-secondary btn-sm ms-md-auto" do %>
            <i class="bi bi-arrow-clockwise me-1"></i>
            <%= t("student_performance.records.show.recompute") %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
