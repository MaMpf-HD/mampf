<% item_preferences = Array(item_preferences).select { |pref| pref.respond_to?(:item) } %>
<% sorted_items = sorted_student_registration_items(campaign, items, current_user) %>
<% ranks = preference_ranks_for(sorted_items) %>
<% preferences_by_rank = item_preferences.index_by(&:rank) %>
<% disabled = local_assigns.fetch(:disabled, false) %>
<% readonly = disabled || !campaign.open_for_registrations? %>

<%= form_with url: save_preferences_path(campaign), method: :post,
              data: {
                controller: "preference-choices",
                turbo_stream: true,
                preference_choices_empty_label_value: t(
                  "registration.user_registration.preference_podium.empty"
                ),
                preference_choices_incomplete_tooltip_value: t(
                  "registration.user_registration.save_choices_incomplete_tooltip"
                ),
                preference_choices_readonly_value: readonly,
                preference_choices_saved_label_value: t(
                  "registration.user_registration.options.saved"
                ),
                preference_choices_unsaved_label_value: t(
                  "registration.user_registration.options.unsaved"
                )
              } do %>
  <div class="d-grid gap-3">
    <p
      class="registration-choice-summary mb-0"
      role="group"
      data-testid="preference-podium"
      aria-label="<%= t("registration.user_registration.preference_podium.label") %>"
    >
      <% ranks.each do |rank| %>
        <% preference = preferences_by_rank[rank] %>

        <span
          class="registration-choice"
          data-testid="preference-podium-spot"
          data-preference-choices-target="podiumSpot"
          data-rank="<%= rank %>"
        >
          <%= t("registration.user_registration.preference_rank_options.#{rank}") %>

          <span
            data-preference-choices-target="podiumName"
            data-rank="<%= rank %>"
          >
            <%= preference&.item&.registerable&.title.presence ||
                t("registration.user_registration.preference_podium.empty") %>
          </span>
        </span>

        <%= hidden_field_tag "preferences[#{rank}]", preference&.item&.id,
                             data: { preference_choices_target: "input", rank: rank } %>
      <% end %>
    </p>

    <%= render layout: "user_registrations/option_list", locals: { count: sorted_items.size } do %>
      <% sorted_items.each do |item| %>
        <% title = item.registerable.title %>
        <% selected_rank = preference_rank_for(item, item_preferences) %>

        <% actions = capture do %>
          <div class="registration-rank-buttons">
            <% ranks.each do |rank| %>
              <%= button_tag t("registration.user_registration.preference_rank_options.#{rank}"),
                             type: "button",
                             disabled: readonly,
                             class: class_names("btn btn-sm",
                                                "btn-primary": selected_rank == rank,
                                                "btn-outline-primary": selected_rank != rank),
                             aria: {
                               pressed: selected_rank == rank,
                               label: t("registration.user_registration.options.rank_for",
                                        title: title,
                                        rank: t("registration.user_registration." \
                                                "preference_rank_options.#{rank}"))
                             },
                             data: {
                               action: "preference-choices#choose",
                               preference_choices_target: "button",
                               item_id: item.id,
                               item_title: title,
                               rank: rank
                             } %>
            <% end %>
          </div>
        <% end %>

        <%= render "user_registrations/option_row",
                   title: title,
                   type_label: item_display_type(item),
                   meta: item_tile_metadata_rows(item).map { |row| row[:value] },
                   keep: selected_rank.present?,
                   actions: actions %>
      <% end %>
    <% end %>

    <% unless readonly %>
      <div class="registration-savebar" data-testid="preference-savebar">
        <span
          class="registration-savebar-status"
          data-preference-choices-target="status"
          role="status"
        >
          <%= t("registration.user_registration.options.saved") %>
        </span>

        <span
          class="d-inline-block"
          data-testid="preference-save-tooltip"
          data-bs-toggle="tooltip"
          data-preference-choices-target="saveTooltip"
          tabindex="-1"
        >
          <%= submit_tag t("registration.user_registration.save_choices"),
                         class: "btn btn-primary btn-sm",
                         disabled: true,
                         data: { preference_choices_target: "saveButton" } %>
        </span>
      </div>
    <% end %>
  </div>
<% end %>
