<% disabled = local_assigns.fetch(:disabled, false) %>
<% registered_items = local_assigns.fetch(:registered_items, []) %>
<% sorted_items = sorted_student_registration_items(campaign, items, current_user) %>

<div data-test="multi-item-first-come-first-served">
  <%= render layout: "user_registrations/option_list", locals: { count: sorted_items.size } do %>
    <% sorted_items.each do |item| %>
      <% title = item.registerable.title %>
      <% mine = item.in?(registered_items) %>
      <% full = !mine && !item.still_has_capacity? %>
      <% held = registered_items.find { |r| r.registerable_type == item.registerable_type } %>
      <% switchable = !mine && held && !freely_registerable?(item.registerable_type) %>
      <% blocked = !mine && registration_item_blocked?(item, campaign.campaignable) %>
      <% reason = nil %>

      <% actions = capture do %>
        <% if mine %>
          <% if campaign.open_for_withdrawals? %>
            <%= button_to t("registration.user_registration.withdraw"),
                          withdraw_item_path(campaign.id, item.id),
                          method: :delete,
                          class: "btn btn-outline-secondary btn-sm",
                          "aria-label": t("registration.user_registration.options.withdraw_from",
                                          title: title) %>
          <% end %>
        <% elsif full %>
          <%= button_tag t("basics.full"), type: "button", disabled: true,
                                           class: "btn btn-outline-secondary btn-sm" %>
          <% reason = t("registration.user_registration.options.no_places") %>
        <% elsif blocked %>
          <%= button_tag t("registration.user_registration.registration_blocked"),
                         type: "button", disabled: true,
                         class: "btn btn-outline-secondary btn-sm" %>
          <% reason = registration_blocked_tooltip %>
        <% elsif disabled %>
          <%= button_tag t("registration.user_registration.register_now"),
                         type: "button", disabled: true,
                         class: "btn btn-outline-secondary btn-sm" %>
          <% reason = t("registration.user_registration.summary.requirement_missing") %>
        <% elsif switchable %>
          <%= button_to t("registration.user_registration.options.switch"),
                        switch_item_path(campaign.id, item.id),
                        method: :patch,
                        params: { from_item_id: held.id },
                        class: "btn btn-outline-primary btn-sm",
                        "aria-label": t("registration.user_registration.options.switch_to",
                                        title: title) %>
        <% else %>
          <%= button_to t("registration.user_registration.register_now"),
                        register_item_path(campaign.id, item.id),
                        method: :post,
                        class: "btn btn-primary btn-sm",
                        "aria-label": t("registration.user_registration.options.register_for",
                                        title: title) %>
        <% end %>
      <% end %>

      <%= render "user_registrations/option_row",
                 title: title,
                 type_label: item_display_type(item),
                 meta: item_tile_metadata_rows(item).map { |row| row[:value] },
                 seats: option_seats_text(item.capacity, item.item_capacity_used),
                 mine: mine,
                 actions: actions,
                 reason: reason %>
    <% end %>
  <% end %>
</div>
