<section class="lecture-home-block" aria-labelledby="participation-heading">
  <h2 class="lecture-home-label" id="participation-heading">
    <%= t("registration.user_registration.participation.title") %>
  </h2>

  <div class="lecture-home-rows">
    <% rows.each do |row| %>
      <div class="lecture-home-row" data-testid="participation-row">
        <div class="lecture-home-row-content">
          <span class="lecture-home-row-kicker"><%= row.label %></span>

          <div class="lecture-home-row-title">
            <span><%= row.title %></span>

            <% if row.badge %>
              <span class="<%= lecture_home_badge_class(row.badge.first) %>">
                <%= row.badge.last %>
              </span>
            <% end %>
          </div>

          <% row.lines.each do |line| %>
            <div class="lecture-home-row-line"><%= line %></div>
          <% end %>

          <% if row.note.present? %>
            <div class="lecture-home-row-note"><%= row.note %></div>
          <% end %>
        </div>

        <% if row.actions.present? %>
          <div class="lecture-home-row-actions"><%= row.actions %></div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
