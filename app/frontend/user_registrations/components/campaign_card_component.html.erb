<% summary_html = capture do %>
  <div class="registration-fold-summary-text">
    <div class="registration-fold-summary-line">
      <h3 class="registration-fold-title"><%= campaign_title %></h3>

      <% if summary_badge %>
        <span class="<%= helpers.lecture_home_badge_class(summary_badge.first) %>">
          <%= summary_badge.last %>
        </span>
      <% end %>

      <span
        class="lecture-home-badge lecture-home-badge--warn"
        data-registration-fold-target="unsaved"
        hidden
      >
        <%= t("registration.user_registration.summary.unsaved") %>
      </span>
    </div>

    <% summary_lines.each do |line| %>
      <span class="registration-fold-meta"><%= line %></span>
    <% end %>
  </div>

  <%= tag.span cta_label,
               class: class_names("registration-fold-cta",
                                  "registration-fold-cta--primary": cta_primary?),
               aria: { hidden: true } %>
<% end %>

<% body_html = capture do %>
  <% if ineligible? %>
    <div class="registration-fold-notice registration-fold-notice--bad">
      <p class="mb-1 fw-semibold">
        <%= t("registration.user_registration.ineligible_notice.title") %>
      </p>

      <ul class="mb-0 ps-3">
        <% failed_ineligible_policies.each do |policy| %>
          <li>
            <%= eligibility_failure_message(policy,
                                            user: helpers.current_user,
                                            context: :registration) %>
          </li>
        <% end %>
      </ul>
    </div>
  <% elsif finalization_policy_warning? %>
    <div class="registration-fold-notice registration-fold-notice--warn">
      <p class="mb-1 fw-semibold">
        <%= t("registration.user_registration.finalization_policy_notice.title") %>
      </p>

      <p class="mb-0">
        <%= t("registration.user_registration.finalization_policy_notice.description") %>
      </p>
    </div>
  <% end %>

  <% if policy_overview? %>
    <%= tag.details class: "registration-fold-policies", open: ineligible? do %>
      <summary>
        <%= t("registration.user_registration.policy_overview.title") %>
      </summary>

      <div class="student-registration-policy-overview-sections">
        <% policy_overview_sections.each do |section| %>
          <% next if section[:policies].blank? %>

          <section class="student-registration-policy-overview-section">
            <div class="student-registration-policy-overview-section-title">
              <%= section[:title] %>
            </div>

            <div class="student-registration-policy-overview-section-description">
              <%= section[:description] %>
            </div>

            <ul class="student-registration-policy-overview-list list-unstyled mb-0">
              <% section[:policies].each do |policy| %>
                <li class="student-registration-policy-overview-item">
                  <div class="student-registration-policy-overview-copy">
                    <div class="student-registration-policy-overview-rule">
                      <%= eligibility_policy_summary(policy) %>
                    </div>

                    <% hint = policy_overview_hint(policy, context: section[:context]) %>

                    <% if hint.present? %>
                      <div class="student-registration-policy-overview-hint">
                        <%= hint %>
                      </div>
                    <% end %>
                  </div>

                  <span class="badge student-registration-policy-overview-status <%= eligibility_policy_status_badge_class(policy) %>">
                    <%= eligibility_policy_status_label(policy) %>
                  </span>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% unless registration_actions_disabled? %>
    <p class="registration-fold-instruction mb-0"><%= instruction %></p>
  <% end %>

  <% if campaign.first_come_first_served? %>
    <%= render partial: "user_registrations/first_come_first_served/select_first_come_first_served",
               locals: { campaign: campaign,
                         disabled: registration_actions_disabled?,
                         items: items,
                         registered_items: registered_items } %>
  <% else %>
    <%= render partial: "user_registrations/preference_based/select_preference",
               locals: { campaign: campaign,
                         disabled: registration_actions_disabled?,
                         item_preferences: item_preferences,
                         items: items } %>
  <% end %>
<% end %>

<% case part %>
<% when :summary %>
  <%= summary_html %>
<% when :body %>
  <%= body_html %>
<% else %>
  <details
    class="registration-fold"
    id="<%= anchor_id %>"
    data-controller="registration-fold"
    data-action="preference-choices:changed->registration-fold#markUnsaved"
    data-testid="registration-campaign"
  >
    <summary class="registration-fold-summary" id="<%= summary_id %>">
      <%= summary_html %>
    </summary>

    <div class="registration-fold-body" id="<%= body_id %>">
      <%= body_html %>
    </div>
  </details>
<% end %>
