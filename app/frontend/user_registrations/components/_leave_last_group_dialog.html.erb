<%# locals: (id:, label:, group:, rejoin:, path:, lecture_dialog_id:) %>
<div
  class="modal fade"
  id="<%= id %>"
  tabindex="-1"
  aria-labelledby="<%= id %>-title"
  aria-hidden="true"
  data-controller="modal"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="<%= id %>-title"><%= label %></h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="<%= t("buttons.close") %>"
        ></button>
      </div>

      <div class="modal-body">
        <p>
          <%= t("registration.user_registration.participation.last_group.intro", group: group) %>
        </p>

        <ul class="mb-0">
          <li>
            <%= t("registration.user_registration.participation.last_group.whole_course",
                  label: t("lecture_home.leave.button"), group: group) %>
          </li>

          <li>
            <%= t("registration.user_registration.participation.last_group.only_group",
                  label: t("registration.user_registration.participation.last_group.only",
                           label: label)) %>

            <%= rejoin %>
          </li>
        </ul>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          <%= t("buttons.cancel") %>
        </button>

        <%= button_to t("registration.user_registration.participation.last_group.only",
                        label: label),
                      path,
                      method: :delete,
                      params: { keep_course: true },
                      class: "btn btn-outline-secondary" %>

        <button
          type="button"
          class="btn btn-primary"
          data-bs-toggle="modal"
          data-bs-target="#<%= lecture_dialog_id %>"
        >
          <%= t("lecture_home.leave.button") %>
        </button>
      </div>
    </div>
  </div>
</div>
