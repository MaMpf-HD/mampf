<%# locals: (tasks:, open: false) %>
<%= tag.details class: "lecture-home-result-tasks", open: open do %>
  <summary>
    <%= t("registration.user_registration.participation.points_per_problem") %>
  </summary>

  <dl>
    <% tasks.each do |task| %>
      <dt><%= task.label %></dt>
      <dd><%= task.points || "—" %> / <%= task.max_points %></dd>
    <% end %>
  </dl>
<% end %>
