  "................n...............",
  "...............n................",
  "..............oooo..............",
  ".............olrrro.............",
  ".............orrrdo.............",
  "........oooooorrrdoooooo........",
  "......oohhhcccccccccccccoo......",
  ".....ohhcccccccccccppccccso.....",
  "....ohccccqpccccccccqppcccso....",
  "...ohcccccppcccpqccccccccccso...",
  "..ohccccccccccccccccccccccpcso..",
  ".occccccgggggccccccgggggcccccso.",
  ".ocggggglwwwwgggggglwwwwgggggso.",
  ".occcccgwbbbwgccccgwbbbwgccccso.",
  ".occcccgbwwwbgccccgbwwwbgccccso.",
  ".occpccgwwwwwgccccgwwwwwgccpcso.",
  ".occccccgggggccccccgggggcccccso.",
  ".ockkkkcccccccmccmccccccckkkkso.",
  ".occkkcccccccccmmccccccccckkcso.",
  ".osslssslssslssslssslssslssslso.",
  "...ooofoofoofooffoofoofoofooo...",
  "...offfftffftffttfftffftffffo...",
  "....offftffftffttfftffftfffo....",
  "....offftffftffttfftffftfffo....",
  ".....offtffftffttfftffftffo.....",
  ".....offtffftffttfftffftffo.....",
  "......oftffftffttfftffftfo......",
  "......oftffftffttfftffftfo......",
  "......oooooooooooooooooooo......"
