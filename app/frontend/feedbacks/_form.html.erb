<%# locals: (feedback:, throttled: nil, send_failed: false, intro: true) %>
<% body_invalid = feedback.errors[:body].any? %>

<%= form_with model: feedback, url: feedbacks_path, local: true,
              data: { feedback_widget_target: "form" } do |f| %>
  <% if intro %>
    <p class="small text-muted">
      <%= t("feedback.intro") %>
    </p>
  <% end %>

  <% if throttled %>
    <div class="alert alert-warning py-2 small" role="alert">
      <%= throttled %>
    </div>
  <% end %>

  <%# The answer is not stored anywhere, so its text must not get lost. %>
  <% if send_failed %>
    <div class="alert alert-danger py-2 small" role="alert">
      <p class="mb-2"><%= t("feedback.send_failed") %></p>

      <div
        data-controller="clipboard"
        data-clipboard-text-value="<%= feedback.body %>"
        data-clipboard-confirmation-value="<%= t("feedback.copied") %>"
        data-clipboard-failure-value="<%= t("feedback.copy_failed") %>"
        data-clipboard-resting-icon-value="bi-clipboard"
      >
        <button
          type="button"
          class="btn btn-sm btn-outline-danger"
          data-action="clipboard#copy"
        >
          <i class="bi bi-clipboard me-1" aria-hidden="true"
             data-clipboard-target="icon"></i>
          <%= t("feedback.copy") %>
        </button>
        <span class="visually-hidden" role="status" data-clipboard-target="status"></span>
      </div>
    </div>
  <% end %>

  <div class="mb-2">
    <%= f.label :body, t("feedback.body"), class: "visually-hidden" %>

    <%= f.text_area :body,
                    rows: 6,
                    class: class_names("form-control", "is-invalid": body_invalid),
                    placeholder: t("feedback.body_placeholder"),
                    required: true,
                    minlength: Feedback::BODY_MIN_LENGTH,
                    maxlength: Feedback::BODY_MAX_LENGTH,
                    aria: { invalid: body_invalid,
                            describedby: ("feedback-body-error" if body_invalid) },
                    data: { feedback_widget_target: "message" } %>

    <% if body_invalid %>
      <div id="feedback-body-error" class="invalid-feedback">
        <%= feedback.errors.full_messages_for(:body).to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="form-check form-switch mb-2">
    <%= f.check_box :can_contact, class: "form-check-input", role: "switch",
                                  aria: { describedby: "feedback-can-contact-hint" } %>
    <%= f.label :can_contact, t("feedback.can_contact"), class: "form-check-label small" %>
    <div id="feedback-can-contact-hint" class="form-text mt-0">
      <%= t("feedback.can_contact_hint") %>
    </div>
  </div>

  <div class="text-end">
    <%= f.submit t("feedback.send"), class: "btn btn-primary btn-sm" %>
  </div>
<% end %>
