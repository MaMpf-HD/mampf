<%#
  A pixel-art muffin, 24 × 21 pixels. Each letter is one pixel and picks its
  color from the stylesheet:
  o outline, c cap, h highlight, s shade, p chip, q chip light, b lash, e eye,
  l light, k cheek, m mouth, f foil, t pleat, r heart.
  For a blink, the closed eyes are drawn over the open ones; after a sent
  feedback, the heart eyes are.
%>
<% pixels = [
  "......oooooooooooo......",
  "....oohhccccccccccoo....",
  "....ohhccqpccccqpcco....",
  "...ohccccppccccppccco...",
  "..ohcpccccccpcccccpcco..",
  ".ohcccccccccccccccccsco.",
  ".occcccccccccccccccccso.",
  "occcceeecccccccceeecccso",
  "ocpcelleeccccccelleeccso",
  "occcelleeccccccelleecpso",
  "occceeeeecccccceeeeeccso",
  "occceeelecmccmceeeleccso",
  "ockkkeeecccmmccceeekkkso",
  ".okkkcccccccccccccckkko.",
  "..osssoossssssssoossso..",
  "...ofoccotfffftoccofo...",
  "...offooftfffftfooffo...",
  "....oftfftfffftfftfo....",
  "....oftfftfffftfftfo....",
  ".....otfftfffftffto.....",
  ".....oooooooooooooo....."
] %>
<% closed_eye = [
  ".ccc.",
  "ccccc",
  "cbbbc",
  "bcccb",
  "ccccc",
  ".ccc."
] %>
<% heart_eye = [
  ".rcr.",
  "rlrrr",
  "rrrrr",
  "crrrc",
  "ccrcc",
  ".ccc."
] %>
<%# Draws a pixel grid at the given offset, one rect per run of a color. %>
<% draw = lambda do |rows, left, top|
     safe_join(rows.each_with_index.flat_map do |row, y|
       x = left
       row.chars.chunk_while { |a, b| a == b }.filter_map do |run|
         unless run.first == "."
           rect = tag.rect(class: "feedback-muffin__#{run.first}",
                           x: x, y: top + y, width: run.size, height: 1)
         end
         x += run.size
         rect
       end
     end)
   end %>
<svg
  class="feedback-muffin"
  viewBox="0 0 24 21"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  <%= draw.call(pixels, 0, 0) %>
  <g class="feedback-muffin__eyes-closed">
    <%= draw.call(closed_eye, 4, 7) %>
    <%= draw.call(closed_eye, 15, 7) %>
  </g>
  <g class="feedback-muffin__eyes-love">
    <%= draw.call(heart_eye, 4, 7) %>
    <%= draw.call(heart_eye, 15, 7) %>
  </g>
</svg>
