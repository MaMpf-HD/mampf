<div class="container-md mt-3">
  <h1 class="h4"><%= t("search.staff.title") %></h1>

  <ul class="nav nav-pills mt-3" role="tablist">
    <li class="nav-item" role="presentation">
      <button
        class="nav-link active"
        type="button"
        role="tab"
        data-bs-toggle="pill"
        data-bs-target="#media_catalog"
      >
        <%= t("admin.navbar.media_search") %>
      </button>
    </li>

    <li class="nav-item" role="presentation">
      <button
        class="nav-link"
        type="button"
        role="tab"
        data-bs-toggle="pill"
        data-bs-target="#tag_search"
      >
        <%= t("admin.navbar.tag_search") %>
      </button>
    </li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="media_catalog" role="tabpanel">
      <%= render partial: "search/media_search_form", locals: { purpose: "media" } %>
      <div id="media-search-results"></div>
    </div>

    <div class="tab-pane fade" id="tag_search" role="tabpanel">
      <%= render partial: "search/tag_search_form" %>
      <div id="tag-search-results"></div>
    </div>
  </div>
</div>
