<%= vite_stylesheet_tag "search/index.scss" %>

<div class="container-md small-width">
  <div class="accordion" id="subscriptionsAccordion">

    <!-- Tag Search -->
    <div class="accordion-item">
      <div class="accordion-header">
        <button class="accordion-button <%= 'collapsed' unless @search_string.present? %>"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapseTagSearch"
                aria-expanded="<%= @search_string.present? %>"
                aria-controls="collapseTagSearch">
          <h4 class="<%= text_dark_link(@search_string.present?) %>"
              id="tagSearchLink">
            <%= t('search.tag_search') %>
          </h4>
        </button>
      </div>
      <div class="<%= show_collapse(@search_string.present?) %> subscriptionsCollapse"
           id="collapseTagSearch"
           data-bs-parent="#subscriptionsAccordion"
           data-link="#tagSearchLink">
        <div class="accordion-body" data-controller="auto-submit-form">
          <%= form_with url: search_index_path,
                        method: :get,
                        class: "mb-3",
                        id: "tagSearchForm",
                        data: { turbo_frame: "tag-search-results",
                                auto_submit_form_target: "form" } do %>
            <%= search_field_tag :search,
                                @search_string,
                                class: "form-control",
                                placeholder: t('navbar.search'),
                                data: { action: "input->auto-submit-form#debouncedSubmit",
                                        auto_submit_form_target: "searchInput" } %>
          <% end %>
          <div class="tag-search-results-wrapper">
            <%= turbo_frame_tag "tag-search-results", target: "_top" do %>
              <% if @search_too_short %>
                <div class="text-danger small">
                  <%= t('search.term_too_short') %>
                </div>
              <% elsif @tags %>
                <%= render partial: 'search/tag_search_results',
                           locals: { tags: @tags,
                                     filtered_tags: @filtered_tags,
                                     search_string: @search_string } %>
              <% end %>
            <% end %>
            <div class="tag-search-spinner">
              <div class="spinner-border spinner-border-sm text-secondary" role="status">
                <span class="visually-hidden"><%= t('basics.loading') %></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Lecture Search -->
    <div class="accordion-item">
      <div class="accordion-header">
        <button class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapseLectureSearch"
                aria-expanded="false"
                aria-controls="collapseLectureSearch">
          <h4 class="text-dark"
              id="lectureSearchLink">
            <%= t('basics.lecture_search') %>
          </h4>
        </button>
      </div>
      <div class="collapse subscriptionsCollapse" id="collapseLectureSearch"
           data-bs-parent="#subscriptionsAccordion"
           data-link="#lectureSearchLink">
        <div class="accordion-body">
          <%= render partial: 'search/lecture_search_form',
                     locals: { results_as_list: false } %>
          <div id="lecture-search-results-old">
          </div>
        </div>
      </div>
    </div>

    <!-- Media Search -->
    <div class="accordion-item mb-3">
      <div class="accordion-header">
        <button class="accordion-button collapsed"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapseMediaSearch"
                aria-expanded="false"
                aria-controls="collapseMediaSearch">
          <h4 class="text-dark"
              id="mediaSearchLink">
            <%= t('profile.media_search') %>
          </h4>
        </button>
      </div>
      <div class="collapse subscriptionsCollapse" id="collapseMediaSearch"
           data-bs-parent="#subscriptionsAccordion"
           data-link="#mediaSearchLink">
        <div class="accordion-body">
          <%= render partial: 'search/media_start_search_form',
                     locals: { results_as_list: false,
                               purpose: 'media' } %>
          <div id="media-search-results">
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= render partial: "lectures/search/search" %>
</div>
