<%= vite_stylesheet_tag "styles/sidebar.scss" %>

<% I18n.with_locale(lecture&.locale_with_inheritance) do %>
<%# Content is only accessible to subscribers and staff (mirrors the
        redirect in LecturesController#check_for_subscribe). %>
<% content_accessible = lecture &&
                        (lecture.in?(current_user.lectures) ||
                         current_user.can_edit?(lecture)) %>
<ul class="nav nav-pills flex-column" data-controller="lecture-sidebar">

  <%# Lecture Home %>
  <% project_name = 'home' %>
  <% fullpath = lecture_home_path(lecture) %>
  <% active_class = get_class_for_project(project_name) %>
  <% home_updates_count = current_user.active_notifications(lecture).size +
                          lecture.unread_forum_topics_count(current_user).to_i %>
  <li class="sidebar-item nav-link <%= active_class %>">
    <%= link_to url_for(fullpath),
        data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
      <span class="sidebar-item__label">
        <i class="bi bi-house<%= active_class.present? ? "-fill" : "" %>"></i>
        <span class="sidebar-item__text"><%= t("basics.home") %></span>
      </span>
      <% if home_updates_count.positive? %>
        <span class="sidebar-item__badge"
              title="<%= t("registration.lecture.home.news_indicator") %>">
          <%= home_updates_count %>
        </span>
      <% end %>
    <% end %>
  </li>


  <%# Overview %>
  <% if lecture %>
    <% fullpath = lecture_outline_path(lecture) %>
    <% active_class = get_class_for_path(lecture_outline_path(lecture)) %>
    <li class="sidebar-item nav-link <%= active_class %>
            <%= content_accessible ? "" : "disabled" %>">
      <%= link_to url_for(fullpath),
          data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
        <i class="bi bi-book<%= active_class.present? ? "-fill" : "" %>"></i>
        <span class="sidebar-item__text"><%= t('basics.outline') %></span>
      <% end %>
    </li>
  <% end %>

  <%# LessonMaterials %>
  <% project_name = 'lesson_material' %>
  <% fullpath = lecture_lesson_materials_path(lecture) %>
  <% active_class = get_class_for_project(project_name) %>
  <li class="sidebar-item nav-link <%= active_class %>
      <%= !content_accessible || !lecture.lesson_material?(current_user) ? "disabled" : ""%>">
    <%= link_to url_for(fullpath),
        data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
      <i class="bi bi-collection-play<%= active_class.present? ? "-fill" : "" %>"></i>
      <span class="sidebar-item__text"><%= t('categories.lesson_material.plural') %></span>
    <% end %>
  </li>

  <%# Script %>
  <% project_name = 'script' %>
  <% fullpath = lecture_script_path(lecture) %>
  <% active_class = get_class_for_project(project_name) %>
  <li class="sidebar-item nav-link <%= active_class %>
      <%= !content_accessible || !lecture.script?(current_user) ? "disabled" : ""%>">
    <%= link_to url_for(fullpath),
        data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
      <i class="bi bi-file-earmark<%= active_class.present? ? "-fill" : "" %>"></i>
      <span class="sidebar-item__text"><%= t('categories.script.singular') %></span>
    <% end %>
  </li>

  <%# Divider %>
  <span class="border-top my-3"></span>

  <%# Exercises %>
  <% project_name = 'exercise' %>
  <% fullpath = lecture_exercises_path(lecture) %>
  <% active_class = get_class_for_project(project_name) %>
  <li class="sidebar-item nav-link <%= active_class %>
      <%= !content_accessible || !lecture.exercise?(current_user) ? "disabled" : ""%>">
    <%= link_to url_for(fullpath),
        data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
      <i class="bi bi-pencil<%= active_class.present? ? "-fill" : "" %>"></i>
      <span class="sidebar-item__text"><%= t('categories.exercise.plural') %></span>
    <% end %>
  </li>

  <%# Tutorials %>
  <% if lecture %>
    <% if current_user.in?(lecture.tutors)
        link_text, path = [t('categories.tutorials'), lecture_tutorials_path(lecture)]
        exists = true
      elsif current_user.editor_or_teacher_in?(lecture)
        link_text, path = [t('categories.tutorials'), lecture_tutorial_overview_path(lecture)]
        exists = lecture.tutorials.any?
      else
        link_text, path = [t('categories.submissions'), lecture_submissions_path(lecture)]
        exists = lecture.assignments.any? && lecture.tutorials.any?
      end %>
    <% active_class = get_class_for_any_path(
        [lecture_tutorials_path(lecture),
        lecture_tutorial_overview_path(lecture),
        lecture_submissions_path(lecture)]) %>
    <li class="sidebar-item nav-link <%= active_class %>
        <%= !content_accessible || !exists ? "disabled" : ""%>">
      <%= link_to url_for(path),
          data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
        <i class="bi bi-people<%= active_class.present? ? "-fill" : "" %>"></i>
        <span class="sidebar-item__text"><%= link_text %></span>
      <% end %>
    </li>
  <% end %>

  <% if lecture %>
    <%# Müsli (external link) %>
    <li class="sidebar-item nav-link <%= !content_accessible || !lecture.muesli ? "disabled" : ""%>">
      <a href="<%= DefaultSetting::MUESLI_LINK %>" target="_blank" rel="noopener noreferrer">
        <i class="bi bi-list-check"></i>
        <span class="sidebar-item__text"><%= t('categories.muesli') %></span>
      </a>
    </li>
  <% end %>

  <%# Divider %>
  <span class="border-top my-3"></span>

  <%# Quizzes %>
  <% project_name = 'quiz' %>
  <% fullpath = lecture_quizzes_path(lecture) %>
  <% active_class = get_class_for_project(project_name) %>
  <li class="sidebar-item nav-link <%= active_class %>
      <%= !content_accessible || !lecture.quiz?(current_user) ? "disabled" : ""%>">
    <%= link_to url_for(fullpath),
        data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
      <i class="bi bi-question-square<%= active_class.present? ? "-fill" : "" %>"></i>
      <span class="sidebar-item__text"><%= t('categories.quiz.plural') %></span>
    <% end %>
  </li>

  <!-- Should Vignettes (Questionnaires) be needed in the sidebar, refer to this commit: -->
  <!-- be62caccda12f9d6c6c96cb52 -->
  <!-- https://github.com/MaMpf-HD/mampf/pull/737/commits/be62caccda12f9d6c6c96cb52 -->

  <%# Self test %>
  <% path = show_random_quizzes_path(lecture) %>
  <% active_class = get_class_for_path(path) %>
  <li class="sidebar-item nav-link <%= active_class %>
      <%= !content_accessible || !lecture.course.enough_questions? ? "disabled" : ""%>">
    <%= link_to url_for(path),
        data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
      <i class="bi bi-star<%= active_class.present? ? "-fill" : "" %>"></i>
      <span class="sidebar-item__text"><%= t('categories.test.singular') %></span>
    <% end %>
  </li>

  <%# Worked Examples %>
  <% project_name = 'worked_example' %>
  <% fullpath = lecture_worked_examples_path(lecture) %>
  <% active_class = get_class_for_project(project_name) %>
  <li class="sidebar-item nav-link <%= active_class %>
      <%= !content_accessible || !lecture.worked_example?(current_user) ? "disabled" : ""%>">
    <%= link_to url_for(fullpath),
        data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
      <i class="bi bi-mortarboard<%= active_class.present? ? "-fill" : "" %>"></i>
      <span class="sidebar-item__text"><%= t('categories.worked_example.plural') %></span>
    <% end %>
  </li>

  <%# Repetition %>
  <% project_name = 'repetition' %>
  <% fullpath = lecture_repetitions_path(lecture) %>
  <% active_class = get_class_for_project(project_name) %>
  <li class="sidebar-item nav-link <%= active_class %>
      <%= !content_accessible || !lecture.repetition?(current_user) ? "disabled" : ""%>">
    <%= link_to url_for(fullpath),
        data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
      <i class="bi bi-layers<%= active_class.present? ? "-fill" : "" %>"></i>
      <span class="sidebar-item__text"><%= t('categories.repetition.singular') %></span>
    <% end %>
  </li>

  <%# Miscellaneous %>
  <% project_name = 'miscellaneous' %>
  <% fullpath = lecture_miscellaneous_path(lecture) %>
  <% active_class = get_class_for_project(project_name) %>
  <li class="sidebar-item nav-link <%= active_class %>
      <%= !content_accessible || !lecture.miscellaneous?(current_user) ? "disabled" : ""%>">
    <%= link_to url_for(fullpath),
        data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
      <i class="bi bi-circle<%= active_class.present? ? "-fill" : "" %>"></i>
      <span class="sidebar-item__text"><%= t('categories.miscellaneous.singular') %></span>
    <% end %>
  </li>

  <% if lecture %>
    <%# Divider %>
    <span class="border-top my-3"></span>

    <%# Forum %>
    <% forum_present = lecture.forum? %>
    <% path = forum_present ? "/forum/" + lecture.forum.slug : "nothing" %>
    <li class="sidebar-item nav-link <%= !content_accessible || !forum_present ? "disabled" : ""%>">
      <a href="<%= url_for(path)%>" target="_blank">
        <%# Will never become active as this is an external link %>
        <i class="bi bi-chat"></i>
        <span class="sidebar-item__text"><%= t('categories.board') %></span>
      </a>
    </li>

    <%# Announcements %>
    <% path = lecture_announcements_path(lecture) %>
    <% active_class = get_class_for_path(path) %>
    <li class="sidebar-item nav-link <%= active_class %>
          <%= !content_accessible || !lecture.announcements.exists? ? "disabled" : ""%>">
      <%= link_to url_for(path),
          data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
        <i class="bi bi-megaphone<%= active_class.present? ? "-fill" : "" %>"></i>
        <span class="sidebar-item__text"><%= t('categories.announcements') %></span>
      <% end %>
    </li>

    <%# Organizational %>
    <% path = lecture_organizational_path(lecture) %>
    <% active_class = get_class_for_path(path) %>
    <li class="sidebar-item nav-link <%= active_class %>
          <%= !content_accessible || !lecture.organizational ? "disabled" : ""%>">
      <%= link_to url_for(path),
          data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
        <i class="bi bi-info-square<%= active_class.present? ? "-fill" : "" %>"></i>
        <span class="sidebar-item__text"><%= t('categories.organizational_html') %></span>
      <% end %>
    </li>

    <%# Modul %>
    <% path = lecture_course_path(lecture) %>
    <% active_class = get_class_for_path(path) %>
    <li class="sidebar-item nav-link <%= active_class %>
            <%= content_accessible ? "" : "disabled" %>">
      <%= link_to url_for(path),
          data: { turbo_frame: "main", action: "click->lecture-sidebar#setActive" } do %>
        <i class="bi bi-hexagon<%= active_class.present? ? "-fill" : "" %>"></i>
        <span class="sidebar-item__text"><%= t('categories.course') %></span>
      <% end %>
    </li>
  <% end %>
</ul>
<% end %>