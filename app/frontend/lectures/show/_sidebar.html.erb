<%= vite_stylesheet_tag "styles/sidebar.scss" %>

<%# Content is only accessible to staff and users who unlocked the lecture
        (mirrors the redirect in LecturesController#check_for_unlock). %>
<% content_accessible = lecture&.content_accessible_by?(current_user) %>
<% sections = LecturePages.visible(lecture, current_user)
                          .chunk_while { |page, next_page| page.section == next_page.section } %>
<ul
  class="nav nav-pills flex-column"
  data-controller="lecture-sidebar"
  data-action="turbo:frame-load@document->lecture-sidebar#markLoaded"
>
  <% sections.each_with_index do |pages, index| %>
    <% if index.positive? %>
      <span class="border-top my-3"></span>
    <% end %>

    <% pages.each do |page| %>
      <% path = page.path.call(lecture) %>
      <% active = page.active_on?(request, path) %>
      <% enabled = page.enabled?(lecture, current_user, content_accessible) %>
      <% link_options = if page.new_tab
                          { target: "_blank" }
                        else
                          { data: { turbo_frame: "main",
                                    action: "click->lecture-sidebar#setActive" } }
                        end %>
      <li class="sidebar-item nav-link <%= active ? ApplicationHelper::ACTIVE_CSS_CLASS : "" %>
          <%= enabled ? "" : "disabled" %>">
        <%= tag.a(href: path, **link_options) do %>
          <span class="sidebar-item__label">
            <i class="bi <%= page.icon %><%= active ? "-fill" : "" %>"></i>
            <%= t(page.label_key) %>
          </span>

          <% if page.key == "home" %>
            <% home_updates_count = current_user.active_notifications(lecture).size +
                                    lecture.unread_forum_topics_count(current_user).to_i %>
            <%= render SidebarBadgeComponent.new(id: SidebarBadgeComponent::HOME_ID,
                                                 count: home_updates_count,
                                                 title: t("registration.lecture.home.news_indicator")) %>
          <% elsif page.key == "submissions" && content_accessible %>
            <% work = @work || Assessment::SubmissionsHub::Loader.new(lecture: lecture,
                                                                      user: current_user).summary %>
            <%= render SidebarBadgeComponent.new(id: SidebarBadgeComponent::SUBMISSIONS_ID,
                                                 count: work.news_count,
                                                 title: t("submission.hub.news.indicator")) %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  <% end %>
</ul>
