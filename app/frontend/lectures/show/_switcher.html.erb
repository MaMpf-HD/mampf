<%# The lecture's title, which opens a list of the user's other lectures of
    the current term to switch to. While editing, it switches to editing the
    other lecture in the same tab, as far as the user may do so. %>
<% lectures = current_user.current_lectures %>
<% term = Term.active&.compact_title %>
<div class="dropdown" data-controller="lecture-switcher">
  <button type="button"
          class="btn btn-link link-body-emphasis text-decoration-none fs-5 fw-semibold
                 dropdown-toggle text-truncate p-0"
          id="lecture-title-bar-title"
          title="<%= t("lecture.title_bar.switch") %>"
          data-bs-toggle="dropdown"
          aria-expanded="false">
    <%= lecture.title_term_info_no_type %>
  </button>
  <ul class="dropdown-menu shadow" aria-labelledby="lecture-title-bar-title">
    <% if term %>
      <li>
        <h6 class="dropdown-header">
          <%= t("lecture.title_bar.current_lectures", term: term) %>
        </h6>
      </li>
    <% end %>
    <% lectures.each do |other| %>
      <% edit = edit_mode && current_user.can_edit?(other) %>
      <li>
        <%= link_to other.course.title,
                    edit ? edit_lecture_path(other) : lecture_path(other),
                    class: ["dropdown-item", { active: other == lecture }],
                    aria: { current: other == lecture ? "page" : nil },
                    data: { turbo_frame: "_top",
                            action: ("click->lecture-switcher#keepTab" if edit) } %>
      </li>
    <% end %>
    <% if term && (lectures - [lecture]).empty? %>
      <li>
        <span class="dropdown-item-text text-body-secondary">
          <%= t("lecture.title_bar.no_other_lectures", term: term) %>
        </span>
      </li>
    <% end %>
  </ul>
</div>
