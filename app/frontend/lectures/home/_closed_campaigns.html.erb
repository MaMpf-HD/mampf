<%# locals: (overview:) %>
<% campaigns = overview.closed_campaigns %>
<% if campaigns.any? %>
  <section class="card lecture-home-section" aria-labelledby="closed-campaigns-heading"
           data-testid="lecture-home-closed-campaigns">
    <div class="card-header">
      <h2 class="lecture-home-section-title" id="closed-campaigns-heading">
        <%= t("lecture_home.closed.title") %>
      </h2>
    </div>
    <ul class="lecture-home-rows list-unstyled mb-0">
      <% campaigns.each do |campaign| %>
        <li class="lecture-home-row" id="<%= dom_id(campaign, :student_registration) %>">
          <div class="lecture-home-row-content">
            <span class="lecture-home-row-title">
              <%= student_registration_campaign_title(campaign) %>
              <span class="<%= lecture_home_badge_class(:info) %>">
                <%= lecture_home_closed_status(campaign) %>
              </span>
            </span>
            <span class="lecture-home-row-line">
              <% if closed_early?(campaign) %>
                <%= t("registration.user_registration.closed_before_deadline") %>
              <% else %>
                <%= t("lecture_home.closed.deadline",
                      deadline: format_date(campaign.registration_deadline)) %>
              <% end %>
            </span>
            <% own = overview.registrations_for(campaign) %>
            <% if own.any? %>
              <span class="lecture-home-row-line">
                <%= t("lecture_home.closed.your_entries",
                      entries: own.map { |r| r.registration_item.title }.uniq.join(", ")) %>
              </span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
