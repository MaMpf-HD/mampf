<% title_id = "#{id}-title" %>

<div
  class="modal fade"
  id="<%= id %>"
  tabindex="-1"
  aria-labelledby="<%= title_id %>"
  aria-hidden="true"
  data-controller="modal"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <%= form_with url: url, method: :delete, local: true do |form| %>
        <div class="modal-header">
          <h5 class="modal-title" id="<%= title_id %>">
            <%= title %>
          </h5>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="<%= t("buttons.close") %>"
          ></button>
        </div>

        <div class="modal-body">
          <% if last_place? %>
            <p>
              <%= t("registration.user_registration.participation.leave_last_place",
                    group: label) %>
            </p>
          <% elsif stays_enrolled? %>
            <p>
              <%= t("registration.user_registration.participation.leave_stays_enrolled") %>
            </p>
          <% end %>

          <% if rosterable.is_a?(Tutorial) %>
            <p><%= t("registration.user_registration.participation.leave_no_sheets") %></p>
          <% end %>

          <% if last_place? %>
            <% if remaining.any? %>
              <p class="mb-1">
                <%= t("registration.user_registration.participation.leave_remaining") %>
              </p>

              <div class="d-flex flex-wrap gap-1 mb-3">
                <% remaining.each do |item| %>
                  <span class="<%= lecture_home_badge_class(:info) %>"><%= item %></span>
                <% end %>
              </div>
            <% end %>

            <p class="small text-muted">
              <%= t("registration.user_registration.participation.leave_results_stay") %>
            </p>

            <% if bookmarked? %>
              <p class="small text-muted"><%= bookmark_note %></p>
            <% end %>

            <p class="small text-muted">
              <%= t("registration.user_registration.participation.leave_whole_lecture") %>
            </p>
          <% end %>

          <p class="mb-0"><%= rejoin_note %></p>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%= t("buttons.cancel") %>
          </button>

          <%= form.submit submit_label,
                          class: "btn border-0 bg-danger-subtle text-danger-emphasis" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
