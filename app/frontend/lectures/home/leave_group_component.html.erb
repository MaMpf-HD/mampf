<% title_id = "#{id}-title" %>

<div
  class="modal fade"
  id="<%= id %>"
  tabindex="-1"
  aria-labelledby="<%= title_id %>"
  aria-hidden="true"
  data-controller="modal"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <%= form_with url: url, method: :delete, local: true do |form| %>
        <div class="modal-header">
          <h5 class="modal-title" id="<%= title_id %>">
            <%= title %>
          </h5>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="<%= t("buttons.close") %>"
          ></button>
        </div>

        <div class="modal-body">
          <ul class="mb-0">
            <% notes.each do |note| %>
              <li><%= note %></li>
            <% end %>
          </ul>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%= t("buttons.cancel") %>
          </button>

          <%= form.submit submit_label,
                          class: "btn border-0 bg-danger-subtle text-danger-emphasis" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
