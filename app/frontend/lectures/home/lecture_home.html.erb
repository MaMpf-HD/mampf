<%= vite_stylesheet_tag "user_registrations/index.scss" %>
<%= vite_stylesheet_tag "lectures/home/lecture_home.scss" %>

<% content_accessible = @subscribed || @can_edit %>
<% campaigns = Array(@campaign_summaries) %>
<% focus = lecture_home_focus(campaigns: campaigns, work: @work, next_exam: @next_exam) %>
<% listed_campaigns = campaigns.reject { |details| focus&.subject == details } %>

<div class="container-md small-width lecture-home" data-testid="lecture-home">
  <header class="lecture-home-header">
    <p class="lecture-home-meta">
      <%= @lecture.sort_localized %>
      <% if @lecture.term || !@lecture.disable_teacher_display %>
        ·
        <% if !@lecture.teacher.archived %>
          <%= link_to @lecture.teacher.name, teacher_path(@lecture.teacher),
                      id: "lecture-teacher", class: "text-reset" %>
        <% else %>
          <%= @lecture.teacher.name %>
        <% end %>
      <% end %>
      <% if current_user.admin || current_user.in?(@lecture.editors_with_inheritance) %>
        <%= link_to edit_lecture_path(@lecture), id: "lecture-edit", class: "text-reset ms-1",
                                                 title: t("buttons.edit"),
                                                 "aria-label": t("buttons.edit") do %>
          <i class="far fa-edit" aria-hidden="true"></i>
        <% end %>
      <% end %>
    </p>
    <h1 class="lecture-home-title" id="lecture-title"><%= @lecture.title_term_info_no_type %></h1>
  </header>

  <% if @lecture.home_content? %>
    <div class="lecture-home-intro" data-testid="lecture-home-intro"
         data-controller="lecture-intro"
         data-lecture-intro-more-label-value="<%= t("lecture_home.intro.more") %>"
         data-lecture-intro-less-label-value="<%= t("lecture_home.intro.less") %>">
      <% if @can_edit %>
        <%= link_to edit_lecture_path(@lecture, tab: "home"),
                    class: "float-end text-muted ms-2",
                    title: t("buttons.edit"),
                    "aria-label": t("buttons.edit") do %>
          <i class="far fa-edit" aria-hidden="true"></i>
        <% end %>
      <% end %>
      <% if @lecture.home_intro_present? %>
        <div class="lecture-home-intro-text" data-lecture-intro-target="text">
          <%= sanitize(@lecture.home_intro) %>
        </div>
        <button type="button" class="btn btn-link p-0 lecture-home-intro-toggle"
                data-lecture-intro-target="toggle" data-action="lecture-intro#toggle"
                aria-expanded="false" hidden>
          <%= t("lecture_home.intro.more") %>
        </button>
      <% end %>
      <% if @lecture.home_attachment.present? %>
        <%= link_to lecture_home_attachment_path(@lecture),
                    class: "btn btn-outline-primary btn-sm mt-2",
                    target: "_blank", rel: "noopener",
                    data: { testid: "lecture-home-attachment" } do %>
          <i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>
          <%= t("registration.lecture.home.attachment_download") %>
        <% end %>
      <% end %>
    </div>
  <% elsif @can_edit %>
    <p class="lecture-home-intro lecture-home-intro--empty" data-testid="lecture-home-intro-empty">
      <%= Array(@managed_campaigns).any? ? t("registration.lecture.home.intro_empty_campaign") :
                                           t("registration.lecture.home.intro_empty") %>
      <%= link_to t("admin.lecture.home_intro_add"), edit_lecture_path(@lecture, tab: "home") %>
    </p>
  <% end %>

  <% unless content_accessible %>
    <div class="lecture-home-subscribe" data-testid="lecture-home-subscribe-hint">
      <p class="mb-2"><%= t("registration.lecture.home.subscribe_prompt") %></p>
      <%= form_with url: subscribe_lecture_path, method: :patch, local: true, scope: "lecture",
                    class: "d-flex align-items-center flex-wrap gap-2" do |f| %>
        <%= f.hidden_field :id, value: @lecture.id %>
        <%= f.hidden_field :parent, value: "redirect" %>
        <% if @passphrase_required %>
          <%= f.password_field :passphrase,
                               class: "form-control w-auto",
                               placeholder: t("profile.passphrase"),
                               "aria-label": t("profile.passphrase"),
                               data: { testid: "lecture-home-passphrase" } %>
        <% end %>
        <%= f.submit t("lecture_home.subscribe"),
                     class: "btn btn-outline-primary text-nowrap",
                     data: { testid: "lecture-home-subscribe-button" } %>
      <% end %>
    </div>
  <% end %>

  <% backlog = @tutor_backlog || @lecture_backlog %>
  <% if backlog&.entries&.any? %>
    <%= render "lectures/home/marking", lecture: @lecture, backlog: backlog,
                                        per_tutorial: @tutor_backlog.present? %>
  <% elsif focus && focus.kind != :sheet %>
    <%= render "lectures/home/focus", focus: focus, certification: @certification %>
  <% end %>

  <% if @work %>
    <%= render "lectures/home/work", lecture: @lecture, work: @work,
                                     certification: @certification,
                                     highlighted: focus&.kind == :sheet %>
  <% end %>

  <% if @notifications.present? || (@lecture.forum? && @new_topics_count.positive?) %>
    <%= render "lectures/home/news", lecture: @lecture, notifications: @notifications,
                                     posts_count: @new_topics_count %>
  <% end %>

  <% if @tutorials_given.any? %>
    <%= render "lectures/home/tutor_block", lecture: @lecture, tutorials: @tutorials_given,
                                            member_counts: @member_counts %>
  <% end %>

  <% if @can_edit && @managed_campaigns.any? %>
    <%= render "lectures/home/teacher_block", lecture: @lecture,
                                              campaigns: @managed_campaigns,
                                              counts: @campaign_counts %>
  <% end %>

  <% if listed_campaigns.any? %>
    <section class="lecture-home-block" aria-labelledby="registrations-heading"
             data-testid="lecture-home-registrations">
      <h2 class="lecture-home-label" id="registrations-heading">
        <%= t("registration.user_registration.registrations_title") %>
      </h2>
      <div class="registration-folds">
        <% listed_campaigns.each do |details| %>
          <%= render CampaignCardComponent.new(details: details, campaign: details.campaign) %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @overview %>
    <div id="<%= ParticipationComponent::TARGET %>">
      <%= render ParticipationComponent.new(lecture: @lecture, user: current_user,
                                            overview: @overview) %>
    </div>

    <% if @self_rosterables.any? %>
      <div class="registration-folds lecture-home-block">
        <%= render SelfEnrollmentComponent.new(lecture: @lecture, user: current_user,
                                               rosterables: @self_rosterables) %>
      </div>
    <% end %>

    <%= render "lectures/home/history", overview: @overview %>
  <% end %>

  <% if !@lecture.home_content? && !@can_edit && focus.nil? && @notifications.blank? &&
        @new_topics_count.zero? && @tutorials_given.empty? && campaigns.empty? &&
        Array(@self_rosterables).empty? %>
    <div class="lecture-home-empty" data-testid="lecture-home-fallback-card">
      <h2 class="h5 mb-2"><%= t("registration.lecture.home.empty_title") %></h2>
      <% if @subscribed %>
        <p class="mb-3"><%= t("registration.lecture.home.empty_subscribed") %></p>
        <%= link_to t("basics.outline"), lecture_outline_path(@lecture),
                    class: "btn btn-outline-primary btn-sm" %>
      <% else %>
        <p class="mb-0"><%= t("registration.lecture.home.empty_unsubscribed") %></p>
      <% end %>
    </div>
  <% end %>
</div>
