<% title_id = "#{LeaveLectureComponent::ID}-title" %>

<div
  class="modal fade"
  id="<%= LeaveLectureComponent::ID %>"
  tabindex="-1"
  aria-labelledby="<%= title_id %>"
  aria-hidden="true"
  data-testid="leave-lecture-dialog"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="<%= title_id %>">
          <%= t("lecture_home.leave.title") %>
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="<%= t("buttons.close") %>"
        ></button>
      </div>

      <div class="modal-body">
        <% if blockers.any? %>
          <p class="mb-1"><%= t("lecture_home.leave.blocked") %></p>

          <ul class="mb-2">
            <% blockers.each do |blocker| %>
              <li>
                <%= t("lecture_home.leave.blockers.#{blocker.reason}", title: blocker.title) %>
              </li>
            <% end %>
          </ul>

          <% if contact? %>
            <p class="mb-0"><%= t("lecture_home.leave.contact") %></p>
          <% end %>
        <% else %>
          <p class="mb-1"><%= t("lecture_home.leave.intro") %></p>

          <ul class="mb-0">
            <% consequences.each do |consequence| %>
              <li><%= consequence %></li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <div class="modal-footer">
        <% if blockers.any? %>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%= t("buttons.close") %>
          </button>
        <% else %>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%= t("buttons.cancel") %>
          </button>

          <%= button_to t("lecture_home.leave.button"),
                        lecture_membership_path(@lecture),
                        method: :delete,
                        class: "btn border-0 bg-danger-subtle text-danger-emphasis" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
