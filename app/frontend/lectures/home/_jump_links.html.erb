<%# locals: (details:) %>
<% pending = details.select { |d| registration_needs_action?(d) } %>
<% if pending.any? %>
  <nav class="lecture-home-jump-links" aria-label="<%= t("lecture_home.jump_links.label") %>"
       data-testid="lecture-home-jump-links">
    <% pending.each do |d| %>
      <%= link_to "##{dom_id(d.campaign, :student_registration)}",
                  class: "lecture-home-jump-link" do %>
        <i class="bi bi-arrow-down-circle" aria-hidden="true"></i>
        <%= t("lecture_home.jump_links.open",
              title: student_registration_campaign_title(d.campaign),
              deadline: format_date(d.campaign.registration_deadline)) %>
      <% end %>
    <% end %>
  </nav>
<% end %>
