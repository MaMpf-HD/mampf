<div class="card bg-mdb-color-lighten-5">
  <div class="card-header">
    <h5>
      <%= t("admin.lecture.#{lecture.sort}_content") %>
      <i id="show-media-button"
         class="far fa-list-alt clickable"
         data-action="click->lecture-edit#showMedia"
         data-lecture-edit-target="showMediaButton"
         data-bs-toggle="tooltip"
         title="<%= t('admin.lecture.show_media') %>">
      </i>
    </h5>
  </div>
  <div class="card-body">
    <p class="text-muted small">
      <%= t("admin.lecture.talks_managed_in_groups_html",
            link: link_to(t("roster.tabs.groups"),
                          edit_lecture_path(lecture, tab: "groups"))) %>
    </p>

    <% if lecture.talks.any? %>
      <div class="row masonry-grid">
        <% lecture.talks.each do |t| %>
            <%= render partial: 'lectures/edit/talk',
                       locals: { talk: t } %>
        <% end %>
      </div>
    <% else %>
      <span data-cy="no-talks-yet">
        <%= t('admin.lecture.no_talks') %>
      </span>
    <% end %>
  </div>
</div>
