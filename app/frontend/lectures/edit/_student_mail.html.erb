<%# Mail to the students of the groups the staff pick, and the staff's audit trail. %>
<hr class="lecture-pane-separator">
<% catalog = StudentMessages::Catalog.new(lecture, current_user) %>
<div class="card mt-4" data-testid="student-mail-card">
  <div class="card-header">
    <h5 class="mb-0">
      <i class="far fa-envelope me-2" aria-hidden="true"></i>
      <%= t("student_message.title") %>
    </h5>
  </div>
  <div class="card-body">
    <%= render partial: "student_messages/form",
               locals: { lecture: lecture, catalog: catalog, fixed_audience: nil,
                         return_to: edit_lecture_path(lecture, tab: "communication") } %>

    <%= render partial: "student_messages/sent",
               locals: { messages: lecture.student_messages.staff
                                          .order(created_at: :desc).limit(10) } %>
  </div>
</div>
