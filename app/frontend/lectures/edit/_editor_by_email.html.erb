<%# locals: (lecture:, email: nil, error: nil) %>
<div id="lecture-editor-by-email">
  <%= form_with url: lecture_editors_path(lecture), method: :post, local: true,
                data: { turbo_stream: true }, class: 'mb-3' do |f| %>
    <%= f.label :email, t('admin.lecture.editors_by_email.label'),
                for: 'lecture-editor-email', class: 'form-label' %>
    <div class="row g-2">
      <div class="col-12 col-md-8">
        <%= f.email_field :email, value: email, required: true, autocomplete: 'off',
                                  id: 'lecture-editor-email',
                                  class: class_names('form-control form-control-sm', 'is-invalid': error),
                                  aria: { invalid: error.present?,
                                          describedby: error ? 'lecture-editor-error' : 'lecture-editor-hint' } %>
        <% if error %>
          <div id="lecture-editor-error" class="invalid-feedback"><%= error %></div>
        <% end %>
      </div>
      <div class="col-auto">
        <%= f.submit t('admin.lecture.editors_by_email.add'), class: 'btn btn-sm btn-outline-primary' %>
      </div>
    </div>
    <div id="lecture-editor-hint" class="form-text">
      <%= t('admin.lecture.editors_by_email.hint') %>
    </div>
  <% end %>
</div>
