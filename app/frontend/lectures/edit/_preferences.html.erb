<%= form_with model: lecture,
              local: true,
              data: { turbo: true,
                      action: "change->lecture-edit#markUnsaved",
                      lecture_edit_warning_param: "lecture-preferences-warning" },
              html: { id: 'lecture-preferences-form' } do |f| %>

  <%# ---------- Preferences ---------- %>
  <section class="pref-section">
    <h3 class="lecture-pane-header"><%= t('basics.preferences') %></h3>

    <div class="pref-grid">
      <% unless lecture.course.term_independent %>
        <div class="pref-field">
          <%= f.label :term_id, t('basics.term'), class: "form-label" %>
          <%= helpdesk(t('admin.lecture.info.term'), false) %>
          <%= f.select :term_id, options_for_select(@terms, lecture.term&.id),
                       {}, { class: 'form-select' } %>
        </div>

        <div class="pref-field">
          <%= f.label :sort, t('basics.type'), class: "form-label" %>
          <%= f.select :sort, options_for_select(Lecture.select_sorts, lecture.sort),
                       {}, { class: 'form-select' } %>
        </div>
      <% end %>

      <% unless lecture.seminar? %>
        <div class="pref-field">
          <%= f.label :start_chapter, t('admin.lecture.first_chapter'), class: "form-label" %>
          <%= helpdesk(t('admin.lecture.info.first_chapter'), false) %>
          <%= f.number_field :start_chapter, value: lecture.start_chapter || 1,
                             class: 'form-control' %>
        </div>

        <div class="pref-field" id="start-section-input">
          <%= f.label :start_section, t('admin.lecture.first_section'), class: "form-label" %>
          <%= helpdesk(t('admin.lecture.info.first_section'), false) %>
          <%= f.number_field :start_section, value: lecture.start_section || 1,
                             class: 'form-control',
                             data: { lecture_edit_target: "startSection" },
                             disabled: !lecture.absolute_numbering %>
        </div>

        <div class="pref-field pref-field--switch">
          <div class="form-check form-switch">
            <%= f.check_box :absolute_numbering,
                            class: 'form-check-input',
                            role: 'switch',
                            data: { action: "change->lecture-edit#toggleStartSection" } %>
            <%= f.label :absolute_numbering, t('admin.lecture.absolute_numbering'),
                        class: 'form-check-label' %>
            <%= helpdesk(t('admin.lecture.info.absolute_numbering'), false) %>
          </div>
        </div>
      <% end %>

      <div class="pref-field pref-field--full">
        <fieldset class="pref-field pref-field--full">
          <legend class="form-label">
            <%= t('basics.teaching_language') %>
            <%= helpdesk(t('admin.lecture.info.language'), false) %>
          </legend>

          <div class="btn-group" role="group">
            <% I18n.available_locales.each do |locale| %>
              <%= f.radio_button :locale, locale.to_s, class: 'btn-check', id: "locale_#{locale}" %>
              <%= f.label :locale, t('locales.' + locale.to_s),
                          for: "locale_#{locale}", class: 'btn btn-outline-primary btn-sm' %>
            <% end %>
          </div>
        </fieldset>
      </div>

      <% unless lecture.seminar? %>
        <div class="pref-field pref-field--full">
          <span class="form-label"><%= t('admin.lecture.content_mode') %></span>
          <%= helpdesk(t('admin.lecture.info.variants'), true) %>
          <div>
            <div class="form-check form-check-inline">
              <%= f.radio_button :content_mode, 'video', class: 'form-check-input' %>
              <%= f.label :content_mode, t('admin.lecture.video_based'),
                          value: 'video', class: 'form-check-label' %>
            </div>
            <div class="form-check form-check-inline">
              <%= f.radio_button :content_mode, 'manuscript', class: 'form-check-input' %>
              <%= f.label :content_mode, t('admin.lecture.script_based'),
                          value: 'manuscript', class: 'form-check-label' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <%# ---------- Students & access ---------- %>
  <section class="pref-section">
    <h3 class="lecture-pane-header"><%= t('admin.lecture.students_and_access') %></h3>

    <div class="pref-grid">
      <div class="pref-field pref-field--full">
        <%= f.label :passphrase, t('admin.lecture.passphrase'), class: "form-label" %>
        <%= helpdesk(t('admin.lecture.info.passphrase'), false) %>
        <%= f.text_field :passphrase, class: 'form-control' %>
      </div>

      <div class="pref-field pref-field--full">
        <span class="form-label"><%= t('admin.lecture.submission_deletion_date') %></span>
        <%= helpdesk(t('admin.lecture.info.submission_deletion_date'), false) %>
        <% current = lecture.submission_deletion_date
                            &.strftime(I18n.t("date.formats.concise")) %>
        <% dates = Term.possible_deletion_dates_localized %>
        <% current = dates.last unless dates.include?(current) %>
        <div>
          <% dates.each do |date_str| %>
            <div class="form-check form-check-inline">
              <%= f.radio_button :submission_deletion_date, date_str,
                                 class: "form-check-input",
                                 checked: date_str == current %>
              <%= f.label :submission_deletion_date, date_str,
                          value: date_str, class: "form-check-label" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="pref-switches">
      <div class="form-check form-switch">
        <%= f.check_box :vignettes, class: 'form-check-input', role: 'switch' %>
        <%= f.label :vignettes, t('admin.lecture.uses_vignettes'), class: 'form-check-label' %>
        <%= helpdesk(t('admin.lecture.info.vignettes'), false) %>
      </div>

      <% unless lecture.term %>
        <div class="form-check form-switch">
          <%= f.check_box :disable_teacher_display, class: 'form-check-input', role: 'switch' %>
          <%= f.label :disable_teacher_display, t('admin.lecture.disable_teacher_display'),
                      class: 'form-check-label' %>
          <%= helpdesk(t('admin.lecture.info.disable_teacher_display'), false) %>
        </div>
      <% end %>

      <% unless lecture.seminar? %>
        <div class="form-check form-switch">
          <%= f.check_box :uses_exam_eligibility, class: 'form-check-input', role: 'switch' %>
          <%= f.label :uses_exam_eligibility, t('admin.lecture.uses_exam_eligibility'),
                      class: 'form-check-label' %>
          <%= helpdesk(t('admin.lecture.info.uses_exam_eligibility'), false) %>

          <% if lecture.uses_exam_eligibility? %>
            <% kept = lecture.student_performance_certifications.count %>
            <% if kept.positive? %>
              <div class="form-text text-warning-emphasis">
                <i class="bi bi-info-circle me-1"></i>
                <%= t('admin.lecture.info.eligibility_data_kept', count: kept) %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <div class="row">
    <div class="col-12 text-center">
      <div id="lecture-preferences-warning">
        <%= t('warnings.unsaved_changes') %>
        <%= hidden_field_tag :subpage, "settings" %>
        <%= f.submit t('buttons.save'), class: "btn btn-primary btn-sm" %>
        <button type="button" id="cancel-lecture-preferences"
                data-action="click->lecture-edit#reload"
                class="btn btn-sm btn-secondary">
          <%= t('buttons.cancel') %>
        </button>
      </div>
    </div>
  </div>
<% end %>


<% if lecture_deletable?(lecture) %>
  <% lecture_name = lecture.title %> <%# use whatever string is shown as the lecture's name %>

  <section class="pref-danger">
    <h3 class="pref-danger__title">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      <%= t('admin.lecture.danger_zone') %>
    </h3>
    <p class="pref-danger__subtitle"><%= t('admin.lecture.danger_zone_hint') %></p>

    <div class="alert alert-danger d-flex align-items-center py-2 small" role="alert">
      <i class="bi bi-exclamation-triangle me-2"></i>
      <%= t('admin.lecture.danger_zone_warning') %>
    </div>

    <div class="pref-danger__row">
      <span class="pref-danger__icon"><i class="bi bi-trash"></i></span>
      <div class="pref-danger__text">
        <div class="pref-danger__row-title"><%= t('admin.lecture.delete_title') %></div>
        <small class="text-body-secondary"><%= t('admin.lecture.info.delete') %></small>
      </div>
      <button type="button"
              class="btn btn-sm btn-danger"
              data-bs-toggle="modal"
              data-bs-target="#deleteLectureModal">
        <%= t("buttons.delete") %>
      </button>
    </div>
  </section>

  <div class="modal fade" id="deleteLectureModal" tabindex="-1"
       aria-labelledby="deleteLectureModalLabel" aria-hidden="true"
       data-controller="delete-lecture-confirm"
       data-delete-lecture-confirm-expected-value="<%= lecture_name %>"
       data-action="hidden.bs.modal->delete-lecture-confirm#reset">
    <div class="modal-dialog modal-dialog-centered">
      <%= form_with url: lecture_path(lecture), method: :delete, class: "modal-content" do %>
        <div class="modal-header">
          <h5 class="modal-title text-danger" id="deleteLectureModalLabel">
            <%= t('admin.lecture.delete_modal_title') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"
                  aria-label="<%= t('buttons.close') %>"></button>
        </div>

        <div class="modal-body">
          <p><%= lecture_destruction_confirmation(lecture) %></p>
          <p class="mb-2">
            <%= t('admin.lecture.delete_modal_prompt') %>
            <strong class="user-select-all"><%= lecture_name %></strong>
          </p>
          <input type="text"
                 class="form-control"
                 autocomplete="off"
                 aria-label="<%= t('admin.lecture.delete_modal_input_label') %>"
                 data-delete-lecture-confirm-target="input"
                 data-action="input->delete-lecture-confirm#check">
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <%= t('buttons.cancel') %>
          </button>
          <button type="submit" class="btn btn-danger" disabled
                  data-delete-lecture-confirm-target="submit">
            <%= t('admin.lecture.delete_modal_confirm') %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>