<% bookmarked = @subscribed_lecture_ids&.include?(lecture.id) || false %>
<% registered = @registered_lecture_ids&.include?(lecture.id) ||
                @rosterized_lecture_ids&.include?(lecture.id) %>
<%# @self_enrollable_lecture_ids ignores whether the user is a member, so it
    may only be consulted once being registered has been ruled out %>
<% registration_possible = !registered &&
                           (registration_open?(lecture) ||
                            @self_enrollable_lecture_ids&.include?(lecture.id)) %>
<%# Anyone not yet registered can bookmark - even when a registration is open,
    they may want to keep the lecture in view before deciding. Someone already
    registered sees it in their "Registered" band, so bookmarking is moot. %>
<% bookmarkable = !registered %>
<%# term is redundant on the dashboard, where the picker above already names
    the semester; still shown on /search/index, which spans all semesters %>
<% show_term = @show_term.nil? ? true : @show_term %>

<% wrap_attributes = {
     class: ["lecture-search-result-wrap",
             ("is-bookmarked" if bookmarkable && bookmarked)],
   } %>
<% if bookmarkable %>
  <% wrap_attributes[:data] = {
       controller: "bookmark",
       bookmark_url_value: dashboard_bookmark_path(lecture),
       bookmark_bookmarked_value: bookmarked,
       bookmark_lecture_id_value: lecture.id,
     } %>
<% end %>

<%= tag.div(**wrap_attributes) do %>

  <%= link_to lecture, class: "lecture-search-result-link",
                       "data-testid": "lecture-search-result-card" do %>
    <div class="lecture-search-result glass row g-0">

      <div class="col-md-3">
        <%= image_tag(lecture.course.normalized_image_file ?
                        image_course_path(lecture.course,
                                          variant: "normalized") :
                        "/no_course_information.png",
                      class: "lecture-search-result-image",
                      alt: lecture.title_no_term) %>
      </div>

      <div class="col-md-9">
        <div class="lecture-search-result-body">
          <h5 class="lecture-search-result-title">
            <%= lecture.title_no_term %>
          </h5>
          <div class="lecture-search-result-info">
            <%# "Registered" is already carried by the marker on the right edge;
                only the open-registration hint stays as a badge here. %>
            <% if registration_possible %>
              <span class="badge bg-primary lecture-search-result-registration"
                    data-testid="lecture-search-registration-badge">
                <%= t('lecture.search.registration_open') %>
              </span>
            <% end %>
            <% if lecture.term && show_term %>
              <span class="lecture-search-result-term">
                <%= lecture.term.to_label_short %>
              </span>
            <% end %>
            <% unless lecture.disable_teacher_display %>
              <span class="lecture-search-result-teacher">
                <%= lecture.teacher.name %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

    </div>
  <% end %>

  <%# The controls on the right edge, over the card's own link. A registered
      lecture shows only a marker; otherwise the user can bookmark it, and also
      jump to the lecture home to register while that is open. %>
  <div class="lecture-search-result-controls">
    <% if registered %>
      <span class="lecture-search-result-control is-registered"
            role="img"
            aria-label="<%= t('lecture.search.registered_status') %>"
            title="<%= t('lecture.search.registered_status') %>"
            data-testid="lecture-search-registered-control">
        <i class="fas fa-user-check" aria-hidden="true"></i>
      </span>
    <% else %>
      <% if registration_possible %>
        <%= link_to lecture_home_path(lecture),
                    class: "lecture-search-result-control " \
                           "lecture-search-result-register",
                    title: t("lecture.search.go_register"),
                    "aria-label": t("lecture.search.go_register"),
                    data: { testid: "lecture-search-register-link" } do %>
          <i class="fas fa-plus" aria-hidden="true"></i>
        <% end %>
      <% end %>

      <button type="button"
              class="lecture-search-result-control lecture-search-result-bookmark"
              data-bookmark-target="button"
              data-action="bookmark#toggle"
              aria-pressed="<%= bookmarked %>"
              aria-label="<%= t('lecture.search.bookmark') %>"
              title="<%= t('lecture.search.bookmark') %>"
              data-testid="lecture-search-bookmark-button">
        <i class="<%= bookmarked ? 'fas' : 'far' %> fa-bookmark"
           data-bookmark-target="icon"
           aria-hidden="true"></i>
      </button>
    <% end %>
  </div>
<% end %>
