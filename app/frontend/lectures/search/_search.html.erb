<%= vite_stylesheet_tag "lectures/search/_search.scss" %>

<div id="lecture-search"
     data-controller="lecture-search"
     data-testid="lecture-search">

  <div id="lecture-search-wrapper" class="glass">
    <% if @available_terms.present? %>
      <%= render(DashboardTermSelectComponent.new(
        terms: @available_terms,
        selected: @selected_term,
        next_term_lecture_count: @next_term_lecture_count,
        id: "lecture-search-term-select",
        anchor: "lecture-search"
      )) %>
    <% end %>

    <%= form_with url: search_lectures_path,
                  method: :get,
                  data: { remote: false,
                          turbo_stream: true,
                          lecture_search_target: "form" } do |f| %>

      <%# Scopes the results to the semester the dashboard's picker points at.
          Server-rendered, so the search and the dashboard above it always
          agree on the term. %>
      <%= hidden_field_tag "search[term]", @selected_term&.dashboard_param,
                           id: "lecture-search-term-field" %>

      <%# The term on each result card is redundant when the search is already
          scoped to one semester (the dashboard); callers that span all
          semesters pass show_term: true. %>
      <%= hidden_field_tag "search[show_term]",
                           local_assigns.fetch(:show_term, true) ? "1" : "0",
                           id: "lecture-search-show-term-field" %>

      <div id="lecture-search-input-group">
        <%= f.text_field "search[fulltext]",
                          class: "form-control",
                          id: "lecture-search-bar",
                          placeholder: t('lecture.search.placeholder'),
                          "aria-label": t('lecture.search.placeholder'),
                          data: { action: "input->lecture-search#search",
                                  testid: "lecture-search-bar" } %>
        <i class="fas fa-search" id="lecture-search-icon"></i>
      </div>

      <%# Widens one search without moving the dashboard to another semester,
          so it is not remembered either. %>
      <% if @available_terms.to_a.size > 1 %>
        <div class="form-check form-switch mt-2 ms-3">
          <%= check_box_tag "search[all_terms]", "1", false,
                            id: "lecture-search-all-terms",
                            class: "form-check-input",
                            role: "switch",
                            data: { lecture_search_target: "allTerms",
                                    action: "change->lecture-search#search" } %>
          <%= label_tag "lecture-search-all-terms", t("lecture.search.all_terms"),
                        class: "form-check-label" %>
        </div>
      <% end %>

    <% end %>
  </div>

  <div id="lecture-search-results-wrapper">
    <!-- filled via Turbo Stream -->
  </div>

</div>
