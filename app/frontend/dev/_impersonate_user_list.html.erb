<div data-controller="impersonate-list">
  <div
    class="p-2 border-bottom bg-white"
    style="position: sticky; top: 0; z-index: 1; border-radius: 1px;"
  >
    <input
      type="text"
      class="form-control form-control-sm"
      placeholder="Search..."
      autocomplete="off"
      data-impersonate-list-target="search"
      data-action="input->impersonate-list#filter
                   keydown.down->impersonate-list#focusFirstUser:prevent"
    >
  </div>

  <ul class="list-unstyled mb-0 p-1" style="max-height: <%= max_height %>; overflow-y: auto;">
    <% all_users_for_impersonation.each do |id, name| %>
      <li data-username="<%= name.downcase %>" data-impersonate-list-target="user">
        <%= button_to name,
                      dev_impersonate_path(id),
                      class: "dropdown-item rounded-2",
                      form: { data: { turbo: false } } %>
      </li>
    <% end %>
  </ul>
</div>
