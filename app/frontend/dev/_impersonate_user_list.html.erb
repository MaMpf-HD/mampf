<div data-impersonate-list>
  <div
    class="p-2 border-bottom bg-white"
    style="position: sticky; top: 0; z-index: 1; border-radius: 1px;"
  >
    <input
      type="text"
      class="form-control form-control-sm"
      placeholder="Search..."
      autocomplete="off"
      oninput="
        const q = this.value.toLowerCase();
        this.closest('[data-impersonate-list]')
            .querySelectorAll('li[data-username]')
            .forEach(li => {
              li.style.display =
                li.dataset.username.includes(q) ? '' : 'none';
            });
      "
    >
  </div>

  <ul class="list-unstyled mb-0" style="max-height: <%= max_height %>; overflow-y: auto;">
    <% all_users_for_impersonation.each do |id, name| %>
      <li data-username="<%= name.downcase %>">
        <%= button_to name,
                      dev_impersonate_path(id),
                      class: "dropdown-item",
                      form: { data: { turbo: false } } %>
      </li>
    <% end %>
  </ul>
</div>
