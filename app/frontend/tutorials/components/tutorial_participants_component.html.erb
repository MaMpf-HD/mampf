<div class="m-3" data-testid="tutorial-participants">
  <h2 class="h6">
    <%= t("tutorial.participants.title") %>
    <span class="badge text-bg-light ms-1"><%= members.size %></span>
  </h2>

  <% if members.any? %>
    <%= render "tutorials/participants_table", users: members, css: "mb-4",
                                                summary: program_summary(members) %>
  <% else %>
    <p class="text-muted mb-4"><%= t("tutorial.participants.none") %></p>
  <% end %>

  <% if allocation_pending? %>
    <p class="text-muted small">
      <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>

      <%= t("tutorial.participants.allocation_pending",
            campaign: campaign_title,
            deadline: l(campaign.registration_deadline, format: :short)) %>
    </p>
  <% elsif running_item %>
    <h2 class="h6">
      <%= t("tutorial.participants.registered_title") %>
      <span class="badge text-bg-light ms-1"><%= registered.size %></span>
    </h2>
    <p class="text-muted small">
      <%= t("tutorial.participants.registered_hint", campaign: campaign_title) %>
    </p>
    <% if registered.any? %>
      <%= render "tutorials/participants_table", users: registered, css: "",
                                                  summary: program_summary(registered) %>
    <% end %>
  <% end %>
</div>
