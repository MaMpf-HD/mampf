<%= helpers.turbo_frame_tag "pointing-table" do %>
  <% if rows? %>
    <div data-controller="status-filter paper-selection">
      <% if grading_enabled? %>
        <div class="d-flex gap-2 m-3 align-items-center">
          <div class="d-flex align-items-center">
            <input
              type="text"
              class="form-control form-control-sm w-auto"
              placeholder="<%= t('assessment.grading_tutorial.filter_name') %>"
              autocomplete="off"
              data-action="input->status-filter#search"
            >
          </div>

          <div
            class="d-flex gap-2 align-items-center"
            data-status-filter-target="activeFilters"
          ></div>

          <%# The rows' checkboxes belong to this form by its id. %>
          <% if can_enter_points? %>
            <%= form_with url: mark_users_as_participated_path,
                          method: :patch,
                          id: "paper-hand-ins",
                          local: true,
                          class: "ms-auto",
                          data: { turbo: true } do %>
              <input
                type="hidden"
                name="assignment_id"
                value="<%= @assignment.id %>"
              >

              <input
                type="hidden"
                name="tutorial_id"
                value="<%= @tutorial&.id %>"
              >

              <input
                type="hidden"
                name="grading_scope_type"
                value="<%= @grading_scope.class.name.downcase %>"
              >

              <button
                type="submit"
                class="btn btn-outline-secondary btn-sm"
                disabled
                data-paper-selection-target="button"
              >
                <i class="bi bi-file-earmark-check me-1"></i>
                <%= t('assessment.grading_tutorial.paper_hand_in_selected') %>
              </button>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div
        class="table-wrapper"
        data-mode="<%= @mode %>"
        data-controller="table-fade"
      >
        <div class="table-overflow" data-table-fade-target="inner">
          <table
            class="table align-middle my-3"
            data-cy="tutorial-submissions-table"
          >
            <thead style="background: #fafafa;">
              <%= render(PointingTableHeaderComponent.new(
                grading_scope: @grading_scope,
                grading_enabled: grading_enabled?,
                tasks: tasks,
                total_max_points: total_max_points,
                accepted_file_type: @assignment.accepted_file_type,
                tutorials: @tutorials,
                status_without_hand_in: @assignment.assessment&.status_without_hand_in
              )) %>
            </thead>

            <tbody>
              <% if @mode == "tutor" %>
                <% @stack.each do |submission| %>
                  <%= render(SubmissionRowComponent.new(
                      submission: submission,
                      assignment: @assignment,
                      grading_scope: @tutorial,
                      participations: team_participations(submission))) %>
                <% end %>
                <% @non_submitters.each do |user| %>
                  <%= render(ParticipationRowComponent.new(
                      participation: participation_for(user, @tutorial),
                      assessment: @assignment.assessment,
                      grading_scope: @tutorial)) %>
                <% end %>
              <% else %>
                <% @tutorials.each do |tutorial| %>
                  <% (@submissions_by_tutorial[tutorial] || []).each do |submission| %>
                    <%= render(SubmissionRowComponent.new(
                        submission: submission,
                        assignment: @assignment,
                        grading_scope: @lecture,
                        participations: team_participations(submission))) %>
                  <% end %>

                  <% (@non_submitters_by_tutorial[tutorial] || []).each do |user| %>
                    <%= render(ParticipationRowComponent.new(
                        participation: participation_for(user, tutorial),
                        assessment: @assignment.assessment,
                        grading_scope: @lecture)) %>
                  <% end %>
                <% end %>
                <% @non_tutorial_participants.each do |user| %>
                  <%= render(ParticipationRowComponent.new(
                      participation: participation_for(user, nil),
                      assessment: @assignment.assessment,
                      grading_scope: @lecture)) %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% else %>
    <div class="jumbotron mt-3">
      <%= t('assessment.grading_tutorial.no_submissions') %>
    </div>
  <% end %>
<% end %>
