<%= helpers.turbo_frame_tag "pointing-table" do %>
  <% if rows? %>
    <div data-controller="pointing-table status-filter">
      <div class="my-3">
        <%= render toolbar %>
      </div>

      <div
        class="table-wrapper"
        style="<%= layout.css_vars %>"
        data-controller="table-fade"
      >
        <div class="table-overflow" data-table-fade-target="inner">
          <table
            class="table align-middle my-3"
            data-cy="tutorial-submissions-table"
          >
            <thead>
              <%= render(PointingTableHeaderComponent.new(
                assessable: @assignment,
                layout: layout,
                sort_url: sort_url,
                sort_dir: sorted? ? dir : nil
              )) %>
            </thead>

            <tbody>
              <% rows.each do |row| %>
                <% if row.submission %>
                  <%= render(SubmissionRowComponent.new(
                      submission: row.submission,
                      assignment: @assignment,
                      grading_scope: @grading_scope,
                      participations: team_participations(row.submission))) %>
                <% else %>
                  <%= render(ParticipationRowComponent.new(
                      participation: participation_for(row.user, row.tutorial),
                      assessment: @assignment.assessment,
                      grading_scope: @grading_scope)) %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-muted my-3" hidden data-status-filter-target="empty">
        <%= t("assessment.grading_tutorial.filter_no_match") %>
      </p>
    </div>
  <% else %>
    <div class="jumbotron mt-3">
      <%= t('assessment.grading_tutorial.no_submissions') %>
    </div>
  <% end %>
<% end %>
