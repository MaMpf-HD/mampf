<tr
  id="<%= row_id %>"
  is="turbo-frame"
  class="submission-row <%= helpers.submission_late_color(@submission) %>"
  data-id="<%= @submission.id %>"
  data-controller="participation-row"
  data-row-id="<%= @submission.id %>"
  data-row-target-type="submission"
  data-action="dirty->pointing-table#rowDirty clean->pointing-table#rowClean"
  data-status-filter-status="<%= status %>"
  data-status-filter-tutorial="<%= @submission.tutorial_id %>"
  data-status-filter-name="<%= @submission.users.map(&:tutorial_name).join(', ') %>"
>
  <!-- Column 1: User names + copy emails + late icon -->
  <td class="sticky-col team-col">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <% @submission.users.each do |user| %>
          <div>
            <%= user.tutorial_name %>
            <% movement = movement_info_for_user(user) %>

            <% if movement %>
              <i
                class="bi bi-info-circle me-2 ps-1"
                title="<%= movement %>"
                data-bs-toggle="tooltip"
              ></i>
            <% end %>
          </div>
        <% end %>

        <% if @submission.too_late? %>
          <i
            class="fas fa-exclamation-triangle"
            data-bs-toggle="tooltip"
            title="<%= late_submission_info(@submission, @submission.tutorial) %>"
          ></i>
        <% end %>
      </div>

      <button
        type="button"
        class="
          clipboardpopup btn btn-link p-0 ms-3 text-secondary
          clipboard-btn clipboard-button
        "
        data-clipboard-text="<%= @submission.users.map(&:email).join(', ') %>"
        data-id="<%= @submission.id %>"
        title="<%= t('buttons.copy_email_to_clipboard') %>"
        aria-label="<%= t('buttons.copy_email_to_clipboard') %>"
      >
        <i class="bi bi-clipboard"></i>

        <span
          class="clipboardpopuptext token-clipboard-popup"
          data-id="<%= @submission.id %>"
        >
          <%= t('basics.emails_copied_to_clipboard') %>
        </span>
      </button>
    </div>
  </td>

  <!-- Column 1.5: Tutorial -->
  <% if @mode == "teacher" %>
    <td class="text-center sticky-col tutorial-col">
      <span><%= @submission.tutorial&.title %></span>
    </td>
  <% end %>

  <% if grading_enabled? %>
    <!-- Column 4: Status -->
    <td class="text-center sticky-col status-col" data-mode="<%= @mode %>">
      <% if participation %>
        <%= render ParticipationStatusBadgeComponent.new(status: status, variant: :full) %>
      <% end %>
    </td>
    <!-- batch of columns 3: grade zone -->
    <!-- support point by task -->
    <% tasks.each do |task| %>
      <%= task_points_cell(task, allow_grading?) %>
    <% end %>
    <!-- Column 4: Total Points -->
    <td class="text-center sticky-col total-col" data-mode="<%= @mode %>">
      <span data-participation-row-target="totalPoints">0</span>
    </td>
    <!-- Save and refresh the row's points -->
    <td class="text-center sticky-col save-col" data-mode="<%= @mode %>">
      <% if can_enter_points? %>
        <div class="d-inline-flex align-items-center gap-1">
          <%= form_with url: point_submission_tutorial_path(
            @submission,
            grading_scope_type: @grading_scope.class.name.downcase),
                      method: :patch,
                      data: { turbo: true, participation_row_target: "form" },
                      html: { style: "display:none;" } do %>
            <input
              type="hidden"
              name="task_points"
              data-participation-row-target="payload"
            >
          <% end %>

          <%= save_row_button(allow_grading?) %>

          <%= form_with url: refresh_point_submission_tutorial_path(
            @submission,
            grading_scope_type: @grading_scope.class.name.downcase),
                      method: :patch,
                      data: { turbo: true, participation_row_target: "refreshForm" },
                      html: { style: "display:none;" } do %>
            <input
              type="hidden"
              name="task_points"
              data-participation-row-target="payload"
            >
          <% end %>

          <%= refresh_row_button(allow_grading?) %>
        </div>
      <% end %>
    </td>
  <% end %>

  <!-- The hand-in: the file, and for a late one the tutor's decision -->
  <td
    class="text-center sticky-col hand-in-col"
    data-mode="<%= @mode %>"
    data-id="<%= @submission.id %>"
  >
    <div class="d-inline-flex align-items-center gap-1">
      <%= link_to show_submission_manuscript_path(@submission, params: { download: 'true' }),
                class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2 py-1 lh-1",
                data: { turbo: false },
                title: t('assessment.grading_tutorial.download_hand_in'),
                aria: { label: t('assessment.grading_tutorial.download_hand_in') } do %>
        <i class="bi bi-download"></i>
      <% end %>

      <% unless @submission.assignment.accepted_file_type.in?(Assignment.non_inline_file_types) %>
        <%= link_to show_submission_manuscript_path(@submission),
                  class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2 py-1 lh-1",
                  data: { turbo: false },
                  title: t('assessment.grading_tutorial.show_hand_in'),
                  aria: { label: t('assessment.grading_tutorial.show_hand_in') } do %>
          <i class="bi bi-eye"></i>
        <% end %>
      <% end %>

      <% if helpers.current_user.in?(@submission.tutorial.tutors) %>
        <%= render partial: 'submissions/other_actions',
                  locals: { submission: @submission, grading_scope: @grading_scope} %>
      <% end %>
    </div>
  </td>

  <!-- The correction: the tutor's to upload and remove, anybody else's to read -->
  <% if @mode == "tutor" %>
    <td
      class="text-center sticky-col correction-col"
      data-id="<%= @submission.id %>"
    >
      <% if helpers.current_user.in?(@submission.tutorial.tutors) %>
        <%= render partial: 'submissions/correction_column',
                  locals: { submission: @submission } %>
      <% else %>
        <%= render partial: 'submissions/download',
                  locals: { submission: @submission } %>
      <% end %>
    </td>
  <% end %>
</tr>
