<%= helpers.turbo_frame_tag "marking-table" do %>
  <% if rows? %>
    <div data-controller="marking-table status-filter">
      <div class="my-3">
        <%= render toolbar %>
      </div>

      <% if tasks.any? %>
        <p class="text-muted small mb-0">
          <%= t("assessment.grading_tutorial.blank_points_hint") %>
        </p>
      <% end %>

      <% if @assignment.kind_test? %>
        <p
          class="small text-warning-emphasis mt-2 mb-0"
          hidden
          data-marking-table-target="outdated"
        >
          <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
          <%= t("assessment.grading_tutorial.passing_points_changed") %>

          <button
            type="button"
            class="btn btn-link btn-sm p-0 align-baseline"
            data-action="marking-table#reload"
          >
            <%= t("assessment.grading_tutorial.reload_table") %>
          </button>
        </p>
      <% end %>

      <div
        class="table-wrapper"
        style="<%= layout.css_vars %>"
        data-controller="table-fade"
      >
        <div class="table-overflow" data-table-fade-target="inner">
          <table class="table align-middle my-3">
            <thead>
              <%= render(MarkingTableHeaderComponent.new(
                assessable: @assignment,
                layout: layout
              )) %>
            </thead>

            <tbody>
              <% if @mode == "tutor" %>
                <% @stack.each do |submission| %>
                  <%= render(SubmissionRowComponent.new(
                      submission: submission,
                      assignment: @assignment,
                      grading_scope: @tutorial,
                      participations: team_participations(submission),
                      addable_members: @addable_members,
                      member_tutorials: membership_tutorials)) %>
                <% end %>
                <% @elsewhere.each do |submission| %>
                  <%= render(SubmissionRowComponent.new(
                      submission: submission,
                      assignment: @assignment,
                      grading_scope: @tutorial,
                      participations: team_participations(submission),
                      member_tutorials: membership_tutorials)) %>
                <% end %>
                <% if grading_enabled? %>
                  <% @non_submitters.each do |user| %>
                    <%= render(ParticipationRowComponent.new(
                        participation: participation_for(user, @tutorial),
                        assessment: @assignment.assessment,
                        grading_scope: @tutorial)) %>
                  <% end %>
                <% end %>
              <% else %>
                <% @tutorials.each do |tutorial| %>
                  <% (@submissions_by_tutorial[tutorial] || []).each do |submission| %>
                    <%= render(SubmissionRowComponent.new(
                        submission: submission,
                        assignment: @assignment,
                        grading_scope: @lecture,
                        participations: team_participations(submission),
                        addable_members: @addable_by_tutorial[tutorial] || [],
                        member_tutorials: membership_tutorials)) %>
                  <% end %>

                  <% if grading_enabled? %>
                    <% (@non_submitters_by_tutorial[tutorial] || []).each do |user| %>
                      <%= render(ParticipationRowComponent.new(
                          participation: participation_for(user, tutorial),
                          assessment: @assignment.assessment,
                          grading_scope: @lecture)) %>
                    <% end %>
                  <% end %>
                <% end %>
                <% if grading_enabled? %>
                  <% @non_tutorial_participants.each do |user| %>
                    <%= render(ParticipationRowComponent.new(
                        participation: participation_for(user, nil),
                        assessment: @assignment.assessment,
                        grading_scope: @lecture)) %>
                  <% end %>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-muted my-3" hidden data-status-filter-target="empty">
        <%= t("assessment.grading_tutorial.filter_no_match") %>
      </p>
    </div>
  <% else %>
    <div class="jumbotron mt-3">
      <%= t('assessment.grading_tutorial.no_submissions') %>
    </div>
  <% end %>
<% end %>
