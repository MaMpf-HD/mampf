<% if grading_enabled? %>
  <%= render summary %>
<% end %>

<%= render PointingFilterComponent.new(
  id: @assignment.id,
  status_options: (status_options if grading_enabled?),
  tutorial_options: (tutorial_options if lecture_form?)
) do %>
  <% if menu? %>
    <div class="dropdown">
      <button
        type="button"
        class="btn btn-outline-secondary btn-sm dropdown-toggle"
        data-bs-toggle="dropdown"
        aria-expanded="false"
      >
        <%= t("assessment.grading_tutorial.more_actions") %>
      </button>

      <ul class="dropdown-menu dropdown-menu-end">
        <% if tutor? && hand_in_files? %>
          <li>
            <%= button_tag t("submission.bulk_upload"),
                           type: "button",
                           class: "dropdown-item",
                           id: "show-bulk-upload-area",
                           disabled: !upload_open?,
                           title: (t("assessment.grading_tutorial.upload_correction_closed") unless upload_open?) %>
          </li>
        <% end %>

        <% if hand_in_files? %>
          <li>
            <%= link_to t("submission.bulk_download_submissions"),
                        bulk_download_submissions_path(id: @tutorial.id, ass_id: @assignment.id),
                        class: "dropdown-item",
                        data: { turbo: false } %>
          </li>
        <% end %>

        <% if corrections? %>
          <li>
            <%= link_to t("submission.bulk_download_corrections"),
                        bulk_download_corrections_path(id: @tutorial.id, ass_id: @assignment.id),
                        class: "dropdown-item",
                        data: { turbo: false } %>
          </li>
        <% end %>

        <% if hand_in_files? %>
          <li>
            <%= link_to t("tutorial.teams_as_csv"),
                        export_teams_to_csv_path(id: @tutorial.id, ass_id: @assignment.id,
                                                 format: "csv"),
                        class: "dropdown-item",
                        data: { turbo: false } %>
          </li>
        <% end %>

        <% if certificate_check? %>
          <li>
            <%= link_to t("tutorial.certificate_check"),
                        validate_certificate_as_tutor_path(params: { lecture_id: @assignment.lecture.id }),
                        class: "dropdown-item",
                        remote: true %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if can_enter_points? && grading_enabled? %>
    <button
      type="button"
      class="btn btn-success btn-sm"
      disabled
      data-pointing-table-target="bulkSave"
      data-action="click->pointing-table#submitAll"
    >
      <i class="bi bi-floppy-fill me-1"></i>
      <%= t("assessment.grading_tutorial.save_all") %>

      <span
        class="badge text-bg-light ms-1"
        hidden
        data-pointing-table-target="dirtyCount"
      ></span>
    </button>
    <%= form_with url: point_multi_submissions_tutorial_path,
                  method: :patch,
                  local: true,
                  data: { turbo: true, pointing_table_target: "form" },
                  html: { hidden: true } do %>
      <input
        type="hidden"
        name="submissions"
        data-pointing-table-target="payload"
      >

      <input type="hidden" name="assignment_id" value="<%= @assignment.id %>">
      <input type="hidden" name="tutorial_id" value="<%= @tutorial&.id %>">

      <input
        type="hidden"
        name="grading_scope_type"
        value="<%= grading_scope_type %>"
      >
    <% end %>
  <% end %>
<% end %>
