<% I18n.with_locale(lecture.locale_with_inheritance || I18n.default_locale) do %>
  <% assessables_by_type.each do |(type, assessables)| %>
    <% assessables_with_assessment = assessables.select(&:assessment) %>

    <% if type == "Talk" %>
      <p class="text-muted small mb-2">
        <%= t('assessment.info.talks_created_in_roster') %>
      </p>
      <% if assessables_with_assessment.any? %>
        <table class="table table-hover mb-4">
          <thead>
            <tr>
              <th><%= t('basics.title') %></th>
              <th><%= t('assessment.speakers') %></th>
              <th class="text-center"><%= t('assessment.grade') %></th>
              <th><%= t('assessment.date') %></th>
            </tr>
          </thead>

          <tbody id="assessment-talks-list">
            <% assessables_with_assessment.each do |assessable| %>
              <%= render AssessmentListItemComponent.new(assessable: assessable, lecture: lecture) %>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-center text-muted py-3">
          <%= t('assessment.no_talks_yet') %>
        </p>
      <% end %>
    <% elsif type == "Assignment" %>
      <p class="text-muted small mb-2">
        <%= t('assessment.subtitle.assignments') %>
      </p>
      <div class="row mb-3">
        <div class="col-12 text-center">
          <%= link_to t('admin.assignment.new'),
                      new_assignment_path(params: { lecture_id: lecture.id }),
                      class: 'btn btn-sm btn-primary',
                      id: 'newAssignmentButton',
                      data: { turbo_stream: true } %>
        </div>
      </div>
      <div id="assignment_form_container"></div>
      <div id="assessment-assignments-wrapper">
        <% if assessables_with_assessment.any? %>
          <table class="table table-hover mb-4">
            <thead>
              <tr>
                <th><%= t('admin.assignment.title') %></th>
                <th><%= t('medium.singular') %></th>
                <th><%= t('admin.assignment.filetype') %></th>
                <th class="text-center"><%= t('assessment.tasks') %></th>
                <th class="text-center"><%= t('assessment.points') %></th>

                <th class="text-center">
                  <i
                    class="bi bi-cloud-upload"
                    title="<%= t('assessment.requires_submission') %>"
                  ></i>
                </th>

                <th><%= t('assessment.due_at') %></th>
              </tr>
            </thead>

            <tbody id="assessment-assignments-list">
              <% assessables_with_assessment.each do |assessable| %>
                <%= render AssessmentListItemComponent.new(assessable: assessable, lecture: lecture) %>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="text-center text-muted py-4">
            <%= t('assessment.no_assignments_yet') %>
          </div>
        <% end %>
      </div>
      <%= form_with url: assignments_complete_assessment_assessments_path(
                          lecture_id: lecture.id
                        ),
                    method: :patch,
                    data: { controller: "assessments--assignments-complete" },
                    class: "border-top pt-3" do %>
        <%= hidden_field_tag :complete, "0", id: nil %>

        <%= hidden_field_tag :reset_certifications, "0", id: nil,
                             data: {
                               assessments__assignments_complete_target: "reset"
                             } %>

        <div class="form-check">
          <%= check_box_tag :complete, "1", lecture.assignments_complete?,
                            class: "form-check-input",
                            data: {
                              assessments__assignments_complete_target: "checkbox",
                              action: "change->assessments--assignments-complete#change"
                            } %>

          <%= label_tag :complete,
                        t('assessment.assignments_complete.label'),
                        class: "form-check-label" %>
        </div>

        <p class="text-muted small mb-0 mt-1">
          <%= t('assessment.assignments_complete.hint') %>
        </p>

        <%#
          Ticked or unticked, the answer turns every eligibility verdict in the
          lecture over, so neither direction goes through unasked. Only the one
          that would leave computed decisions behind offers a third way.
        %>

        <div
          class="modal fade"
          tabindex="-1"
          aria-labelledby="assignments-complete-title"
          aria-hidden="true"
          data-assessments--assignments-complete-target="dialog"
        >
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="assignments-complete-title">
                  <%= confirmation_title %>
                </h5>
              </div>

              <div class="modal-body">
                <p class="mb-0"><%= confirmation_body %></p>
              </div>

              <div class="modal-footer">
                <button
                  type="button"
                  class="btn btn-outline-secondary"
                  data-action="assessments--assignments-complete#cancel"
                >
                  <%= t('assessment.assignments_complete.cancel') %>
                </button>

                <button
                  type="button"
                  class="btn btn-primary"
                  data-action="assessments--assignments-complete#confirm"
                >
                  <%= confirmation_button %>
                </button>

                <% if confirmation == :reopen %>
                  <button
                    type="button"
                    class="btn btn-outline-danger"
                    data-action="assessments--assignments-complete#reset"
                  >
                    <%= t('assessment.assignments_complete.reopen_dialog.reset') %>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if assessables_by_type.empty? %>
    <div class="text-center text-muted py-4">
      <%= t('assessment.no_assessables_yet') %>
    </div>
  <% end %>

  <% if assessables_by_type["Assignment"]&.any? %>
    <div class="lecture-pane-separator"></div>
    <h5 class="mb-3">
      <%= t('assessment.submission_settings') %>
    </h5>
    <%= helpers.turbo_frame_tag "lecture-submission-settings" do %>
      <%= render "assessment/assessments/submission_settings", lecture: lecture %>
    <% end %>
  <% end %>

  <% if legacy.any? %>
    <div class="lecture-pane-separator"></div>
    <% if legacy_by_type["Assignment"]&.any? %>
      <h5 class="mb-3">
        <%= t('assessment.legacy_assignments') %>
      </h5>
      <p class="text-muted small">
        <%= t('assessment.legacy_assignments_info') %>
      </p>
      <div data-turbo="false">
        <div class="list-group">
          <div class="list-group-item bg-light">
            <div class="row">
              <div class="col-2">
                <h6><%= t('basics.title') %></h6>
              </div>

              <div class="col-4">
                <h6><%= t('basics.deadline') %></h6>
              </div>

              <div class="col-2">
                <h6><%= t('basics.medium') %></h6>
              </div>

              <div class="col-2">
                <h6><%= t('submission.file_format') %></h6>
              </div>

              <div class="col-2">
                <h6><%= t('basics.action') %></h6>
              </div>
            </div>
          </div>

          <% legacy_by_type["Assignment"].each do |assessable| %>
            <%= render 'assignments/row', assignment: assessable %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if legacy_by_type["Talk"]&.any? %>
      <h5 class="mb-3 <%= 'mt-4' if legacy_by_type['Assignment']&.any? %>">
        <%= t('assessment.legacy_talks') %>
      </h5>
      <p class="text-muted small">
        <%= t('assessment.legacy_talks_info') %>
      </p>
      <table class="table">
        <tbody>
          <% legacy_by_type["Talk"].each do |assessable| %>
            <%= render AssessmentListItemComponent.new(
              assessable: assessable,
              lecture: lecture,
              legacy: true
            ) %>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
<% end %>
