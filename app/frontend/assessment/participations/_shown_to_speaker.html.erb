<%# locals: (participation:) %>
<span id="<%= dom_id(participation, :shown_to_speaker) %>">
  <% if participation.result_released? %>
    <i
      class="bi bi-eye ms-1 text-muted"
      role="img"
      aria-label="<%= t("assessment.results_release.shown_to_speaker") %>"
      title="<%= t("assessment.results_release.shown_to_speaker") %>"
    ></i>
  <% end %>
</span>
