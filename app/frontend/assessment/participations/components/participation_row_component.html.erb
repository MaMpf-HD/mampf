<tr
  id="<%= row_id %>"
  is="turbo-frame"
  data-id="<%= @participation.id %>"
  data-controller="participation-row"
  data-row-id="<%= @participation.id %>"
  data-row-target-type="participation"
  data-action="dirty->pointing-table#rowDirty clean->pointing-table#rowClean"
  data-status-filter-status="<%= status %>"
  data-status-filter-tutorial="<%= @participation.tutorial&.id %>"
  data-status-filter-name="<%= @user.tutorial_name %>"
  <% if @group_id %>
    data-status-filter-group-id="<%= @group_id %>"
  <% end %>
>
  <td class="sticky-col team-col">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <%= @user.tutorial_name %>

        <% movement = movement_info_for_user(@user) %>

        <% if movement %>
          <i
            class="bi bi-info-circle me-2 ps-1"
            title="<%= movement %>"
            data-bs-toggle="tooltip"
          ></i>
        <% end %>
      </div>

      <i
        class="
          clipboardpopup bi bi-clipboard clickable
          text-secondary clipboard-btn ms-3 clipboard-button
        "
        data-clipboard-text="<%= @user.email %>"
        data-bs-toggle="tooltip"
        title="<%= t('buttons.copy_email_to_clipboard') %>"
      >
        <span class="clipboardpopuptext token-clipboard-popup">
          <%= t('basics.emails_copied_to_clipboard') %>
        </span>
      </i>
    </div>
  </td>

  <!-- Tutorial (assignment/teacher scope only, regardless of assessment) -->
  <% if show_tutorial_col? %>
    <td class="text-center sticky-col tutorial-col">
      <span>
        <%= @participation.tutorial&.title || t("assessment.grading_tutorial.no_tutorial_badge") %>
      </span>
    </td>
  <% end %>

  <% if grading_enabled? %>
    <td class="text-center sticky-col status-col">
      <%= render ParticipationStatusBadgeComponent.new(status: status, variant: :full) %>
    </td>
    <% if tasks? %>
      <% tasks.each do |task| %>
        <%= task_points_participation_cell(task, allow_grading?) %>
      <% end %>
      <td class="text-center sticky-col total-col">
        <span data-participation-row-target="totalPoints">0</span>
      </td>
    <% end %>

    <% if single_grade? %>
      <!-- Single grade column -->
      <td class="text-center grade-col" style="min-width: 110px;">
        <% if allow_grading? %>
          <%= tag.select(
                name: "grade",
                class: "form-select form-select-sm mx-auto",
                style: "min-width: 90px; width: 90px;",
                data: { participation_row_target: "gradeInput", action: "change->participation-row#onParticipationChanged" }
              ) do %>
            <%= tag.option("—", value: "", selected: grade_numeric.blank?) %>

            <%= safe_join(
                  grade_options.map { |label, value| tag.option(label, value: value, selected: value == grade_numeric) }
                ) %>
          <% end %>
        <% else %>
          <span class="fw-semibold"><%= grade_display %></span>
        <% end %>
      </td>
      <td class="note-col" style="min-width: 180px;">
        <% if allow_grading? %>
          <%= text_area_tag "note", @participation&.note,
                    class: "form-control form-control-sm",
                    placeholder: t("assessment.grading_talk.note_placeholder"),
                    maxlength: 255,
                    rows: 1,
                    data: { participation_row_target: "noteInput", action: "input->participation-row#onParticipationChanged" } %>
        <% else %>
          <span
            class="text-muted small text-truncate d-inline-block"
            style="max-width: 180px;"
            title="<%= @participation&.note %>"
          >
            <%= @participation&.note.presence || "—" %>
          </span>
        <% end %>
      </td>
      <td class="text-muted small graded-by-col"><%= grader_display %></td>
      <td class="text-muted small graded-at-col">
        <% if graded_at_relative %>
          <span title="<%= graded_at_full %>"><%= graded_at_relative %></span>
        <% end %>
      </td>
    <% end %>

    <td class="text-center sticky-col save-col">
      <% if can_enter_points? && points_enterable? %>
        <div class="d-inline-flex align-items-center gap-1">
          <%= form_with url: save_url,
                      method: :patch,
                      data: { turbo: true, participation_row_target: "form" },
                      html: { style: "display:none;" } do %>
            <input
            type="hidden"
            name="task_points"
            data-participation-row-target="taskPointsPayload"
            >

            <input
              type="hidden"
              name="grade"
              data-participation-row-target="gradePayload"
            >

            <input
              type="hidden"
              name="comment"
              data-participation-row-target="notePayload"
            >
          <% end %>

          <%= save_row_button(allow_grading?) %>

          <%= form_with url: refresh_url,
                      method: :patch,
                      data: { turbo: true, participation_row_target: "refreshForm" },
                      html: { style: "display:none;" } do %>
            <input
              type="hidden"
              name="task_points"
              data-participation-row-target="taskPointsPayload"
            >

            <input
              type="hidden"
              name="grade"
              data-participation-row-target="gradePayload"
            >
          <% end %>

          <%= refresh_row_button(allow_grading?) %>
        </div>
      <% end %>
    </td>
  <% end %>

  <%#
    No file to open. What the column can say is whether the sheet came in on
    paper, and the tutor says it here; the answer replaces this row alone.
  %>

  <td class="text-center sticky-col hand-in-col" data-mode="<%= @mode %>">
    <% if can_enter_points? && !elsewhere? && !@participation.exempt? && !@participation.absent? %>
      <% if paper_hand_in? && !paper_hand_in_removable? %>
        <button
          class="
            btn btn-sm btn-outline-secondary d-inline-flex
            align-items-center justify-content-center px-2 py-1 lh-1
          "
          disabled
          title="<%= t("assessment.grading_tutorial.paper_hand_in_kept") %>"
          aria-label="<%= t("assessment.grading_tutorial.paper_hand_in_kept") %>"
        >
          <i class="bi bi-file-earmark-check-fill"></i>
        </button>
      <% elsif paper_hand_in? %>
        <%= link_to paper_hand_in_removal_url,
                    class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2 py-1 lh-1",
                    data: { turbo_method: :patch, bs_toggle: "tooltip" },
                    title: t("assessment.grading_tutorial.paper_hand_in_remove"),
                    aria: { label: t("assessment.grading_tutorial.paper_hand_in_remove") } do %>
          <i class="bi bi-file-earmark-check-fill"></i>
        <% end %>
      <% else %>
        <div class="d-inline-flex align-items-center gap-2">
          <input
            type="checkbox"
            class="form-check-input m-0"
            form="paper-hand-ins"
            name="user_ids[]"
            value="<%= @user.id %>"
            aria-label="<%= t("assessment.grading_tutorial.paper_hand_in_select", name: @user.tutorial_name) %>"
            data-paper-selection-target="checkbox"
            data-action="paper-selection#sync"
          >

          <%= link_to paper_hand_in_url,
                      class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center px-2 py-1 lh-1",
                      data: { turbo_method: :patch, bs_toggle: "tooltip" },
                      title: t("assessment.grading_tutorial.paper_hand_in"),
                      aria: { label: t("assessment.grading_tutorial.paper_hand_in") } do %>
            <i class="bi bi-file-earmark"></i>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </td>

  <% if show_correction_col? %>
    <td class="sticky-col correction-col"></td>
  <% end %>
</tr>
