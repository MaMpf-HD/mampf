<tr
  id="<%= row_id %>"
  is="turbo-frame"
  data-id="<%= @participation.id %>"
  data-controller="participation-row"
  data-row-id="<%= @participation.id %>"
  data-row-target-type="participation"
  data-action="dirty->pointing-table#rowDirty clean->pointing-table#rowClean"
  data-status-filter-status="<%= @participation.status %>"
  data-status-filter-tutorial="<%= @participation.tutorial&.id %>"
  data-status-filter-name="<%= @user.tutorial_name %>"
>
  <!-- Column 1: User names + copy emails + late icon -->
  <td class="sticky-col team-col">
    <div class="d-flex justify-content-between">
      <%= @user.tutorial_name %>

      <% movement = movement_info_for_user(@user) %>

      <% if movement %>
        <i
          class="bi bi-info-circle me-2 ps-1"
          title="<%= movement %>"
          data-bs-toggle="tooltip"
        ></i>
      <% end %>

      <i
        class="
          clipboardpopup bi bi-clipboard clickable
          text-secondary clipboard-btn ms-3 clipboard-button
        "
        style="width: fit-content;"
        data-clipboard-text="<%= @user.email %>"
        data-bs-toggle="tooltip"
        title="<%= t('buttons.copy_email_to_clipboard') %>"
      >
        <span class="clipboardpopuptext token-clipboard-popup">
          <%= t('basics.emails_copied_to_clipboard') %>
        </span>
      </i>
    </div>
  </td>

  <!-- Column 1.5: Tutorial -->
  <% if @mode == "teacher" %>
    <td class="text-center sticky-col tutorial-col">
      <span><%= @participation.tutorial&.title %></span>
    </td>
  <% end %>

  <% if grading_enabled? %>
    <!-- Column 2: Status -->
    <td class="text-center sticky-col status-col" data-mode="<%= @mode %>">
      <span
        class="<%= badge_status_participation_class(@participation.status) %>"
        style="font-size: 11px; font-weight: 500; letter-spacing: 0.02em; padding: 4px 10px;"
      >
        <%= @participation.status %>
      </span>
    </td>
    <!-- batch of columns 3: grade zone -->
    <!-- support point by task -->
    <% tasks.each do |task| %>
      <%= task_points_participation_cell(task, allow_grading?) %>
    <% end %>
    <!-- Column 4: Total Points -->
    <td class="text-center sticky-col total-col" data-mode="<%= @mode %>">
      <span data-participation-row-target="totalPoints">0</span>
    </td>
  <% end %>

  <!-- Column 5: Actions buttons -->
  <td class="text-end sticky-col action-col" data-mode="<%= @mode %>">
    <div class="d-inline-flex align-items-center flex-wrap justify-content-end gap-1">
      <!-- Save and refresh -->
      <% if can_grade? && grading_enabled? && @participation %>
        <!-- Hidden form for this row to submit -->
        <%= form_with url: @save_url,
                    method: :patch,
                    data: { turbo: true, participation_row_target: "form" },
                    html: { style: "display:none;" } do %>
          <input
            type="hidden"
            name="task_points"
            data-participation-row-target="payload"
          >
        <% end %>
        <!-- Save row -->
        <%= save_row_button(allow_grading?) %>
        <!-- Refresh row -->
        <%= form_with url: @refresh_url,
                    method: :patch,
                    data: { turbo: true, participation_row_target: "refreshForm" },
                    html: { style: "display:none;" } do %>
          <input
            type="hidden"
            name="task_points"
            data-participation-row-target="payload"
          >
        <% end %>
        <!-- refresh row -->
        <%= refresh_row_button(allow_grading?) %>
      <% end %>
    </div>
  </td>

  <!-- empty correction column -->
  <% if @mode == "tutor" %>
    <td class="sticky-col correction-col"></td>
  <% end %>
</tr>
