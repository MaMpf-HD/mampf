<%# Saves every row the pointing-table controller collected as dirty, in one request. %>
<button
  type="button"
  class="btn btn-success btn-sm"
  disabled
  data-pointing-table-target="bulkSave"
  data-action="click->pointing-table#submitAll"
>
  <i class="bi bi-floppy-fill me-1"></i>
  <%= t("assessment.grading_tutorial.save_all") %>

  <span
    class="badge text-bg-light ms-1"
    hidden
    data-pointing-table-target="dirtyCount"
  ></span>
</button>

<%= form_with url: url,
              method: :patch,
              local: true,
              data: { turbo: true, pointing_table_target: "form" },
              html: { hidden: true } do %>
  <input
    type="hidden"
    name="<%= payload_name %>"
    data-pointing-table-target="payload"
  >

  <% hidden_fields.each do |name, value| %>
    <input type="hidden" name="<%= name %>" value="<%= value %>">
  <% end %>
<% end %>
