<%= vite_stylesheet_tag "deans_office/index.scss" %>

<div class="container py-3" data-controller="deans-office">
  <h1 class="h3"><%= t("deans_office.title") %></h1>

  <p class="text-muted"><%= t("deans_office.explainer") %></p>

  <div class="d-flex flex-wrap align-items-end gap-3 mb-4">
    <%= form_with url: deans_office_path, method: :get, local: true,
                  data: { controller: "submit-on-change" } do |f| %>
      <%= hidden_field_tag :order, "phase" if @by_phase %>
      <%= f.label :term, t("deans_office.term"), class: "form-label small mb-1" %>

      <%= f.select :term,
                   options_for_select(@term_options, @term&.dashboard_param),
                   {},
                   class: "form-select w-auto",
                   data: { action: "change->submit-on-change#change" } %>
    <% end %>

    <% if @overview.lectures.any? %>
      <div class="flex-grow-1">
        <%= label_tag "deans-office-filter", t("deans_office.filter"),
                      class: "form-label small mb-1" %>

        <%= search_field_tag "deans-office-filter", nil,
                             class: "form-control",
                             placeholder: t("deans_office.filter_placeholder"),
                             autocomplete: "off",
                             data: { deans_office_target: "filter",
                                     action: "input->deans-office#filter" } %>
      </div>
      <nav aria-label="<%= t("deans_office.order.label") %>">
        <div class="small text-muted mb-1" aria-hidden="true">
          <%= t("deans_office.order.label") %>
        </div>

        <div class="btn-group btn-group-sm">
          <% [nil, "phase"].each do |order| %>
            <% current = (order == "phase") == @by_phase %>

            <%= link_to t("deans_office.order.#{order || "title"}"),
                        deans_office_path(term: @term&.dashboard_param, order: order),
                        class: class_names("btn", current ? "btn-secondary" : "btn-outline-secondary"),
                        "aria-current": (current ? "true" : nil) %>
          <% end %>
        </div>
      </nav>
    <% end %>
  </div>

  <% if @overview.lectures.empty? %>
    <p><%= t("deans_office.no_lectures") %></p>
  <% else %>
    <% @overview.sections.each do |section, courses| %>
      <%= render DeansOfficeTableComponent.new(overview: @overview, section: section,
                                               courses: courses, by_phase: @by_phase) %>
    <% end %>
    <p
      class="text-muted"
      role="status"
      hidden
      data-deans-office-target="none"
    >
      <%= t("deans_office.no_match") %>
    </p>
  <% end %>
</div>
